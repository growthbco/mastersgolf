---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import CallBar from '../components/CallBar.astro';
import '../styles/global.css';
import '../styles/design.css';
import companyData from '../data/company.json';

interface Props {
	title: string;
	description?: string;
	hideHeader?: boolean;
	canonical?: string;
	ogImage?: string;
	breadcrumbs?: Array<{ name: string; url: string }>;
	quoteHref?: string;
}

const { title, description = "Masters Golf Cars offers golf carts for sale and rent in Belleview, FL near the Villages and Ocala.", hideHeader = false, canonical, ogImage, breadcrumbs, quoteHref = '#quote' } = Astro.props;

// LocalBusiness Schema (site-wide) - carries local dealer signals on every page
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://mastersgolfcars.com/#localbusiness",
	"name": "Masters Golf Cars, LLC",
	"alternateName": "Masters Golf Cars",
	"url": "https://mastersgolfcars.com",
	"logo": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"image": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"description": companyData.description,
	"foundingDate": "1999",
	"priceRange": "$$",
	"telephone": "+1-352-307-0111",
	"email": "sales@mastersgolfcars.com",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420",
		"addressCountry": "US"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 29.034576,
		"longitude": -82.025011
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			"opens": "08:30",
			"closes": "17:00"
		},
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": "Saturday",
			"opens": "09:00",
			"closes": "14:00"
		}
	],
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": "+1-352-307-0111",
		"contactType": "sales",
		"email": "sales@mastersgolfcars.com",
		"availableLanguage": "English"
	},
	"sameAs": [
		"https://www.facebook.com/mastersgolfcars",
		"https://www.instagram.com/mastersgolfcars/"
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Services",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Rentals"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Sales"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Repairs"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Customization"
				}
			}
		]
	},
	"areaServed": [
		{
			"@type": "County",
			"name": "Marion County, FL"
		},
		{
			"@type": "County",
			"name": "Sumter County, FL"
		},
		{
			"@type": "County",
			"name": "Lake County, FL"
		},
		{
			"@type": "County",
			"name": "Alachua County, FL"
		}
	]
};

// BreadcrumbList Schema (if breadcrumbs are provided)
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs.map((crumb, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": crumb.name,
		"item": crumb.url
	}))
} : null;

const siteUrl = 'https://mastersgolfcars.com';
const currentUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const defaultOgImage = companyData.logo.startsWith('http') ? companyData.logo : `${siteUrl}${companyData.logo}`;
const ogImageUrl = ogImage ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`) : defaultOgImage;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="google-site-verification" content="wdMl3wVlXoJKzGvAVZjAJ4mAYgoG7XoMZ1MUmWNsVLw" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={currentUrl} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content={companyData.name} />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={currentUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Geo Meta Tags -->
		<meta name="geo.region" content="US-FL" />
		<meta name="geo.placename" content="Belleview, Florida" />
		<meta name="geo.position" content="29.034576;-82.025011" />
		<meta name="ICBM" content="29.034576, -82.025011" />

		<title>{title}</title>

		<!-- JSON-LD Schema Markup -->
		<Schema schema={organizationSchema} />
		{breadcrumbSchema && <Schema schema={breadcrumbSchema} />}
		<slot name="schema" />
		<script
			src="https://beta.leadconnectorhq.com/loader.js"
			data-resources-url="https://beta.leadconnectorhq.com/chat-widget/loader.js"
			data-widget-id="695a85adb1df7983a02e82da">
		</script>
	</head>
	<body class="ds min-h-screen">
		{!hideHeader && <Header quoteHref={quoteHref} />}
		<main>
			<slot />
		</main>
		<Footer />
		
		<CallBar quoteHref={quoteHref} />
		<style is:global>
			[data-widget-id] { z-index: 49 !important; }
			@media (max-width: 760px) { .lc_text-widget, [data-widget-id] { bottom: 84px !important; } }
		</style>
	</body>
</html>

