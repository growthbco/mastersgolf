---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import CallBar from '../components/CallBar.astro';
import '../styles/global.css';
import '../styles/design.css';
import companyData from '../data/company.json';

interface Props {
	title: string;
	description?: string;
	hideHeader?: boolean;
	canonical?: string;
	ogImage?: string;
	breadcrumbs?: Array<{ name: string; url: string }>;
	quoteHref?: string;
}

const { title, description = "Masters Golf Cars offers golf carts for sale and rent in Belleview, FL near the Villages and Ocala.", hideHeader = false, canonical, ogImage, breadcrumbs, quoteHref = '#quote' } = Astro.props;

// LocalBusiness Schema (site-wide) - carries local dealer signals on every page
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://mastersgolfcars.com/#localbusiness",
	"name": "Masters Golf Cars, LLC",
	"alternateName": "Masters Golf Cars",
	"url": "https://mastersgolfcars.com",
	"logo": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"image": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"description": companyData.description,
	"foundingDate": "1999",
	"priceRange": "$$",
	"telephone": "+1-352-307-0111",
	"email": "sales@mastersgolfcars.com",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420",
		"addressCountry": "US"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 29.034576,
		"longitude": -82.025011
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			"opens": "08:30",
			"closes": "17:00"
		},
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": "Saturday",
			"opens": "09:00",
			"closes": "14:00"
		}
	],
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": "+1-352-307-0111",
		"contactType": "sales",
		"email": "sales@mastersgolfcars.com",
		"availableLanguage": "English"
	},
	"sameAs": [
		"https://www.facebook.com/mastersgolfcars",
		"https://www.instagram.com/mastersgolfcars/"
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Services",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Rentals"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Sales"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Repairs"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Customization"
				}
			}
		]
	},
	"areaServed": [
		{
			"@type": "County",
			"name": "Marion County, FL"
		},
		{
			"@type": "County",
			"name": "Sumter County, FL"
		},
		{
			"@type": "County",
			"name": "Lake County, FL"
		},
		{
			"@type": "County",
			"name": "Alachua County, FL"
		}
	]
};

// BreadcrumbList Schema (if breadcrumbs are provided)
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs.map((crumb, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": crumb.name,
		"item": crumb.url
	}))
} : null;

const siteUrl = 'https://mastersgolfcars.com';
// Canonicals must be the FINAL url. Netlify serves trailing-slash URLs
// and 301s the bare form — 14 pages canonicalized to a redirect.
const canonicalPath = Astro.url.pathname.endsWith('/') || /\.[a-z]+$/.test(Astro.url.pathname)
	? Astro.url.pathname
	: Astro.url.pathname + '/';
// 23 pages pass hardcoded canonicals without the slash — normalize those too.
const rawCanonical = canonical || new URL(canonicalPath, siteUrl).toString();
const currentUrl = /\.[a-z]+$/.test(rawCanonical) || rawCanonical.endsWith('/')
	? rawCanonical
	: rawCanonical + '/';
const defaultOgImage = companyData.logo.startsWith('http') ? companyData.logo : `${siteUrl}${companyData.logo}`;
const ogImageUrl = ogImage ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`) : defaultOgImage;
---

<!doctype html>
<html lang="en">
	<head>
    <meta charset="UTF-8" />
    <!-- Google Analytics: website traffic and contact intent -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B3RLS7RLLK"></script>
    <script is:inline>
      window['ga-disable-G-B3RLS7RLLK'] = navigator.doNotTrack === '1' || navigator.globalPrivacyControl === true;
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-B3RLS7RLLK', {allow_google_signals: false, allow_ad_personalization_signals: false});
      document.addEventListener('click', function(event) {
        const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!link) return;
        const href = link.getAttribute('href') || '';
        const method = href.startsWith('tel:') ? 'phone' : href.startsWith('mailto:') ? 'email' : href.startsWith('sms:') ? 'sms' : null;
        if (method) gtag('event', 'contact_click', {contact_method: method});
      });
    </script>
    <meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="google-site-verification" content="wdMl3wVlXoJKzGvAVZjAJ4mAYgoG7XoMZ1MUmWNsVLw" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={currentUrl} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content={companyData.name} />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={currentUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Geo Meta Tags -->
		<meta name="geo.region" content="US-FL" />
		<meta name="geo.placename" content="Belleview, Florida" />
		<meta name="geo.position" content="29.034576;-82.025011" />
		<meta name="ICBM" content="29.034576, -82.025011" />

		<title>{title}</title>

		<!-- JSON-LD Schema Markup -->
		<Schema schema={organizationSchema} />
		{breadcrumbSchema && <Schema schema={breadcrumbSchema} />}
		<slot name="schema" />
	</head>
	<body class="ds min-h-screen">
		{!hideHeader && <Header quoteHref={quoteHref} />}
		<main>
			<slot />
		</main>
		<Footer />
		
		<CallBar quoteHref={quoteHref} />
	</body>
</html>

