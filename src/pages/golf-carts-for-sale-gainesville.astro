---
import Layout from '../layouts/Layout.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';
import servicesData from '../data/services.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Gainesville Golf Carts for Sale",
	"description": "New and used golf carts for sale in Gainesville, FL. Serving Haile Plantation, Tioga, Archer, University of Florida area, and all of Alachua County.",
	"url": "https://mastersgolfcars.com/golf-carts-for-sale-gainesville",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Haile Plantation",
		"Tioga",
		"Archer",
		"University of Florida",
		"Newberry",
		"Downtown Gainesville",
		"Alachua County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
---

<Layout 
	title="Golf Carts for Sale in Gainesville, FL | Masters Golf Cars - New & Used" 
	description="Buy golf carts in Gainesville, FL. New & used golf carts for sale. Serving Haile Plantation, Tioga, UF area. Financing available. 26+ years experience. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-carts-for-sale-gainesville"
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Golf Carts for Sale in Gainesville, FL</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Since 1999, Masters Golf Cars has been serving Gainesville and Alachua County with quality new and used golf carts. We serve residents throughout Gainesville, including communities like <strong>Haile Plantation</strong>, <strong>Tioga</strong>, <strong>Archer</strong>, and the <strong>University of Florida</strong> area.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						Our convenient location at <strong>12885 S US Highway 441 in Belleview</strong> (just 20 miles south of Gainesville) makes us easily accessible from <strong>I-75</strong>, <strong>Archer Road</strong>, and <strong>Newberry Road</strong>. With over 26 years of experience serving Gainesville, we're your trusted source for Club Car, Yamaha, and EZ-GO golf carts.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/golf-cart-inventory" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							View Inventory
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/golf-cart-rentals-page/club-car_img_v68_250813_154125925.webp" alt="Golf carts for sale in Gainesville Florida" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Why Buy From Us -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why Gainesville Chooses Masters Golf Cars</h2>
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-6">
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">26+ Years Serving Gainesville</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Since 1999, we've been Gainesville's trusted golf cart dealership. We've sold thousands of golf carts to residents in communities like <strong>Haile Plantation</strong>, <strong>Tioga</strong>, <strong>Archer</strong>, and throughout Alachua County. Our deep roots in the Gainesville community mean we understand your needs and can help you find the perfect cart for your lifestyle.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Authorized Dealer for Top Brands</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							We're an authorized dealer for <strong>Club Car</strong>, <strong>Yamaha</strong>, and <strong>EZ-GO</strong> - the brands most trusted by Gainesville residents. Whether you need a cart for navigating <strong>Haile Plantation</strong>, accessing the <strong>University of Florida campus</strong>, or exploring your neighborhood in <strong>Tioga</strong>, we have the perfect solution.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Expert Knowledge of Gainesville Communities</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Our team knows Gainesville's communities inside and out. We understand the terrain, the golf cart paths, and the specific needs of each neighborhood. Whether you're looking for a cart to explore <strong>Paynes Prairie Preserve State Park</strong>, attend events at <strong>Ben Hill Griffin Stadium</strong>, or simply get around your community, we can recommend the perfect cart.
						</p>
					</div>
				</div>
				<div>
					<div class="bg-white rounded-lg p-8 shadow-lg mb-6">
						<h3 class="text-xl font-bold text-gray-900 mb-4">Gainesville Communities We Serve</h3>
						<ul class="space-y-2 text-gray-700 font-semibold mb-6">
							<li>✓ Haile Plantation</li>
							<li>✓ Tioga</li>
							<li>✓ Archer</li>
							<li>✓ University of Florida Area</li>
							<li>✓ Newberry</li>
							<li>✓ Downtown Gainesville</li>
							<li>✓ All of Alachua County</li>
						</ul>
					</div>
					<div class="bg-brand-green text-white rounded-lg p-8">
						<h3 class="text-xl font-bold mb-4">Easy Financing Available</h3>
						<p class="mb-4 font-semibold">
							We offer flexible financing options through Sheffield Financial and other lenders. Stop by our location at <strong>12885 S US Highway 441</strong> to discuss financing options that work for you.
						</p>
						<a href="https://prequalify.sheffieldfinancial.com/Apply/Landing?source=web&dealer=57070" target="_blank" rel="noopener noreferrer" class="inline-block bg-black text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-900 transition">
							Apply for Financing
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Brands We Carry -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Golf Cart Brands We Carry in Gainesville</h2>
			<p class="text-lg text-gray-700 text-center mb-10 font-semibold max-w-3xl mx-auto">
				We're an authorized dealer for the top golf cart brands trusted by Gainesville residents. Each brand offers unique features perfect for different needs and communities.
			</p>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'Club Car')?.icon || '/images/logos/club-car-icon-0-0.webp'} alt="Club Car golf carts Gainesville" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">Club Car</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Premium golf carts known for durability and performance. Popular choice in <strong>Haile Plantation</strong> and <strong>Tioga</strong>.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'Yamaha')?.icon || '/images/logos/yamaha-icon-0-1.webp'} alt="Yamaha golf carts Gainesville" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">Yamaha</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Reliable and efficient golf carts with excellent battery life. Great for daily use in <strong>Haile Plantation</strong> and <strong>Tioga</strong>.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'EZ-GO')?.icon || '/images/logos/ez-go-icon-0-2.webp'} alt="EZ-GO golf carts Gainesville" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">EZ-GO</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Affordable and versatile golf carts perfect for families. Popular in <strong>Archer</strong> and <strong>Newberry</strong>.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- New vs Used -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">New & Used Golf Carts in Gainesville</h2>
			<div class="grid md:grid-cols-2 gap-12">
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">New Golf Carts</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Browse our selection of brand new golf carts from Club Car, Yamaha, and EZ-GO. New carts come with full manufacturer warranties and the latest features perfect for Gainesville's communities.
					</p>
					<ul class="space-y-3 text-gray-700 font-semibold mb-6">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Full manufacturer warranty</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Latest features and technology</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Customization options available</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Financing available</span>
						</li>
					</ul>
					<a href="/golf-cart-inventory?condition=new" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
						View New Inventory
					</a>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">Used Golf Carts</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Find quality pre-owned golf carts at great prices. We carefully inspect all used carts and offer trade-ins from Gainesville residents, ensuring you get a reliable cart that's perfect for your needs.
					</p>
					<ul class="space-y-3 text-gray-700 font-semibold mb-6">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Thoroughly inspected and serviced</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Great value for your budget</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Trade-ins accepted</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Financing available on used carts</span>
						</li>
					</ul>
					<a href="/golf-cart-inventory?condition=used" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
						View Used Inventory
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Related Services Section - Internal Linking -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Services in Gainesville</h2>
				<div class="grid md:grid-cols-2 gap-6">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Rentals in Gainesville</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Need a golf cart for a short-term need? We offer convenient rentals throughout Gainesville and Alachua County.
						</p>
						<a href="/golf-cart-rentals-gainesville" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn More About Gainesville Rentals
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Repairs in Gainesville</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Keep your golf cart running smoothly with our expert repair services. Fast, reliable service throughout Gainesville.
						</p>
						<a href="/golf-cart-repairs-gainesville" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn More About Gainesville Repairs
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Other Locations Section - Internal Linking -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Golf Carts for Sale in Other Areas</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Ocala Sales</h3>
						<p class="text-gray-700 font-semibold mb-4">
							New and used golf carts for sale in Ocala, FL. Serving Ocala Palms, Golden Ocala, and more.
						</p>
						<a href="/golf-carts-for-sale-ocala" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">The Villages Sales</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf carts for sale in The Villages, FL. Perfect for exploring The Villages communities.
						</p>
						<a href="/golf-carts-for-sale-the-villages" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Belleview Sales</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf carts for sale in Belleview, FL. Our home location with convenient service.
						</p>
						<a href="/golf-cart-inventory" class="text-brand-green font-bold hover:underline">View Inventory</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<CartInquiryForm pageSource="Gainesville Sales" idPrefix="sales-gainesville" />

	<!-- CTA Section -->
	<section class="py-16 bg-gray-900 text-white">
		<div class="container mx-auto px-4 max-w-6xl text-center">
			<h2 class="text-3xl md:text-4xl font-black mb-6">Ready to Buy a Golf Cart in Gainesville?</h2>
			<p class="text-xl mb-8 font-semibold text-gray-300">
				Visit Masters Golf Cars today to see our selection of new and used golf carts. We're conveniently located at <strong>12885 S US Highway 441 in Belleview</strong>, just 20 miles south of Gainesville.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
				<a href="/golf-cart-inventory" class="bg-brand-green text-white font-bold py-4 px-8 rounded-lg hover:opacity-90 transition">
					View Inventory
				</a>
				<a href="tel:3523070111" class="bg-white text-gray-900 font-bold py-4 px-8 rounded-lg hover:bg-gray-100 transition">
					Call (352) 307-0111
				</a>
			</div>
			<p class="text-gray-400 font-semibold">
				{companyData.location.full} | Serving Gainesville Since 1999
			</p>
		</div>
	</section>

	<Schema schema={localBusinessSchema} />
</Layout>
