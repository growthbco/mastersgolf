---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import HeroSplit from '../components/sections/HeroSplit.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import InventoryGrid from '../components/sections/InventoryGrid.astro';
import LocalContent from '../components/sections/LocalContent.astro';
import Reviews from '../components/sections/Reviews.astro';
import Faq from '../components/sections/Faq.astro';
import FormShell from '../components/forms/FormShell.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Check from '../components/ui/Check.astro';
import local from '../data/locations/golf-carts-for-sale-gainesville.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - Gainesville Golf Carts for Sale",
	"description": "New and used golf carts for sale in Gainesville, FL. Serving Haile Plantation, Tioga, Archer, University of Florida area, and all of Alachua County.",
	"url": "https://mastersgolfcars.com/golf-carts-for-sale-gainesville",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Haile Plantation",
		"Tioga",
		"Archer",
		"University of Florida",
		"Newberry",
		"Downtown Gainesville",
		"Alachua County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "Do you deliver carts to Gainesville?",
  "answer": "Yes. New and pre-owned carts are delivered to Gainesville from our shop in Belleview."
 },
 {
  "question": "Do you offer financing?",
  "answer": "Yes, through Sheffield Financial. Apply online in minutes."
 },
 {
  "question": "Do you take trade-ins?",
  "answer": "Yes. Trade toward any cart in stock, or sell your cart to us outright."
 },
 {
  "question": "What comes with a new cart?",
  "answer": "A free first year of 24hr Cart Club roadside assistance, and service from the shop that sold it."
 }
];

const LEAD = ["Since 1999, Masters Golf Cars has been serving Gainesville and Alachua County with quality new and used golf carts. We serve residents throughout Gainesville, including communities like Haile Plantation, Tioga, Archer, and the University of Florida area.", "Our convenient location at 12885 S US Highway 441 in Belleview (just 20 miles south of Gainesville) makes us easily accessible from I-75, Archer Road, and Newberry Road. With over 26 years of experience serving Gainesville, we're your trusted source for Club Car, Yamaha, and EZ-GO golf carts."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Inventory", url: "https://mastersgolfcars.com/golf-cart-inventory" },
	{ name: "Gainesville", url: "https://mastersgolfcars.com/golf-carts-for-sale-gainesville" }
];
---

<Layout title="Golf Carts for Sale in Gainesville, FL | Masters Golf Cars - New & Used" description="Buy golf carts in Gainesville, FL. New & used golf carts for sale. Serving Haile Plantation, Tioga, UF area. Financing available. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-carts-for-sale-gainesville" breadcrumbs={crumbs} quoteHref="#askcart">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />

	<HeroSplit eyebrow="Golf carts for sale in Gainesville" heading="Your next cart," accent="delivered to Gainesville." lead={LEAD[0]} cta="Browse inventory" ctaHref="#inventory" checks={['New and pre-owned', 'Financing through Sheffield Financial', 'Trade-ins welcome', 'Delivered to Gainesville']} img={R + 'clubcar-row.jpg'} alt="Row of golf carts for sale at Masters Golf Cars" label="Delivery to Alachua County" pos="50% 60%" />
	<ProofBar items={[['tag', 'New and pre-owned', 'Club Car, Yamaha, E-Z-GO, Advanced EV'], ['dollar', 'Financing', 'Apply online with Sheffield Financial'], ['truck', 'Delivered to Gainesville', 'Set up and ready to drive'], ['star', '4.9 on Google', 'From 93 customer reviews']]} />
	{LEAD.length > 1 && <section class="sec white" style="padding-bottom:0"><div class="stack" style="gap:16px;max-width:820px">{LEAD.slice(1).map((p) => <p class="body" style="font-size:17px;line-height:28px">{p}</p>)}</div></section>}
	<InventoryGrid bg="white" />
	<LocalContent sections={local.sections} eyebrow="Buying a cart in Gainesville" />

	<section class="sec dark on-dark fin">
		<div class="head"><Eyebrow>Financing</Eyebrow><h2 class="h2">Easy financing on <span class="g">new and used carts.</span></h2><p class="lead" style="max-width:460px">Apply online in a few minutes through Sheffield Financial. Approved buyers can drive away the same day.</p></div>
		<div class="stack" style="gap:28px">
			<div class="check-list" style="gap:14px 24px">{['Apply online, from home', 'New and pre-owned carts', 'Trade-ins accepted toward your purchase', 'Free first year of 24hr Cart Club with every new cart'].map((t) => <Check>{t}</Check>)}</div>
			<div class="row btn-row" style="gap:16px"><Btn href="https://www.sheffieldfinancial.com/" kind="solid">Apply for financing</Btn><Btn href="/sell-your-cart" kind="ghost-d">Sell or trade your cart</Btn></div>
		</div>
	</section>

	<Reviews heading="What Gainesville buyers say." />
	<Faq items={pageFAQs} heading="Gainesville questions." />

	<FormShell id="askcart" eyebrow="Ask about a cart" heading="Found one you" accent="like?" lead="Tell us what you are looking for and our sales team will get back to you as soon as possible during business hours.">
		<CartInquiryForm pageSource="golf-carts-for-sale-gainesville" idPrefix="sales" />
	</FormShell>
</Layout>

<style>
	.fin { display: grid; grid-template-columns: 1fr 1.3fr; gap: 80px; align-items: center; }
	@media (max-width: 1100px) { .fin { grid-template-columns: 1fr; gap: 40px; } }
</style>
