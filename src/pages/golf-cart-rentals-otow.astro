---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-otow.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - On Top of The World Golf Cart Rentals",
	"description": "Golf cart rentals for On Top of The World (OTOW) residents in Ocala, FL. Delivery to OTOW communities including Candler Hills, Indigo East, and Stone Creek.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-otow",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"On Top of The World",
		"Candler Hills",
		"Indigo East",
		"Stone Creek",
		"SW Ocala",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	},
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Linda S."
			},
			"datePublished": "2024-09-10",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Rented a cart while our OTOW golf cart was in for service. Delivered right to our home in Candler Hills. Great service and very convenient!"
		}
	]
};

const pageFAQs = [
 {
  "question": "How fast can you deliver to On Top of the World?",
  "answer": "Often the same or next day when carts are available. Book ahead for holidays and busy event weeks."
 },
 {
  "question": "Is there a delivery fee?",
  "answer": "Delivery is quoted with your reservation based on your address. Call (352) 307-0111 for a quick number."
 },
 {
  "question": "Is there a minimum rental?",
  "answer": "Yes, 3 days. After that, rent by the week, the month or the season."
 },
 {
  "question": "How old do I have to be?",
  "answer": "Renters must be 21 or older with a valid driver license."
 },
 {
  "question": "Can I extend?",
  "answer": "Yes. Call us before your end date and we will extend it if the cart is available."
 }
];

const LEAD = ["Masters Golf Cars has been the trusted golf cart rental provider for On Top of The World (OTOW) residents since 1999. Whether your personal cart is in for service, you have guests visiting, or you need an extra cart for community events, we deliver premium rentals directly to your OTOW home.", "Located just minutes away at 12885 S US Highway 441 in Belleview, we serve all OTOW neighborhoods including Candler Hills, Indigo East, Friendship Colony, Avalon, and the original OTOW community. Our carts are perfect for accessing the Recreation Center, The Ranch Fitness Center, Candler Hills Golf Club, and all community amenities."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals for On Top of The World (OTOW)", url: "https://mastersgolfcars.com/golf-cart-rentals-otow" }
];
---

<Layout title="Golf Cart Rentals for On Top of The World (OTOW) | Ocala, FL" description="Golf cart rentals for OTOW residents in Ocala. Delivery to Candler Hills, Indigo East, Stone Creek & all OTOW neighborhoods. Since 1999. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-otow" breadcrumbs={crumbs} quoteHref="#reserve">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="community" name="On Top of the World" slug="golf-cart-rentals-otow" eyebrow="Golf cart rentals for On Top of the World, Ocala" heading="Golf cart rentals," accent="delivered to OTOW." lead={LEAD} img={R + 'cart-4p-deluxe.jpg'} imgLabel="Candler Hills, Indigo East, Stone Creek and every OTOW neighborhood" proof={[["pin", "18 miles away", "About 25 minutes from our shop"], ["truck", "Delivered to your door", "Any OTOW neighborhood"], ["key", "300+ carts", "Availability most weeks"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultLocation="On Top of the World, FL" />
</Layout>
