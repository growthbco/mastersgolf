---
import Layout from '../layouts/Layout.astro';
import RentalInquiryForm from '../components/forms/RentalInquiryForm.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - On Top of The World Golf Cart Rentals",
	"description": "Golf cart rentals for On Top of The World (OTOW) residents in Ocala, FL. Delivery to OTOW communities including Candler Hills, Indigo East, and Stone Creek.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-otow",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"On Top of The World",
		"Candler Hills",
		"Indigo East",
		"Stone Creek",
		"SW Ocala",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
---

<Layout
	title="Golf Cart Rentals for On Top of The World (OTOW) | Ocala, FL"
	description="Golf cart rentals for OTOW residents in Ocala. Delivery to Candler Hills, Indigo East, Stone Creek & all OTOW neighborhoods. Since 1999. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-cart-rentals-otow"
	breadcrumbs={[
		{ name: "Home", url: "https://mastersgolfcars.com" },
		{ name: "Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals" },
		{ name: "OTOW Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals-otow" }
	]}
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Golf Cart Rentals for On Top of The World</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Masters Golf Cars has been the trusted golf cart rental provider for <strong>On Top of The World (OTOW)</strong> residents since 1999. Whether your personal cart is in for service, you have guests visiting, or you need an extra cart for community events, we deliver premium rentals directly to your OTOW home.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						Located just minutes away at <strong>12885 S US Highway 441 in Belleview</strong>, we serve all OTOW neighborhoods including <strong>Candler Hills</strong>, <strong>Indigo East</strong>, <strong>Friendship Colony</strong>, <strong>Avalon</strong>, and the original OTOW community. Our carts are perfect for accessing the <strong>Recreation Center</strong>, <strong>The Ranch Fitness Center</strong>, <strong>Candler Hills Golf Club</strong>, and all community amenities.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/rent-a-golf-cart" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							Request a Rental
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/golf-cart-rentals-page/club-car_img_v68_250813_154125925.webp" alt="Golf cart rental in On Top of The World OTOW" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Why Rent in OTOW -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why OTOW Residents Rent From Us</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Cart in for Repairs?</h3>
					<p class="text-gray-700 font-semibold">
						Don't be stuck at home while your golf cart is being serviced. Rent a cart and maintain your OTOW lifestyle. Visit the <strong>Recreation Center</strong>, play at <strong>Candler Hills</strong>, or meet friends at <strong>The Club at Candler Hills</strong> without interruption.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Guests Visiting?</h3>
					<p class="text-gray-700 font-semibold">
						Show your visitors everything OTOW has to offer with an extra golf cart. Take them to <strong>Circle Square Commons</strong> for entertainment, explore the trails, or cruise to <strong>The Ranch</strong> for fitness activities.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Trying Before Buying?</h3>
					<p class="text-gray-700 font-semibold">
						New to OTOW and considering a golf cart purchase? Rent first to understand what features matter to you. Test different cart sizes and decide what works best for your lifestyle.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Community Events</h3>
					<p class="text-gray-700 font-semibold">
						Need extra carts for club activities, block parties, or special community events? We provide multi-cart rentals for OTOW clubs and resident organizations.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Seasonal Residents</h3>
					<p class="text-gray-700 font-semibold">
						Snowbirds returning for the season? Rent a cart while your stored cart is being serviced, or enjoy Florida without the commitment of cart ownership.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Convenient Delivery</h3>
					<p class="text-gray-700 font-semibold">
						We deliver directly to your OTOW home and pick up when your rental ends. No need to leave the community - we come to you.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- OTOW Neighborhoods Served -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">OTOW Neighborhoods We Serve</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
					<h3 class="text-xl font-bold text-gray-900 mb-2">Candler Hills</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Active neighborhood with <strong>Candler Hills Golf Club</strong> and <strong>The Club at Candler Hills</strong>. Our carts are perfect for accessing the golf course, clubhouse dining, and fitness facilities.
					</p>
				</div>
				<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
					<h3 class="text-xl font-bold text-gray-900 mb-2">Indigo East</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Community within OTOW with its own recreation center and amenities. Golf carts make it easy to access <strong>Indigo East Community Center</strong> and connect to the larger OTOW community.
					</p>
				</div>
				<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
					<h3 class="text-xl font-bold text-gray-900 mb-2">Original OTOW</h3>
					<p class="text-gray-700 font-semibold text-sm">
						The heart of the community with the <strong>Recreation Center</strong>, pools, and extensive social activities. Golf carts are essential for daily life here.
					</p>
				</div>
				<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
					<h3 class="text-xl font-bold text-gray-900 mb-2">Friendship Colony</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Active community with easy access to OTOW amenities. Rent a cart to explore the trails and reach community facilities.
					</p>
				</div>
				<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
					<h3 class="text-xl font-bold text-gray-900 mb-2">Avalon</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Newer OTOW neighborhood with modern homes. Golf cart access to <strong>Circle Square Commons</strong> and community events.
					</p>
				</div>
				<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
					<h3 class="text-xl font-bold text-gray-900 mb-2">Stone Creek (Adjacent)</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Neighboring community with its own <strong>Stone Creek Golf Club</strong>. We serve Stone Creek residents with convenient golf cart rentals.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- OTOW Destinations -->
	<section class="py-16 bg-brand-green text-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">Popular OTOW Destinations</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div>
					<h3 class="text-xl font-bold mb-3">Recreation Center</h3>
					<p class="text-gray-100 font-semibold mb-2">SW 99th Street Road</p>
					<p class="text-gray-200 text-sm">
						The hub of OTOW social life with pools, fitness center, arts & crafts rooms, and endless activities. A golf cart is essential for regular visits.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Circle Square Commons</h3>
					<p class="text-gray-100 font-semibold mb-2">SW 80th Street</p>
					<p class="text-gray-200 text-sm">
						Entertainment venue with live music, restaurants, and shopping. Home to <strong>The Town Square</strong> with nightly entertainment during season.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Candler Hills Golf Club</h3>
					<p class="text-gray-100 font-semibold mb-2">Candler Hills neighborhood</p>
					<p class="text-gray-200 text-sm">
						Championship golf course open to OTOW residents. Our carts get you to your tee time in comfort.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">The Ranch Fitness Center</h3>
					<p class="text-gray-100 font-semibold mb-2">SW 84th Street</p>
					<p class="text-gray-200 text-sm">
						Premier fitness facility with pools, gym, spa services, and wellness programs. Easy golf cart access from any OTOW neighborhood.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Sholom Park</h3>
					<p class="text-gray-100 font-semibold mb-2">Adjacent to OTOW</p>
					<p class="text-gray-200 text-sm">
						Beautiful 44-acre botanical park with walking trails, gardens, and peaceful spaces. A popular golf cart destination for OTOW residents.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">The Club at Candler Hills</h3>
					<p class="text-gray-100 font-semibold mb-2">Candler Hills neighborhood</p>
					<p class="text-gray-200 text-sm">
						Fine dining, casual restaurant, and event venue. Perfect for dinner outings via golf cart.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Rental Options -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">Golf Cart Options for OTOW</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" alt="2-passenger golf cart for OTOW" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">2-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Perfect for couples exploring OTOW. Ideal for golf, errands, and daily community activities.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/4-seater-golf-cart_img_v64_250813_142836603.webp" alt="4-passenger golf cart for OTOW" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">4-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Great when guests visit or for social outings with friends. Room for everyone plus shopping bags.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" alt="6-passenger golf cart for OTOW" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">6-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Maximum capacity for family visits, club outings, or neighborhood social activities.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/utility-cart_img_v66_250813_142912878.webp" alt="Utility golf cart for OTOW" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Utility Cart</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Perfect for moving items, large shopping trips, or club activities requiring cargo space.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Choose Us -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why OTOW Residents Trust Masters Golf Cars</h2>
			<div class="grid md:grid-cols-2 gap-12">
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">26+ Years Serving OTOW</h3>
					<ul class="space-y-3 text-gray-700 font-semibold">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Trusted by OTOW residents since 1999</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Located just minutes from OTOW on US 441</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Delivery directly to your OTOW home</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Pickup when your rental ends</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Clean, well-maintained carts</span>
						</li>
					</ul>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">Full Service for OTOW</h3>
					<ul class="space-y-3 text-gray-700 font-semibold">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Rentals while your cart is being repaired</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Golf cart repairs and service</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>New and used carts for sale</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Custom golf cart builds</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Parts and accessories</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- How It Works -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">How to Rent a Golf Cart for OTOW</h2>
			<div class="grid md:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">1</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Request Rental</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Fill out our form with your OTOW address, dates needed, and cart preference.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">2</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Confirm Details</h3>
					<p class="text-gray-700 font-semibold text-sm">
						We'll call to confirm availability and arrange delivery to your OTOW home.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">3</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">We Deliver</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Your clean, charged cart is delivered directly to your driveway in OTOW.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">4</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Enjoy & Return</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Explore OTOW! We pick up when your rental ends at your convenience.
					</p>
				</div>
			</div>
			<div class="mt-12 text-center">
				<a href="/rent-a-golf-cart" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
					Request OTOW Rental
				</a>
			</div>
		</div>
	</section>

	<!-- Testimonial -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="bg-white rounded-3xl shadow-lg p-8 md:p-12 max-w-3xl mx-auto text-center">
				<div class="flex justify-center gap-1 mb-6">
					{Array.from({ length: 5 }).map((_star, index) => (
						<svg class="w-6 h-6" fill="#FFD700" viewBox="0 0 20 20">
							<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
						</svg>
					))}
				</div>
				<p class="text-gray-700 leading-relaxed mb-6 font-semibold text-lg">
					"Rented a cart while our OTOW golf cart was in for service. Masters delivered right to our home in Candler Hills and picked up when we were done. Great service and very convenient - we didn't miss a day at the Recreation Center!"
				</p>
				<p class="font-black text-gray-900">-Linda S., Candler Hills Resident</p>
			</div>
		</div>
	</section>

	<!-- Related Services -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Services for OTOW</h2>
				<div class="grid md:grid-cols-2 gap-6">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Repairs</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Expert repairs for your personal golf cart. We service all makes and models.
						</p>
						<a href="/golf-cart-repairs" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn More
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Carts for Sale</h3>
						<p class="text-gray-700 font-semibold mb-4">
							New and used golf carts perfect for OTOW living. Browse our inventory.
						</p>
						<a href="/golf-carts-for-sale" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							View Inventory
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Other Locations -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
