---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import HeroSplit from '../components/sections/HeroSplit.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import Steps from '../components/sections/Steps.astro';
import Reviews from '../components/sections/Reviews.astro';
import FormShell from '../components/forms/FormShell.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Ring from '../components/ui/Ring.astro';
import { R } from '../lib/areas';

const opts: [string, string, string][] = [['sliders', 'Lift kits', '2 to 6 inch lifts, A-arm and spindle, matched to bigger tires.'], ['gauge', 'Wheels and tires', '10 to 14 inch alloys, street, all terrain and mud tires.'], ['star', 'Seats and upholstery', 'Custom colors, stitching, flip seats and rear kits.'], ['zap', 'Lighting', 'LED headlights, taillights, turn signals and underglow.'], ['volume', 'Audio', 'Bluetooth sound bars, speakers and subwoofers.'], ['shield', 'Enclosures and tops', 'Extended tops, enclosures and windshields.'], ['drop', 'Paint and wraps', 'Body kits, custom paint and full wraps.'], ['key', 'Street legal packages', 'Mirrors, signals, horn and everything needed for LSV use.']];
const builds = ['/images/gallery/02-04-2025-14-25-01_26.webp', '/images/gallery/02-04-2025-14-25-27_27.webp', '/images/gallery/02-04-2025-14-25-48_28.webp', '/images/gallery/02-04-2025-14-04-34_6.webp', '/images/gallery/02-04-2025-14-04-55_7.webp', '/images/gallery/02-04-2025-14-05-18_8.webp'];
const schema = { "@context": "https://schema.org", "@type": "Service", "@id": "https://mastersgolfcars.com/customize/#service", "name": "Golf Cart Customization", "serviceType": "Golf cart customization", "description": "Custom golf cart builds in Belleview, FL: lift kits, wheels, seats, lighting, audio, enclosures, paint and street legal packages.", "provider": { "@id": "https://mastersgolfcars.com/#localbusiness" }, "url": "https://mastersgolfcars.com/customize" };
const crumbs = [{ name: "Home", url: "https://mastersgolfcars.com" }, { name: "Customize", url: "https://mastersgolfcars.com/customize" }];
---

<Layout title="Custom Golf Carts | Lift Kits, Wheels, Seats & Lighting | Masters Golf Cars" description="Customize your golf cart in Belleview, FL. Lift kits, wheels and tires, custom seats, LED lighting, audio, enclosures, paint and street legal packages, installed by Masters Golf Cars." breadcrumbs={crumbs} quoteHref="#customquote">
	<Schema schema={schema} slot="schema" />

	<HeroSplit eyebrow="Customization" heading="Your cart." accent="Your way." lead="From seating and wheels to lighting and finishes, tell us what you want and we will build it in our Belleview shop." cta="Plan my custom cart" ctaHref="#customquote" checks={['Lift kits and wheels', 'Custom seats and upholstery', 'LED lighting and audio', 'Paint, wraps and enclosures']} img={R + 'custom-detail.jpg'} alt="Lifted four passenger golf cart with custom striped seats" label="Built in Belleview" />
	<ProofBar items={[['sliders', 'Built in house', 'Our techs, our shop'], ['shield', 'Quality parts', 'Brands we would put on our own carts'], ['tag', 'Written quote first', 'No surprises'], ['award', 'Since 1999', "Central Florida's cart people"]]} />

	<section class="sec white stack" style="gap:48px">
		<div class="head"><Eyebrow>What we do</Eyebrow><h2 class="h2">Pick one thing or build the whole cart.</h2><p class="lead">Every option below is installed by our own technicians.</p></div>
		<div class="opts">{opts.map(([i, t, s]) => <div class="opt"><Ring name={i} fill /><h3 class="h3" style="font-size:18px;line-height:24px">{t}</h3><p class="body" style="font-size:15px;line-height:24px">{s}</p></div>)}</div>
	</section>

	<section class="sec paper stack" style="gap:48px">
		<div class="head"><Eyebrow>Recent builds</Eyebrow><h2 class="h2 md">Out of the shop.</h2></div>
		<div class="grid3" style="gap:16px">{builds.map((src) => <div class="bph"><img src={src} alt="Custom golf cart built by Masters Golf Cars" loading="lazy" width="440" height="300" /></div>)}</div>
	</section>

	<Steps eyebrow="How it works" heading="Three steps to your cart." lead="Bring us your cart or buy one from us and we will build it before delivery." items={[['1', 'sliders', 'Tell us what you want', 'Bring photos, ideas or a wish list. We help you pick parts that work together.'], ['2', 'tag', 'Get a written quote', 'Parts, labor and time, in writing, before any work starts.'], ['3', 'check', 'We build it', 'Our techs install everything in house and walk you through it at pickup.']]} cta="Plan my custom cart" ctaHref="#customquote" bg="white" />
	<Reviews heading="Work people talk about." bg="paper" />

	<FormShell id="customquote" eyebrow="Plan your build" heading="Tell us what you are" accent="dreaming of." lead="Describe the cart and what you want done and we will get back to you with a quote as soon as possible during business hours.">
		<CartInquiryForm pageSource="customize" idPrefix="custom" cta="Get my quote" placeholder="Cart make, model and year, and what you want done: colors, sizes, brands, anything you have in mind." />
	</FormShell>
</Layout>

<style>
	.opts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
	.opt { display: flex; flex-direction: column; gap: 14px; padding: 28px 26px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
	.bph { height: 300px; overflow: hidden; background: var(--black); }
	.bph img { display: block; width: 100%; height: 100%; object-fit: cover; }
	@media (max-width: 1100px) { .opts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 760px) { .opts { grid-template-columns: 1fr; } .bph { height: 200px; } }
</style>
