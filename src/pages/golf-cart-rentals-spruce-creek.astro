---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-spruce-creek.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Spruce Creek Golf Cart Rentals",
	"description": "Golf cart rentals for Spruce Creek South and Spruce Creek Preserve in Summerfield, FL. Convenient delivery to all Spruce Creek neighborhoods.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-spruce-creek",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Spruce Creek South",
		"Spruce Creek Preserve",
		"Spruce Creek North",
		"Summerfield",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	},
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Robert K."
			},
			"datePublished": "2024-08-22",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Great rental experience for Spruce Creek. Cart was delivered to our home and we enjoyed exploring the community with our visiting family. Will rent again!"
		}
	]
};

const pageFAQs = [
 {
  "question": "How fast can you deliver to Spruce Creek?",
  "answer": "Often the same or next day when carts are available. Book ahead for holidays and busy event weeks."
 },
 {
  "question": "Is there a delivery fee?",
  "answer": "Delivery is quoted with your reservation based on your address. Call (352) 307-0111 for a quick number."
 },
 {
  "question": "Is there a minimum rental?",
  "answer": "Yes, 3 days. After that, rent by the week, the month or the season."
 },
 {
  "question": "How old do I have to be?",
  "answer": "Renters must be 21 or older with a valid driver license."
 },
 {
  "question": "Can I extend?",
  "answer": "Yes. Call us before your end date and we will extend it if the cart is available."
 }
];

const LEAD = ["Masters Golf Cars provides premium golf cart rentals for Spruce Creek South and Spruce Creek Preserve residents in Summerfield. Since 1999, we've been the trusted source for golf cart rentals just minutes from the Spruce Creek communities at 12885 S US Highway 441 in Belleview.", "Whether you need a temporary cart while yours is being serviced, want extra carts for visiting family, or are exploring the benefits of golf cart ownership, we deliver clean, reliable carts directly to your Spruce Creek home. Our carts are perfect for accessing the Spruce Creek South Country Club, community pools, and all neighborhood amenities."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals for Spruce Creek", url: "https://mastersgolfcars.com/golf-cart-rentals-spruce-creek" }
];
---

<Layout title="Golf Cart Rentals for Spruce Creek | Summerfield, FL" description="Golf cart rentals for Spruce Creek South and Spruce Creek Preserve. Delivery to all Spruce Creek neighborhoods in Summerfield. Since 1999. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-spruce-creek" breadcrumbs={crumbs} quoteHref="#reserve">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="community" name="Spruce Creek" slug="golf-cart-rentals-spruce-creek" eyebrow="Golf cart rentals for Spruce Creek, Summerfield" heading="Golf cart rentals," accent="delivered to Spruce Creek." lead={LEAD} img={R + 'cart-6p.jpg'} imgLabel="Spruce Creek South, Preserve and Del Webb" proof={[["pin", "6 miles away", "About 10 minutes from our shop"], ["truck", "Delivered to your door", "Any Spruce Creek community"], ["key", "300+ carts", "Availability most weeks"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultLocation="Spruce Creek, FL" />
</Layout>
