<script>
	// Quick quote bar: carry the picks down into the main form, then scroll to it.
	const qq = document.querySelector('[data-quickquote]') as HTMLFormElement | null;
	const main = document.querySelector('[data-mainquote]') as HTMLFormElement | null;
	if (qq && main) {
		qq.addEventListener('submit', (e) => {
			e.preventDefault();
			const need = (qq.elements.namedItem('need') as HTMLSelectElement).value;
			const start = (qq.elements.namedItem('start') as HTMLInputElement).value;
			const end = (qq.elements.namedItem('end') as HTMLInputElement).value;
			const zip = (qq.elements.namedItem('zip') as HTMLInputElement).value;
			(main.elements.namedItem('cart_type') as HTMLSelectElement).value = need;
			if (start) (main.elements.namedItem('start_date') as HTMLInputElement).value = start;
			if (end) (main.elements.namedItem('end_date') as HTMLInputElement).value = end;
			const addr = main.elements.namedItem('delivery_address') as HTMLInputElement;
			if (zip && !addr.value) addr.value = zip;
			document.getElementById('quote')?.scrollIntoView({ behavior: 'smooth' });
			setTimeout(() => (main.elements.namedItem('name') as HTMLInputElement).focus({ preventScroll: true }), 500);
		});
	}
</script>
