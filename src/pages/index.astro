---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';
import servicesData from '../data/services.json';

// LocalBusiness Schema for homepage
const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"@id": "https://mastersgolfcars.com/#localbusiness",
	"name": "Masters Golf Cars, LLC",
	"alternateName": "Masters Golf Cars",
	"description": companyData.description,
	"url": "https://mastersgolfcars.com",
	"telephone": "+1-352-307-0111",
	"email": "sales@mastersgolfcars.com",
	"foundingDate": "1999",
	"priceRange": "$$",
	"image": [
		"https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
		"https://mastersgolfcars.com/images/landing-pg-hero-3.jpg"
	],
	"logo": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420",
		"addressCountry": "US"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 29.034576,
		"longitude": -82.025011
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			"opens": "08:30",
			"closes": "17:00"
		},
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": "Saturday",
			"opens": "09:00",
			"closes": "14:00"
		}
	],
	"sameAs": [
		"https://www.facebook.com/mastersgolfcars",
		"https://www.instagram.com/mastersgolfcars/"
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Services",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Rentals"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Sales"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Repairs"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Customization"
				}
			}
		]
	},
	"areaServed": [
		{
			"@type": "City",
			"name": "Ocala",
			"containedInPlace": {
				"@type": "State",
				"name": "Florida"
			}
		},
		{
			"@type": "City",
			"name": "The Villages",
			"containedInPlace": {
				"@type": "State",
				"name": "Florida"
			}
		},
		{
			"@type": "City",
			"name": "Belleview",
			"containedInPlace": {
				"@type": "State",
				"name": "Florida"
			}
		},
		{
			"@type": "City",
			"name": "Gainesville",
			"containedInPlace": {
				"@type": "State",
				"name": "Florida"
			}
		}
	]
};
---

<Layout title="Golf Carts Ocala & The Villages | Masters Golf Cars" hideHeader={true}>
	<Schema schema={localBusinessSchema} slot="schema" />
	<!-- Hero Section with Golf Course Background -->
	<section class="relative min-h-screen flex flex-col">
		<!-- Full-screen golf course background -->
		<div class="absolute inset-0 z-0" style="background-image: url('/images/landing-pg-hero-3.jpg'); background-size: cover; background-position: center;"></div>
		
		<!-- Transparent Header Overlay -->
		<Header transparent={true} />
		
		<!-- Spacer to push carts to bottom -->
		<div class="flex-grow min-h-[30vh]"></div>
		
		<!-- Golf Carts Row - Transparent Overlay -->
		<div class="relative z-10 py-8 md:py-16">
			<div class="container mx-auto px-2 sm:px-4">
				<div class="grid grid-cols-4 gap-2 sm:gap-4 md:gap-8 max-w-7xl mx-auto">
					<div class="flex justify-center items-end">
						<img src="/images/home page carts/rental-club-car-golf-cart_img_v38.webp" alt="Club Car Golf Cart" class="w-full h-auto max-h-24 sm:max-h-32 md:max-h-64 object-contain" style="filter: drop-shadow(0 15px 30px rgba(0,0,0,0.4)) drop-shadow(0 5px 10px rgba(0,0,0,0.3));" loading="eager" fetchpriority="high" width="400" height="300" />
					</div>
					<div class="flex justify-center items-end">
						<img src="/images/home page carts/fleet-rental-club-car-golf-cart_img_v39.webp" alt="Fleet Club Car Golf Cart" class="w-full h-auto max-h-24 sm:max-h-32 md:max-h-64 object-contain" style="filter: drop-shadow(0 15px 30px rgba(0,0,0,0.4)) drop-shadow(0 5px 10px rgba(0,0,0,0.3));" loading="eager" fetchpriority="high" width="400" height="300" />
					</div>
					<div class="flex justify-center items-end">
						<img src="/images/home page carts/fleet-rental-ez-go-golf-cart_img_v40.webp" alt="EZ-GO Golf Cart" class="w-full h-auto max-h-24 sm:max-h-32 md:max-h-64 object-contain" style="filter: drop-shadow(0 15px 30px rgba(0,0,0,0.4)) drop-shadow(0 5px 10px rgba(0,0,0,0.3));" loading="eager" fetchpriority="high" width="400" height="300" />
					</div>
					<div class="flex justify-center items-end">
						<img src="/images/home page carts/fleet-rental-club-car-golf-cart_img_v39.webp" alt="Golf Cart for Sale" class="w-full h-auto max-h-24 sm:max-h-32 md:max-h-64 object-contain" style="filter: drop-shadow(0 15px 30px rgba(0,0,0,0.4)) drop-shadow(0 5px 10px rgba(0,0,0,0.3));" loading="eager" fetchpriority="high" width="400" height="300" />
					</div>
				</div>
			</div>
		</div>
		
		<!-- CTA Boxes -->
		<div class="relative z-10 bg-white py-6 md:py-8">
			<div class="container mx-auto px-4">
				<div class="flex flex-col sm:flex-row flex-wrap justify-center items-stretch sm:items-center gap-3 sm:gap-4 max-w-6xl mx-auto">
					<a href="/rentals" class="bg-black hover:bg-gray-900 text-white px-6 py-3 sm:py-4 text-center font-bold uppercase text-sm sm:text-base transition flex-1 sm:flex-initial min-w-[140px]">
						Cart Rentals
					</a>
					<a href="/fleet-rentals-quote" class="bg-black hover:bg-gray-900 text-white px-6 py-3 sm:py-4 text-center font-bold uppercase text-sm sm:text-base transition flex-1 sm:flex-initial min-w-[140px]">
						Fleet Rentals
					</a>
					<a href="/golf-cart-inventory" class="bg-black hover:bg-gray-900 text-white px-6 py-3 sm:py-4 text-center font-bold uppercase text-sm sm:text-base transition flex-1 sm:flex-initial min-w-[140px]">
						Golf Carts For Sale
					</a>
				</div>
			</div>
		</div>
	</section>
	
	<!-- Search Inventory Section -->
	<section class="bg-brand-green py-12">
		<div class="container mx-auto px-4">
			<div class="bg-white rounded-3xl shadow-2xl px-6 py-10 md:px-10 md:py-12">
				<h2 class="text-3xl md:text-4xl font-bold text-gray-800 text-center mb-8">Search Our Golf Cart Inventory</h2>
				
				<form action="/golf-cart-inventory" method="GET" class="max-w-5xl mx-auto">
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-end">
						<!-- Condition Dropdown -->
						<div>
							<label for="condition" class="block text-gray-800 font-semibold mb-2">Condition</label>
							<select id="condition" name="condition" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:ring-2" style="--tw-ring-color: #86CA26;">
								<option value="">Any</option>
								<option value="new">New</option>
								<option value="used">Used</option>
							</select>
						</div>
						
						<!-- Brand Dropdown -->
						<div>
							<label for="brand" class="block text-gray-800 font-semibold mb-2">Brand</label>
							<select id="brand" name="brand" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:ring-2" style="--tw-ring-color: #86CA26;">
								<option value="">Any</option>
								<option value="club-car">Club Car</option>
								<option value="ez-go">EZ-GO</option>
								<option value="yamaha">Yamaha</option>
							</select>
						</div>
						
						<!-- Keyword/Stock # Input -->
						<div>
							<label for="keyword" class="block text-gray-800 font-semibold mb-2">Keyword Or Stock #</label>
							<input type="text" id="keyword" name="keyword" placeholder="Any" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:ring-2" style="--tw-ring-color: #86CA26;" />
						</div>
						
						<!-- Search Button -->
						<div>
							<button type="submit" class="w-full bg-black hover:bg-gray-900 text-white px-8 py-3 rounded-lg font-bold uppercase transition flex items-center justify-center gap-2">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
								</svg>
								SEARCH
							</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</section>
	
	<!-- Our Brands Section -->
	<section class="relative py-16" style="background-color: #F3F3F3;">
		<!-- Green bar at top -->
		<div class="absolute top-0 left-0 right-0 h-1" style="background-color: #86CA26;"></div>

		<div class="container mx-auto px-4 pt-8">
			<div class="text-center mb-12">
				<h2 class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-800 mb-2">
					Our <span style="color: #86CA26;">Brands</span>
				</h2>
				<p class="text-lg sm:text-xl text-gray-600 font-semibold">Authorized Dealer for the Top Golf Cart Brands</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
				<!-- Club Car -->
				<div class="bg-white rounded-lg shadow-lg p-8 text-center">
					<div class="mb-6 p-4">
						<img src={servicesData.brands.find(b => b.name === 'Club Car')?.icon || '/images/logos/club-car-icon-0-0.webp'} alt="Club Car Golf Carts" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-2xl font-bold text-gray-900 mb-3">Club Car</h3>
					<p class="text-gray-700 font-semibold text-sm mb-4">Premium golf carts known for durability and performance. A trusted choice for communities across Central Florida.</p>
					<a href="/golf-cart-inventory" class="inline-block text-sm font-bold uppercase transition" style="color: #86CA26;">Browse Inventory →</a>
				</div>

				<!-- Yamaha -->
				<div class="bg-white rounded-lg shadow-lg p-8 text-center">
					<div class="mb-6 p-4">
						<img src={servicesData.brands.find(b => b.name === 'Yamaha')?.icon || '/images/logos/yamaha-icon-0-1.webp'} alt="Yamaha Golf Carts" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-2xl font-bold text-gray-900 mb-3">Yamaha</h3>
					<p class="text-gray-700 font-semibold text-sm mb-4">Reliable and efficient golf carts with excellent battery life. Great for daily use in The Villages and Ocala.</p>
					<a href="/golf-cart-inventory" class="inline-block text-sm font-bold uppercase transition" style="color: #86CA26;">Browse Inventory →</a>
				</div>

				<!-- EZ-GO -->
				<div class="bg-white rounded-lg shadow-lg p-8 text-center">
					<div class="mb-6 p-4">
						<img src={servicesData.brands.find(b => b.name === 'EZ-GO')?.icon || '/images/logos/ez-go-icon-0-2.webp'} alt="EZ-GO Golf Carts" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-2xl font-bold text-gray-900 mb-3">EZ-GO</h3>
					<p class="text-gray-700 font-semibold text-sm mb-4">Affordable and versatile golf carts perfect for any lifestyle. Popular choice for value and reliability.</p>
					<a href="/golf-cart-inventory" class="inline-block text-sm font-bold uppercase transition" style="color: #86CA26;">Browse Inventory →</a>
				</div>
			</div>
		</div>
	</section>
	
	<!-- Welcome Section -->
	<section class="bg-white py-16">
		<div class="container mx-auto px-4">
			<!-- Heading -->
			<h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4 text-center">
				Welcome to {companyData.name}
			</h2>
			<p class="text-2xl md:text-3xl font-bold text-gray-800 mb-8 text-center">
				{companyData.tagline}
			</p>
			
			<!-- Description Paragraphs -->
			<div class="max-w-4xl mx-auto mb-12">
				<p class="text-lg text-gray-700 mb-6">
					{companyData.description}
				</p>
				
				<p class="text-lg text-gray-700 mb-4">
					<strong>Comprehensive Services Tailored to Your Needs</strong>
				</p>
				<ul class="text-lg text-gray-700 space-y-3 mb-6">
					<li>
						<strong>Golf Cart Rentals:</strong> Whether you need a single cart or an entire fleet, we offer flexible rental options ideal for events like concerts, equestrian, parades, festivals, and more!
					</li>
					<li>
						<strong>Sales of New and Pre-Owned Carts:</strong> Explore an extensive selection of new and used golf carts, including custom-built units, fleet units, trade-ins, and wholesale options.
					</li>
					<li>
						<strong>Customization:</strong> Bring your vision to life with personalized golf carts tailored to your specific preferences and needs.
					</li>
					<li>
						<strong>Maintenance and Repairs:</strong> Ensure your cart remains in peak condition with their expert maintenance and repair services.
					</li>
				</ul>
			</div>
			
			<!-- CTA Buttons -->
			<div class="flex flex-wrap justify-center gap-4 mb-16 max-w-4xl mx-auto">
				<a href="/sell-your-cart" class="bg-black hover:bg-gray-900 text-white px-8 py-4 text-center font-bold uppercase text-base transition">
					SELL YOUR CART
				</a>
				<a href="/schedule-golf-cart-service" class="bg-black hover:bg-gray-900 text-white px-8 py-4 text-center font-bold uppercase text-base transition">
					SCHEDULE A REPAIR
				</a>
				<a href="/rentals" class="bg-black hover:bg-gray-900 text-white px-8 py-4 text-center font-bold uppercase text-base transition">
					RENT A CART
				</a>
				<a href="/fleet-rentals-quote" class="bg-black hover:bg-gray-900 text-white px-8 py-4 text-center font-bold uppercase text-base transition">
					FLEET RENTALS
				</a>
			</div>
			
			<!-- Brands Section -->
			<div class="max-w-6xl mx-auto">
				<h3 class="text-3xl md:text-4xl font-bold text-gray-800 text-center mb-12">
					Brands We Work With
				</h3>
				<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 items-center">
					{servicesData.brands.map((brand) => (
						<div class="flex items-center justify-center p-4 group cursor-pointer">
							<img src={brand.icon} alt={brand.name} class="max-h-16 w-full object-contain transition-transform duration-300 group-hover:scale-110 group-hover:opacity-80" loading="lazy" width="100" height="100" />
						</div>
					))}
				</div>
			</div>
		</div>
	</section>
	
	<!-- Customer Reviews CTA Section -->
	<section class="bg-brand-green py-12">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
					Love Our Service? Share Your Experience!
				</h2>
				<p class="text-white text-lg mb-6 opacity-90">
					Your feedback helps us serve you better and helps others find quality golf cart services.
				</p>
				<a href="https://g.page/r/Ce6p7W6HMgpTEBM/review" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white hover:bg-gray-100 text-gray-900 px-8 py-4 font-bold uppercase text-base transition rounded-lg shadow-lg">
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
						<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
						<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
						<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
						<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
					</svg>
					Leave Us a Google Review
				</a>
			</div>
		</div>
	</section>

	<!-- Financing Section -->
	<section class="bg-gray-100 py-16">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto text-center">
				<!-- Title -->
				<h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-6">
					Easy Financing is Available on all new and used carts!
				</h2>

				<!-- Description -->
				<p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">
					What's the best path for you? We have many tools to share. Please stop by our office and share what would be a good fit for you. We use a number of best-in-class sources to help your dreams come true. We look forward to helping you.
				</p>

				<!-- Sheffield Financial Logo -->
				<div class="mb-8 flex justify-center">
					<img src="/images/logos/sheffield-financial_img_v25.webp" alt="Sheffield Financial" class="h-16 md:h-20 object-contain" loading="lazy" width="200" height="80" />
				</div>

				<!-- Apply Button -->
				<a href="https://prequalify.sheffieldfinancial.com/Apply/Landing?source=web&dealer=57070" target="_blank" rel="noopener noreferrer" class="inline-block bg-black hover:bg-gray-900 text-white px-8 py-4 font-bold uppercase text-base transition">
					APPLY FOR FINANCING
				</a>
			</div>
		</div>
	</section>
	
	<!-- Why Choose Masters Golf Cars Section -->
	<section class="bg-white py-16">
		<div class="container mx-auto px-4">
			<div class="max-w-5xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center">
					Why Choose <span style="color: #86CA26;">Masters Golf Cars</span>?
				</h2>
				<p class="text-lg text-gray-600 text-center mb-12 max-w-3xl mx-auto">
					Central Florida's trusted golf cart dealer since 1999. Sales, service, and rentals — all under one roof.
				</p>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
					<!-- Authorized Dealer -->
					<div class="text-center p-6">
						<div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background-color: rgba(134, 202, 38, 0.15);">
							<svg class="w-8 h-8" style="color: #86CA26;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-gray-900 mb-2">Authorized Dealer</h3>
						<p class="text-gray-600 text-sm font-semibold">Trusted dealer for Club Car, Yamaha & EZ-GO since 1999.</p>
					</div>

					<!-- Full Service -->
					<div class="text-center p-6">
						<div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background-color: rgba(134, 202, 38, 0.15);">
							<svg class="w-8 h-8" style="color: #86CA26;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-gray-900 mb-2">Full Service & Repairs</h3>
						<p class="text-gray-600 text-sm font-semibold">Expert technicians for all makes and models. Maintenance, repairs & custom upgrades.</p>
					</div>

					<!-- Financing -->
					<div class="text-center p-6">
