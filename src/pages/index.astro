---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import Ring from '../components/ui/Ring.astro';
import Btn from '../components/ui/Btn.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Stars from '../components/ui/Stars.astro';
import Check from '../components/ui/Check.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';
import servicesData from '../data/services.json';

// LocalBusiness Schema for homepage
const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://mastersgolfcars.com/#localbusiness",
	"name": "Masters Golf Cars, LLC",
	"alternateName": "Masters Golf Cars",
	"description": companyData.description,
	"url": "https://mastersgolfcars.com",
	"telephone": "+1-352-307-0111",
	"email": "sales@mastersgolfcars.com",
	"foundingDate": "1999",
	"priceRange": "$$",
	"image": [
		"https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
		"https://mastersgolfcars.com/images/redesign/fleet-poster.jpg"
	],
	"logo": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420",
		"addressCountry": "US"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 29.034576,
		"longitude": -82.025011
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			"opens": "08:30",
			"closes": "17:00"
		},
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": "Saturday",
			"opens": "09:00",
			"closes": "14:00"
		}
	],
	"sameAs": [
		"https://www.facebook.com/mastersgolfcars",
		"https://www.instagram.com/mastersgolfcars/"
	],
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "4.9",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "93"
	},
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Services",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Rentals"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Sales"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Repairs"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Customization"
				}
			}
		]
	},
	"areaServed": [
		{
			"@type": "City",
			"name": "Ocala",
			"containedInPlace": {
				"@type": "State",
				"name": "Florida"
			}
		},
		{
			"@type": "City",
			"name": "The Villages",
			"containedInPlace": {
				"@type": "State",
				"name": "Florida"
			}
		},
		{
			"@type": "City",
			"name": "Belleview",
			"containedInPlace": {
				"@type": "State",
				"name": "Florida"
			}
		},
		{
			"@type": "City",
			"name": "Gainesville",
			"containedInPlace": {
				"@type": "State",
				"name": "Florida"
			}
		}
	]
};

const R = '/images/redesign/';
const BOLT = '<svg width="0.62em" height="0.9em" viewBox="0 0 16 24" fill="#76c82f" aria-hidden="true" style="display:inline-block;vertical-align:-0.06em;margin-left:0.08em"><path d="M10.5 0L0 13.5h6L4.5 24 16 9.5H9.5z"></path></svg>';
const NEEDS = ['A golf cart rental', 'A fleet or event rental', 'A lithium conversion', 'Service or repair', 'To buy a cart', 'To sell my cart', 'A custom build'];
const EVENTS = ['Equestrian events', 'Tournaments', 'Festivals', 'Corporate events', 'Gun clubs', 'Dog shows', 'Air shows', 'Sporting events', 'Holidays', 'Special events'];
const CARTS = [
	{ img: 'cart-2p.jpg', alt: 'Two passenger rental golf cart', title: '2 passenger', sub: 'Staff, vendors and quick runs' },
	{ img: 'cart-4p.jpg', alt: 'Four passenger rental golf cart', title: '4 passenger', sub: 'Our most requested event cart' },
	{ img: 'cart-6p.jpg', alt: 'Six passenger rental golf cart', title: '6 passenger', sub: 'Guest shuttles and VIP groups' },
	{ img: 'carryall.jpg', alt: 'Club Car Carryall utility cart with aluminum cargo bed', title: 'Utility cart', sub: 'Hauls gear, feed and supplies', contain: true, pos: '50% 50%' },
];
const REVIEWS = [
	{ q: 'They have been repairing our fleet of carts for over 15 years. Nothing but professional and extremely speedy service at an affordable price. Not to mention they will pick up your cart and bring it all the way back to you.', who: 'Jay DeFalco', where: 'Fleet customer, Google review' },
	{ q: 'Excellent company, fast service, prices fair. I had the annual service and also replaced worn out bearings and hubs. Picked the cart up yesterday and returned it today. Very pleased with the communications about the estimate.', who: 'Robert McIntyre', where: 'Service customer, Google review' },
];
const AREAS = [['The Villages','/the-villages-golf-cart-rentals'],['Ocala','/golf-cart-rentals-ocala'],['Belleview','/golf-cart-rentals-belleview'],['Gainesville','/golf-cart-rentals-gainesville'],['World Equestrian Center','/golf-cart-rentals-wec'],['On Top of the World','/golf-cart-rentals-otow'],['Spruce Creek','/golf-cart-rentals-spruce-creek'],['Oak Run','/golf-cart-rentals-oak-run']];
const GOOGLE_REVIEWS = 'https://www.google.com/search?q=Masters+Golf+Cars+Belleview+FL+reviews';
---

<Layout title={`${companyData.name} - ${companyData.tagline}`} description="Golf cart rentals, sales, service, Bolt Energy lithium conversions and custom builds in Belleview, FL. Serving The Villages, Ocala and Central Florida since 1999.">
	<Schema schema={localBusinessSchema} slot="schema" />

	<!-- HERO -->
	<section class="hero on-dark">
		<video autoplay muted loop playsinline preload="metadata" poster={R + 'fleet-poster.jpg'} aria-label="Drone flyover of the Masters rental fleet, hundreds of golf carts parked in rows">
			<source src={R + 'hero-loop.webm'} type="video/webm" />
			<source src={R + 'hero-loop.mp4'} type="video/mp4" />
		</video>
		<div class="shade"></div>
		<div class="hero-copy">
			<Eyebrow>A whole different drive</Eyebrow>
			<h1 class="h1"><span class="kicker">Masters Golf Cars doesn&#39;t follow the golf cart industry.</span><span class="big">We drive it.</span></h1>
			<p class="lead hero-lead">Central Florida&#39;s premier destination for Golf Cart Rentals, Sales, Service, Lithium Battery Conversions and Customization.</p>
			<div class="row btn-row" style="gap:16px"><Btn href="#choices" kind="solid">Explore the possibilities</Btn><Btn href="#events" kind="ghost-d">Plan an event fleet</Btn></div>
		</div>
		<div class="serving">Proudly serving The Villages, Ocala, Marion County and Central Florida since 1999.</div>
		<div class="quickquote">
			<div class="flame-line"></div>
			<form class="qq" data-quickquote action="#quote" method="get">
				<div class="field dark"><label for="q-need">I need</label><select id="q-need" name="need">{NEEDS.map((n) => <option>{n}</option>)}</select></div>
				<div class="field dark"><label for="q-start">Start date</label><input id="q-start" name="start" type="date" /></div>
				<div class="field dark"><label for="q-end">End date</label><input id="q-end" name="end" type="date" /></div>
				<div class="field dark"><label for="q-zip">Delivery zip</label><input id="q-zip" name="zip" type="text" inputmode="numeric" placeholder="34420" /></div>
				<button type="submit" class="btn solid" style="height:50px"><span>Get my quote</span><Icon name="arrow" size={18} /></button>
			</form>
		</div>
	</section>

	<!-- PROOF STRIP -->
	<section class="proof">
		{[['star','4.9 on Google','From 93 customer reviews'],['award','Since 1999','Family run in Belleview'],['key','300+ carts','In the rental fleet'],['shield','Authorized dealer','Club Car, Yamaha, E-Z-GO']].map(([i,b,s]) => (
			<div class="row" style="gap:18px"><Ring name={i} /><div class="stack" style="gap:4px"><div class="fd pbig">{b}</div><div class="small">{s}</div></div></div>
		))}
	</section>

	<!-- CHOICES -->
	<section id="choices" class="sec white stack" style="gap:56px">
		<div class="stack" style="gap:32px">
			<div class="head"><Eyebrow>One name. Every possibility.</Eyebrow><h2 class="h2 xl">Masters does <span class="g">it all.</span></h2></div>
			<div class="verbs">
				{[['key','Rent it.'],['tag','Buy it.'],['sliders','Build it.'],['battery','Power it.'],['wrench','Service it.']].map(([i,t]) => (
					<div class="row" style="gap:14px"><Ring name={i} fill /><span class="fd verb">{t}</span></div>
				))}
			</div>
		</div>
		<div class="choice-grid">
			{[
				{ href: '/customize', icon: 'sliders', label: 'Make it yours', title: 'Customize your cart', body: 'Seats, wheels, lift kits, lighting and paint. Built around you.', link: 'Plan your build' },
				{ href: '/bolt-lithium', icon: 'battery', label: 'Power your next chapter', title: 'Bolt Energy lithium', body: 'More range, faster charging and zero maintenance. Installed in our shop.', link: 'Make the switch', dark: true },
				{ href: '/golf-cart-rentals', icon: 'key', label: 'Keep everyone moving', title: 'Golf cart rentals', body: 'One cart for the week or a whole fleet for your event. Delivered and picked up.', link: 'See rentals' },
			].map((c) => (
				<a href={c.href} class:list={['choice', { 'on-dark': c.dark }]}>
					<div class="top"></div>
					<div class="inner">
						<div class="row" style="justify-content:space-between"><div class="ring fill" style="width:68px;height:68px"><Icon name={c.icon} size={30} /></div><span class="sq"><Icon name="arrow" size={22} /></span></div>
						<div class="stack" style="gap:10px"><span class="clabel">{c.label}</span><h3 class="h3 ctitle">{c.title}</h3></div>
						<p class="body">{c.body}</p>
						<span class="clink">{c.link}</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- FLEET AND EVENTS -->
	<section id="events" class="fleet paper">
		<div class="sweep">
			<video autoplay muted loop playsinline preload="none" poster={R + 'fleet-aerial-road.jpg'} aria-label="Low drone pass over rows of rental golf carts">
				<source src={R + 'sweep.webm'} type="video/webm" />
				<source src={R + 'sweep.mp4'} type="video/mp4" />
			</video>
			<div class="sweep-tag">Fleet and event rentals, throughout Florida</div>
		</div>
		<div class="fleet-body">
			<div class="fleet-top">
				<div class="stack" style="gap:24px">
					<h2 class="h2 xl">Big events require<br /><span class="g">big fleets.</span></h2>
					<p class="fd fleet-sub">Experience matters. Trust Masters Golf Cars to drive your event forward.</p>
				</div>
				<div class="stack" style="gap:24px">
					<div class="check-list">{EVENTS.map((e) => <Check>{e}</Check>)}</div>
					<p class="fd fleet-ready">From a few carts to a full-scale event fleet. We&#39;re ready.</p>
					<p class="body"><strong style="color:var(--ink)">Reliable carts. Professional delivery. Experienced event management.</strong><br />Serving events throughout Florida.</p>
					<div class="row"><Btn href="/fleet-rentals-quote">Request a fleet quote</Btn></div>
				</div>
			</div>
			<div class="grid4 carts">
				{CARTS.map((c) => (
					<a href="/fleet-rentals-quote" class="cart">
						<div class="ph" style={c.contain ? 'padding:14px;background:#fff' : ''}><img src={R + c.img} alt={c.alt} loading="lazy" width="640" height="420" style={`object-fit:${c.contain ? 'contain' : 'cover'};object-position:${c.pos || '50% 55%'}`} /></div>
						<div class="row" style="justify-content:space-between;gap:12px;padding:18px 20px"><div class="stack" style="gap:3px"><h3 class="h3 ct">{c.title}</h3><span class="small">{c.sub}</span></div><Icon name="arrow" size={20} /></div>
					</a>
				))}
			</div>
			<div class="stats">
				{[['25+ yrs','Moving fleets since 1999'],['300+ carts','In the rental fleet'],['4 types','2, 4, 6 passenger and utility']].map(([b,s]) => (
					<div class="stat"><div class="fd sbig">{b}</div><div class="small">{s}</div></div>
				))}
			</div>
		</div>
	</section>

	<!-- BOLT LITHIUM -->
	<section class="sec dark on-dark stack bolt" style="gap:48px">
		<div class="stack" style="gap:22px">
			<Eyebrow green>Bolt Energy lithium batteries</Eyebrow>
			<div class="fd" style="font-size:22px;line-height:1.2">Ready to ditch lead-acid?</div>
			<h2 class="h2 bolt-h">Go lithium<Fragment set:html={BOLT} /><br />Go further<Fragment set:html={BOLT} /><br /><span class="g">Go Bolt Energy</span><Fragment set:html={BOLT} /></h2>
		</div>
		<div class="bolt-grid">
			<img src={R + 'bolt-trio.jpg'} alt="Three Bolt lithium golf cart batteries in 38.4 volt and 51.2 volt sizes stacked in front of a golf cart" loading="lazy" width="620" height="560" class="bolt-img" />
			<div class="stack" style="gap:30px">
				<p class="fd" style="margin:0;font-size:26px;line-height:34px">Make the switch today to Bolt Energy lithium.</p>
				<div class="bens">
					{[['gauge','More range','Up to 70 miles on a charge.'],['zap','More power','Steady power, even on hills.'],['clock','Faster charging','2 to 4 hours, not 8 to 12.'],['feather','Less weight','Hundreds of pounds lighter.'],['drop','Zero maintenance','No watering. No cleaning.'],['shield','12 year warranty','Industry leading, backed by Bolt.']].map(([i,t,s]) => (
						<div class="ben"><Ring name={i} dark green /><div class="stack" style="gap:4px"><div class="fd" style="font-size:16px;line-height:22px">{t}</div><div class="small">{s}</div></div></div>
					))}
				</div>
				<div class="stack" style="gap:14px">
					<span class="label">How far do you want to go?</span>
					<div class="rng-grid">
						{[['24 mi','60Ah','Everyday power',false],['50 mi','105Ah','Extended range',true],['70 mi','160Ah','Maximum freedom',false]].map(([mi,ah,lab,hot]) => (
							<div class:list={['rng', { hot }]}><span class="fd mi">{mi}</span><span class="ah">{ah}{hot ? ' · Most popular' : ''}</span><span class="small">{lab}</span></div>
						))}
					</div>
					<span class="small" style="font-size:12px;line-height:18px">Published Bolt estimates for 48 volt carts. Actual range varies with cart, passengers, speed and terrain.</span>
				</div>
				<div class="row btn-row" style="gap:24px"><Btn href="/bolt-lithium" kind="green">Get my conversion price</Btn><span class="small" style="font-size:15px;line-height:22px">Professional installation by Masters Golf Cars.</span></div>
			</div>
		</div>
	</section>

	<!-- CUSTOMIZE -->
	<section class="sec white grid2">
		<img src={R + 'custom-detail.jpg'} alt="Lifted four passenger golf cart with custom striped seats" loading="lazy" width="640" height="440" class="custom-img" />
		<div class="stack" style="gap:32px">
			<div class="head"><Eyebrow>Customization</Eyebrow><h2 class="h2">Your cart.<br />Your way.</h2><p class="lead">From seating and wheels to lighting and finishes, tell us what you want and we will build it.</p></div>
			<div class="check-list" style="gap:14px 24px">{['Custom seats and upholstery','Wheels and tires','Lift kits','LED lighting','Enclosures','Paint and finishes'].map((t) => <Check>{t}</Check>)}</div>
			<div class="row"><Btn href="/customize">Plan your custom cart</Btn></div>
		</div>
	</section>

	<!-- HOW RENTING WORKS -->
	<section class="sec paper how">
		<div class="stack" style="gap:32px">
			<div class="head"><Eyebrow>Individual and Villages rentals</Eyebrow><h2 class="h2 md">Your stay.<br />Your needs.<br />Your cart.</h2><p class="lead" style="max-width:380px">Here for a holiday, a season or a little time away? Renting takes three steps.</p></div>
			<div class="row"><Btn href="/golf-cart-rentals">Check availability</Btn></div>
		</div>
		<div class="how-grid">
			{[['cart-2p.jpg','Two passenger Yamaha rental golf cart','2 passenger','Couples. Easy to park at the squares.'],['cart-4p-deluxe.jpg','Four passenger Yamaha rental golf cart with sun top','4 passenger','Most popular. Family and friends.'],['cart-6p.jpg','Six passenger rental golf cart','6 passenger','The whole crew when family visits.']].map(([img,alt,t,s]) => (
				<div class="stack" style="gap:10px"><div class="vph"><img src={R + img} alt={alt} loading="lazy" width="420" height="200" /><span class="vtag">{t}</span></div><span class="small">{s}</span></div>
			))}
			{[['1','key','Pick your cart','2, 4 or 6 seats. Every cart is cleaned and checked before it goes out.'],['2','calendar','Pick your dates','A week, a month or the whole season. 3 day minimum.'],['3','truck','We deliver it and pick it up','Right to your driveway or venue. When you are done, we come get it.']].map(([n,i,t,b]) => (
				<div class="step"><div class="row" style="justify-content:space-between"><Ring name={i} /><span class="fd stepn">{n}</span></div><h3 class="h3">{t}</h3><p class="body">{b}</p></div>
			))}
		</div>
	</section>

	<!-- SERVICE + SALES -->
	<section class="sec white svcsales">
		{[
			{ eb: 'Service and repair', title: ['Keep your cart', 'moving.'], lead: 'Our Belleview shop works on gas and electric carts every day.', img: 'clubcar-utility-row.jpg', alt: 'Row of Club Car utility carts with aluminum cargo beds at the Masters lot', cta: 'Schedule service', href: '/golf-cart-repairs', ticks: [['clock','Most repairs done in 24 hours','You get a text when it is ready.'],['truck','Pickup and delivery','Or bring it to the shop in Belleview.'],['wrench','Parts and accessories','Club Car, E-Z-GO and Yamaha.']] },
			{ eb: 'Golf cart sales', title: ['Find your', 'next ride.'], lead: 'Let us find a golf cart that fits your everyday.', img: 'clubcar-row.jpg', alt: 'Row of white Club Car golf carts lined up for sale', cta: 'View carts', href: '/golf-cart-inventory', ticks: [['tag','New and pre-owned carts','Club Car, Yamaha and E-Z-GO.'],['shield','Financing available','Apply online through Sheffield Financial.'],['key','Sell your cart','Get an offer on your current cart.']] },
		].map((h) => (
			<div class="stack" style="gap:32px">
				<div class="hph"><img src={R + h.img} alt={h.alt} loading="lazy" width="640" height="300" /></div>
				<div class="head"><Eyebrow>{h.eb}</Eyebrow><h2 class="h2 md">{h.title[0]}<br />{h.title[1]}</h2><p class="lead">{h.lead}</p></div>
				<div class="ticks">{h.ticks.map(([i,t,s]) => <div class="tick"><Ring name={i} /><div class="stack" style="gap:2px"><div class="fd" style="font-size:17px;line-height:24px">{t}</div><div class="small" style="font-size:15px;line-height:22px">{s}</div></div></div>)}</div>
				<div class="row"><Btn href={h.href}>{h.cta}</Btn></div>
			</div>
		))}
	</section>

	<!-- REVIEWS -->
	<section class="sec paper stack" style="gap:56px">
		<div class="rev-head">
			<div class="head"><Eyebrow>What customers say</Eyebrow><h2 class="h2 md">25+ years of showing up on time.</h2></div>
			<a href={GOOGLE_REVIEWS} rel="noopener" target="_blank" class="rev-link"><span>Read all reviews on Google</span><Icon name="arrow" size={18} /></a>
		</div>
		<div class="rev-grid">
			<div class="rev-score on-dark"><div class="stack" style="gap:12px"><div class="fd" style="font-size:88px;line-height:.95">4.9</div><Stars /></div><div class="small">Average from 93 Google reviews</div></div>
			{REVIEWS.map((r) => (
				<div class="review"><div class="stack" style="gap:18px"><Stars /><p class="quote">"{r.q}"</p></div><div class="who"><strong>{r.who}</strong><br /><span class="small">{r.where}</span></div></div>
			))}
		</div>
	</section>

	<!-- WHERE WE DELIVER -->
	<section class="sec white areas">
		<div class="head"><Eyebrow>Where we deliver</Eyebrow><h2 class="h2 md">Big event or small getaway.<br />We bring the cart to you.</h2><p class="lead" style="max-width:460px">Local service. Statewide event capability.</p></div>
		<div class="area-list">
			{AREAS.map(([n,h]) => <a href={h} class="area"><span class="row" style="gap:14px"><Icon name="pin" size={20} /><span>{n}</span></span><Icon name="arrow" size={20} /></a>)}
		</div>
	</section>

	<!-- QUOTE FORM -->
	<section id="quote" class="sec dark on-dark quote-sec">
		<div class="stack" style="gap:32px">
			<div class="head"><Eyebrow>Get a quote</Eyebrow><h2 class="h2 xl">Let us get<br />you <span class="g">moving.</span></h2><p class="lead" style="max-width:470px">Tell us what you need and our team will get back to you as soon as possible during business hours.</p></div>
			<a href={companyData.contact.phoneLink} class="row" style="gap:16px"><Ring name="phone" dark green /><span class="fd" style="font-size:34px;line-height:1">{companyData.contact.phone}</span></a>
		</div>
		<form class="form-card" name="rental-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/success" data-mainquote>
			<input type="hidden" name="form-name" value="rental-inquiry" />
			<input type="hidden" name="page_source" value="home" />
			<p class="hidden"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
			<div class="field"><label for="f-name">Name</label><input id="f-name" name="name" type="text" required autocomplete="name" /></div>
			<div class="field"><label for="f-phone">Mobile phone</label><input id="f-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" /></div>
			<div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" required autocomplete="email" /></div>
			<div class="field"><label for="f-need">I need</label><select id="f-need" name="cart_type">{NEEDS.map((n) => <option>{n}</option>)}</select></div>
			<div class="field"><label for="f-start">Start date</label><input id="f-start" name="start_date" type="date" /></div>
			<div class="field"><label for="f-end">End date</label><input id="f-end" name="end_date" type="date" /></div>
			<div class="field span2"><label for="f-addr">Delivery address or venue</label><input id="f-addr" name="delivery_address" type="text" autocomplete="street-address" /></div>
