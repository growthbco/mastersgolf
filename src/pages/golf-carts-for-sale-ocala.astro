---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import HeroSplit from '../components/sections/HeroSplit.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import InventoryGrid from '../components/sections/InventoryGrid.astro';
import LocalContent from '../components/sections/LocalContent.astro';
import Reviews from '../components/sections/Reviews.astro';
import Faq from '../components/sections/Faq.astro';
import FormShell from '../components/forms/FormShell.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Check from '../components/ui/Check.astro';
import local from '../data/locations/golf-carts-for-sale-ocala.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Ocala Golf Carts for Sale",
	"description": "New and used golf carts for sale in Ocala, FL. Serving Ocala Palms, Golden Ocala, Woodfields, Stonecrest, Rolling Greens, On Top of The World, and all of Marion County.",
	"url": "https://mastersgolfcars.com/golf-carts-for-sale-ocala",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Ocala Palms",
		"Golden Ocala",
		"Woodfields",
		"Stonecrest",
		"Rolling Greens",
		"On Top of The World",
		"Country Club of Ocala",
		"Oak Run",
		"Downtown Ocala",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	},
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Robert M."
			},
			"datePublished": "2024-10-05",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Bought my golf cart from Masters Golf Cars for use in Ocala Palms. The staff was knowledgeable and helped me find the perfect cart for my needs. Great service!"
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Sarah K."
			},
			"datePublished": "2024-08-18",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Excellent experience buying our golf cart. They understood our needs for Golden Ocala and recommended the perfect Club Car. Highly recommend!"
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Mike T."
			},
			"datePublished": "2024-06-22",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Found a great used golf cart at Masters Golf Cars. The financing was easy and the cart has been perfect for getting around Woodfields. Great dealership!"
		}
	]
};
const salesOcalaFAQs = [
	{
		question: "Does Masters Golf Cars sell new and used golf carts?",
		answer: "Yes. Masters Golf Cars sells both new and pre-owned golf carts, and we also build custom carts. Visit us at 12885 S US Hwy 441, Belleview, FL 34420 or call (352) 307-0111."
	},
	{
		question: "Where can I buy a golf cart near Ocala?",
		answer: "Masters Golf Cars is a family-run golf cart dealer just south of Ocala at 12885 S US Hwy 441 in Belleview, FL 34420. We have sold new and pre-owned carts to the Ocala area since 1999."
	},
	{
		question: "Is Masters Golf Cars a reputable golf cart dealer near Ocala?",
		answer: "Masters Golf Cars is one of the area's longest-running golf cart dealers, family-run since 1999 and serving Marion, Sumter, Lake, and Alachua counties."
	},
	{
		question: "What golf cart brands does Masters Golf Cars sell?",
		answer: "We sell and service Club Car, Yamaha, and EZ-GO golf carts, along with Trojan batteries."
	},
	{
		question: "What areas do you serve?",
		answer: "We serve Ocala, The Villages, Belleview, Gainesville, and surrounding Central Florida communities across Marion, Sumter, Lake, and Alachua counties."
	},
	{
		question: "What are your hours?",
		answer: "We are open Monday through Friday 8:30am to 5:00pm and Saturday 9:00am to 2:00pm. Call (352) 307-0111 or email sales@mastersgolfcars.com."
	}
];

const LEAD = ["Since 1999, Masters Golf Cars has been Ocala's premier destination for new and used golf carts. We serve residents throughout Marion County, including communities like Ocala Palms, Golden Ocala Golf & Equestrian Club, Woodfields, Stonecrest, Rolling Greens, and On Top of The World.", "Our convenient location at 12885 S US Highway 441 in Belleview (just 8 miles south of downtown Ocala, across from the Market of Marion) makes us easily accessible from State Road 200, I-75, and SR 40. With over 26 years of experience serving Ocala, we're your trusted source for Club Car, Yamaha, and EZ-GO golf carts."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Inventory", url: "https://mastersgolfcars.com/golf-cart-inventory" },
	{ name: "Ocala", url: "https://mastersgolfcars.com/golf-carts-for-sale-ocala" }
];
---

<Layout title="Golf Carts for Sale in Ocala, FL | Masters Golf Cars - New & Used" description="Buy golf carts in Ocala, FL. New & used golf carts for sale. Serving Ocala Palms, Golden Ocala, Woodfields. Financing available. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-carts-for-sale-ocala" breadcrumbs={crumbs} quoteHref="#askcart">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={salesOcalaFAQs} />

	<HeroSplit eyebrow="Golf carts for sale in Ocala" heading="Your next cart," accent="delivered to Ocala." lead={LEAD[0]} cta="Browse inventory" ctaHref="#inventory" checks={['New and pre-owned', 'Financing through Sheffield Financial', 'Trade-ins welcome', 'Delivered to Ocala']} img={R + 'clubcar-row.jpg'} alt="Row of golf carts for sale at Masters Golf Cars" label="12 miles from our shop" pos="50% 60%" />
	<ProofBar items={[['tag', 'New and pre-owned', 'Club Car, Yamaha, E-Z-GO, Advanced EV'], ['dollar', 'Financing', 'Apply online with Sheffield Financial'], ['truck', 'Delivered to Ocala', 'Set up and ready to drive'], ['star', '4.9 on Google', 'From 93 customer reviews']]} />
	{LEAD.length > 1 && <section class="sec white" style="padding-bottom:0"><div class="stack" style="gap:16px;max-width:820px">{LEAD.slice(1).map((p) => <p class="body" style="font-size:17px;line-height:28px">{p}</p>)}</div></section>}
	<InventoryGrid bg="white" />
	<LocalContent sections={local.sections} eyebrow="Buying a cart in Ocala" />

	<section class="sec dark on-dark fin">
		<div class="head"><Eyebrow>Financing</Eyebrow><h2 class="h2">Easy financing on <span class="g">new and used carts.</span></h2><p class="lead" style="max-width:460px">Apply online in a few minutes through Sheffield Financial. Approved buyers can drive away the same day.</p></div>
		<div class="stack" style="gap:28px">
			<div class="check-list" style="gap:14px 24px">{['Apply online, from home', 'New and pre-owned carts', 'Trade-ins accepted toward your purchase', 'Free first year of 24hr Cart Club with every new cart'].map((t) => <Check>{t}</Check>)}</div>
			<div class="row btn-row" style="gap:16px"><Btn href="https://www.sheffieldfinancial.com/" kind="solid">Apply for financing</Btn><Btn href="/sell-your-cart" kind="ghost-d">Sell or trade your cart</Btn></div>
		</div>
	</section>

	<Reviews heading="What Ocala buyers say." />
	<Faq items={salesOcalaFAQs} heading="Ocala questions." />

	<FormShell id="askcart" eyebrow="Ask about a cart" heading="Found one you" accent="like?" lead="Tell us what you are looking for and our sales team will get back to you as soon as possible during business hours.">
		<CartInquiryForm pageSource="golf-carts-for-sale-ocala" idPrefix="sales" />
	</FormShell>
</Layout>

<style>
	.fin { display: grid; grid-template-columns: 1fr 1.3fr; gap: 80px; align-items: center; }
	@media (max-width: 1100px) { .fin { grid-template-columns: 1fr; gap: 40px; } }
</style>
