---
import Layout from '../layouts/Layout.astro';
import companyData from '../data/company.json';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Ring from '../components/ui/Ring.astro';
import Icon from '../components/ui/Icon.astro';
const NEXT = [['key', 'Golf cart rentals', 'One cart for the week or a whole fleet for your event.', '/golf-cart-rentals'], ['tag', 'Carts for sale', 'New and pre-owned, with financing through Sheffield Financial.', '/golf-cart-inventory'], ['battery', 'Bolt lithium', 'More range, faster charging and a 12 year warranty.', '/bolt-lithium']];
---

<Layout title="Thank You - Masters Golf Cars" description="Thank you for contacting Masters Golf Cars. We've received your inquiry and will follow up shortly." quoteHref="/contact">
	<section class="sec paper thanks">
		<div class="stack" style="gap:24px;max-width:640px">
			<Ring name="check" fill />
			<Eyebrow>Request received</Eyebrow>
			<h1 class="h1" style="font-size:56px">Thanks. We got it.</h1>
			<p class="lead">A member of our team will follow up by phone or email by the next business day. Business hours are Monday to Friday 8:30 to 5 and Saturday 9 to 2.</p>
			<p class="body">We review every request personally, confirm availability or pricing, and reach out with answers. No auto-replies, no chatbots.</p>
		</div>
		<div class="stack on-dark" style="gap:16px;padding:32px;background:var(--black)">
			<span class="label" style="color:var(--green)">Need an answer sooner?</span>
			<span class="fd" style="font-size:28px;line-height:1.1">Call us now.</span>
			<a href={companyData.contact.phoneLink} class="row" style="gap:16px"><Ring name="phone" dark green /><span class="fd" style="font-size:30px;line-height:1">{companyData.contact.phone}</span></a>
			<span class="small">Mon to Fri 8:30 to 5, Sat 9 to 2</span>
		</div>
	</section>
	<section class="sec white stack" style="gap:40px">
		<div class="head"><Eyebrow>While you are here</Eyebrow><h2 class="h2 md">What else we do.</h2></div>
		<div class="grid3">{NEXT.map(([i, t, s, h]) => <a href={h} class="nx"><Ring name={i} fill /><h3 class="h3" style="font-size:20px;line-height:26px">{t}</h3><p class="body" style="font-size:15px;line-height:24px">{s}</p><span class="nlink">Learn more<Icon name="arrow" size={16} /></span></a>)}</div>
		<div class="row"><Btn href="/" kind="ghost">Back to the home page</Btn></div>
	</section>
</Layout>
<style>
	.thanks { display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: center; }
	.nx { display: flex; flex-direction: column; gap: 14px; padding: 28px; border: 1px solid var(--line); border-top: 4px solid var(--green); color: var(--ink); }
	.nlink { margin-top: auto; display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
	@media (max-width: 1100px) { .thanks { grid-template-columns: 1fr; gap: 32px; } .h1 { font-size: 40px !important; } }
</style>
