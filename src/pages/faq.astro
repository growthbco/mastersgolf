---
import Layout from '../layouts/Layout.astro';
import FAQSchema from '../components/FAQSchema.astro';
import companyData from '../data/company.json';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';

const repairFAQs = [
	{
		question: "When should I bring my golf cart in for repairs?",
		answer: "Bring your golf cart to Masters Golf Cars if you hear strange sounds, if it runs slower than normal, if the battery dies fast, or if the brakes feel off. We also suggest regular check-ups to catch small problems before they get big. Our shop on US-441 in Belleview is easy to find, right across from the Market of Marion."
	},
	{
		question: "What types of golf carts do you service?",
		answer: "Masters Golf Cars fixes all kinds of golf carts. We work on gas carts and electric carts. We service all the big brands like Club Car, EZ-GO, and Yamaha. If you have a golf cart, we can fix it!"
	},
	{
		question: "What types of golf cart battery problems do you repair?",
		answer: "We fix all battery problems at Masters Golf Cars. We can put in new batteries, fix chargers that don't work, and switch your cart to lithium-ion batteries. Lithium batteries last longer and charge faster. If your cart won't hold a charge, bring it to our Belleview shop."
	},
	{
		question: "Can you install custom accessories on my golf cart?",
		answer: "Yes! Masters Golf Cars can add cool extras to your cart. We put in new lights, lift kits, seat covers, dashboards, and more. Folks in The Villages, Ocala, and Gainesville love our custom work. Call us at (352) 307-0111 to talk about what you want."
	},
	{
		question: "How long do golf cart repairs typically take?",
		answer: "Most repairs at Masters Golf Cars are done in just 24 hours. That means you drop off your cart one day and get it back the next! If we need to order parts, we'll tell you right away how long it will take."
	},
	{
		question: "Do you offer pickup and delivery for repairs?",
		answer: "Yes! Masters Golf Cars picks up and drops off golf carts. We serve The Villages, Ocala, Belleview, Gainesville, and all of Marion County, Sumter County, Lake County, and Alachua County. You don't even have to leave your home!"
	}
];

const rentalFAQs = [
	{
		question: "What is the minimum age to rent a golf cart?",
		answer: "You must be 21 years old or older to rent a golf cart from Masters Golf Cars. This is our rule for all rentals."
	},
	{
		question: "Can I rent a golf cart for an event?",
		answer: "Yes! Masters Golf Cars rents golf carts for big events like festivals, weddings, rodeos, and concerts. We bring the carts to you and pick them up when you're done. We deliver up to 150 miles from our Belleview shop on US-441. That covers most of Central Florida!"
	},
	{
		question: "Do I need to pay a deposit?",
		answer: "You need a credit card to hold your rental, but we don't charge a separate deposit. Masters Golf Cars only charges your card based on what you agreed to in your rental deal."
	},
	{
		question: "Can I extend my rental period?",
		answer: "Yes! If you want to keep your golf cart longer, just call Masters Golf Cars. We'll check if the cart is free and add more days to your rental. Call us at (352) 307-0111 as soon as you know you need more time."
	},
	{
		question: "Do you offer delivery for golf cart rentals?",
		answer: "Yes! Masters Golf Cars delivers every rental for free. We bring carts to homes within 50 miles of Belleview. For events, we go up to 150 miles. That includes The Villages, Ocala, Gainesville, and lots of other towns in Central Florida."
	},
	{
		question: "What is the minimum rental period?",
		answer: "The shortest rental at Masters Golf Cars is 3 days. We also rent by the week or month, and those longer rentals cost less per day. Great for snowbirds visiting The Villages or folks who need a cart while theirs is being fixed!"
	}
];

const salesFAQs = [
	{
		question: "What brands of golf carts do you sell?",
		answer: "Masters Golf Cars sells new and used Club Car, Yamaha, and EZ-GO golf carts. Stop by our shop on US-441 in Belleview to see what we have. We're just 15 minutes from Ocala and about 20 minutes from The Villages."
	},
	{
		question: "Do you offer financing for golf cart purchases?",
		answer: "Yes! Masters Golf Cars helps you pay for your golf cart over time. We have financing plans to fit your budget. Call us at (352) 307-0111 or visit our Belleview store to learn more about payment options."
	},
	{
		question: "Can I trade in my old golf cart?",
		answer: "Yes! Bring your old golf cart to Masters Golf Cars. We'll give you money off your new cart for the trade-in. We also buy golf carts if you just want to sell. We buy Club Car, Yamaha, EZ-GO, and most other brands."
	},
	{
		question: "Do you sell street-legal golf carts?",
		answer: "Yes! Masters Golf Cars sells street-legal golf carts called LSVs (Low Speed Vehicles). These carts have headlights, taillights, turn signals, and mirrors. You can drive them on roads in The Villages, Ocala, Belleview, and other Florida towns where golf carts are allowed."
	}
];

const sellCartFAQs = [
	{
		question: "What information do you need about my cart?",
		answer: "Tell Masters Golf Cars the brand (like Club Car, Yamaha, or EZ-GO), the model, the year it was made, and how it looks and runs. Also tell us how many miles it has and if you added any extras. Photos really help us give you a fair price fast!"
	},
	{
		question: "How fast can I receive an offer?",
		answer: "Masters Golf Cars usually gets back to you within one day. If we need more info or pictures, we'll call or email you right away."
	},
	{
		question: "Do you pick up the golf cart?",
		answer: "Yes! Once you and Masters Golf Cars agree on a price, we can pick up the cart from your home. Or you can drop it off at our shop on US-441 in Belleview, across from the Market of Marion. Whatever works best for you!"
	},
	{
		question: "Can I sell multiple carts or a fleet?",
		answer: "Yes! Masters Golf Cars buys one cart or many carts. We buy from homes, businesses, resorts, and communities. Folks in The Villages, Ocala, and Marion County sell us fleets all the time. Fill out our form to get started."
	}
];

const generalFAQs = [
	{
		question: "Where is Masters Golf Cars located?",
		answer: "Masters Golf Cars is at 12885 S US Highway 441 in Belleview, Florida 34420. We're on US-441, right across from the Market of Marion. Our shop is about 15 minutes south of Ocala and 20 minutes from The Villages. Easy to find!"
	},
	{
		question: "What are your business hours?",
		answer: "Masters Golf Cars is open Monday through Friday from 8:30 AM to 5:00 PM. On Saturday, we're open from 9:00 AM to 2:00 PM. We are closed on Sundays."
	},
	{
		question: "What areas do you serve?",
		answer: "Masters Golf Cars serves The Villages, Ocala, Belleview, Gainesville, and many other towns in Central Florida. We cover Marion County, Sumter County, Lake County, and Alachua County. If you live nearby, we can help you!"
	},
	{
		question: "How long has Masters Golf Cars been in business?",
		answer: "Masters Golf Cars has been fixing, selling, and renting golf carts since 1999. That's over 25 years! Families in Marion County and The Villages have trusted us for a long time. We know golf carts inside and out."
	}
];

// Combine all FAQs for the schema
const allFAQs = [...generalFAQs, ...repairFAQs, ...rentalFAQs, ...salesFAQs, ...sellCartFAQs];

const groups = [['General', generalFAQs], ['Rentals', rentalFAQs], ['Service', repairFAQs], ['Sales', salesFAQs], ['Selling your cart', sellCartFAQs]] as const;
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "FAQ", url: "https://mastersgolfcars.com/faq" }
];
---

<Layout title="Frequently Asked Questions | Masters Golf Cars" description="Find answers to common questions about golf cart repairs, rentals, sales, and services at Masters Golf Cars in Belleview, FL. Serving The Villages, Ocala, and Central Florida since 1999." breadcrumbs={crumbs}>
	<FAQSchema faqs={allFAQs} />
	<section class="sec dark on-dark" style="padding-top:72px;padding-bottom:56px">
		<div class="head"><Eyebrow>Frequently asked questions</Eyebrow><h1 class="h1" style="font-size:64px">Straight answers.</h1><p class="lead">Rentals, service, lithium and sales. If you do not see your question, call {companyData.contact.phone} and a real person will answer.</p></div>
	</section>
	<section class="sec white stack" style="gap:0;padding-top:0;padding-bottom:24px">
		{groups.map(([name, items]) => (
			<div class="grp" id={name.toLowerCase().replace(/\s+/g, '-')}>
				<div class="stack" style="gap:12px"><Eyebrow>{name}</Eyebrow><h2 class="h2" style="font-size:36px">{name}</h2></div>
				<div class="stack">{items.map((f) => <details class="fq"><summary><h3 class="h3" style="font-size:18px;line-height:26px">{f.question}</h3><span class="plus" aria-hidden="true"></span></summary><p class="body">{f.answer}</p></details>)}</div>
			</div>
		))}
	</section>
	<section class="sec paper cta">
		<div class="head"><Eyebrow>Still have a question?</Eyebrow><h2 class="h2" style="font-size:44px">Call, text or send a note.</h2></div>
		<div class="row btn-row" style="gap:16px;flex-shrink:0"><Btn href={companyData.contact.phoneLink}>Call {companyData.contact.phone}</Btn><Btn href="/contact" kind="ghost">Contact us</Btn></div>
	</section>
</Layout>

<style>
	.grp { display: grid; grid-template-columns: 300px 1fr; gap: 64px; align-items: start; padding: 56px 0; border-bottom: 1px solid var(--line); }
	.fq { border-top: 1px solid var(--line); }
	.fq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 0; }
	.fq summary::-webkit-details-marker { display: none; }
	.plus { position: relative; flex-shrink: 0; width: 20px; height: 20px; }
	.plus::before, .plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 16px; height: 1.5px; background: var(--ink); transform: translate(-50%, -50%); }
	.plus::after { transform: translate(-50%, -50%) rotate(90deg); }
	.fq[open] .plus::after { transform: translate(-50%, -50%) rotate(0); }
	.fq p { padding: 0 44px 22px 0; }
	.cta { display: flex; align-items: center; justify-content: space-between; gap: 48px; }
	@media (max-width: 1100px) { .grp { grid-template-columns: 1fr; gap: 24px; padding: 40px 0; } .cta { flex-direction: column; align-items: flex-start; } }
	@media (max-width: 760px) { .h1 { font-size: 40px !important; } .cta .h2 { font-size: 32px !important; } }
</style>
