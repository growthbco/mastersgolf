---
import Layout from '../layouts/Layout.astro';
import FAQSchema from '../components/FAQSchema.astro';
import Schema from '../components/Schema.astro';
import ServicePage from '../components/sections/ServicePage.astro';

const repairServiceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	"@id": "https://mastersgolfcars.com/golf-cart-repairs/#service",
	"name": "Golf Cart Repair Services",
	"description": "Professional golf cart repair services including gas and electric cart maintenance, battery replacement, lithium-ion conversions, and 24-hour turnaround on most repairs in The Villages, Ocala, and Central Florida.",
	"provider": {
		"@type": "LocalBusiness",
		"name": "Masters Golf Cars, LLC",
		"url": "https://mastersgolfcars.com",
		"telephone": "+1-352-307-0111",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "12885 S US Hwy 441",
			"addressLocality": "Belleview",
			"addressRegion": "FL",
			"postalCode": "34420",
			"addressCountry": "US"
		},
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": "5",
			"bestRating": "5",
			"worstRating": "1",
			"reviewCount": "150"
		}
	},
	"serviceType": "Golf Cart Repair",
	"areaServed": [
		{
			"@type": "City",
			"name": "The Villages",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Ocala",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Belleview",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		}
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Repair Services",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Gas Golf Cart Repairs",
					"description": "Engine maintenance, oil replacement, fuel system repairs, exhaust system repairs, and transmission maintenance"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Electric Golf Cart Repairs",
					"description": "Battery maintenance and replacement, charging system service, motor and controller maintenance, electrical system troubleshooting"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Lithium-Ion Battery Conversions",
					"description": "Upgrade to lithium power systems with Eco Battery and Trojan OnePack installations"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Pickup & Delivery",
					"description": "Convenient pickup and delivery service for golf cart repairs"
				}
			}
		]
	},
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Robert McIntyre"
			},
			"datePublished": "2024-10-28",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Excellent company, fast service, prices fair. I had the annual service and also replaced worn out bearings and hubs. Picked the cart up yesterday and returned it today. Runs great without the grinding noise. Very pleased with the communications about the estimate."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Jay DeFalco"
			},
			"datePublished": "2024-08-12",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "They have been repairing our fleet of carts for over 15 years. Nothing but professional and extremely speedy service at an affordable price! That's all a customer asks for. Not to mention that they will pick up your cart and then bring it all the way back to you, doesn't get any better than that."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Organization",
				"name": "West Shore Outfitters"
			},
			"datePublished": "2024-06-05",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "They will bend over backwards to earn your business and the service side of things is nothing less than professional and timely."
		}
	]
};

// Breadcrumbs for repairs page
const repairsBreadcrumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Repairs", url: "https://mastersgolfcars.com/golf-cart-repairs" }
];

const repairFAQs = [
	{ question: "When should I bring my golf cart in for repairs?", answer: "As soon as you notice something new: a noise, a slow start, a battery that will not hold a charge, brakes that feel off. Early repairs are cheaper repairs. Our shop on US-441 in Belleview is right across from the Market of Marion." },
	{ question: "What types of golf carts do you service?", answer: "All major gas and electric carts, including Club Car, E-Z-GO and Yamaha." },
	{ question: "Do you pick up?", answer: "Yes. Our driver can collect your cart and bring it back when the work is done. Ask when you schedule." },
	{ question: "How long will it take?", answer: "Most repairs are finished within 24 hours of your approval. Your estimate will tell you if yours needs longer." },
	{ question: "What types of golf cart battery problems do you repair?", answer: "All of them. New batteries, chargers that do not work, and lithium conversions with Bolt Energy packs that last longer and charge faster." },
	{ question: "Can you install custom accessories on my golf cart?", answer: "Yes. Lights, lift kits, seats, dashboards and more. Call (352) 307-0111 to talk about what you want." },
];
---

<Layout title="Golf Cart Repairs - Masters Golf Cars" description="Fast, reliable golf cart repairs in The Villages and Ocala. 24-hour turnaround on most repairs." breadcrumbs={repairsBreadcrumbs} quoteHref="#schedule">
	<Schema schema={repairServiceSchema} slot="schema" />
	<FAQSchema faqs={repairFAQs} />
	<ServicePage pageSource="golf-cart-repairs" faqs={repairFAQs} />
</Layout>
