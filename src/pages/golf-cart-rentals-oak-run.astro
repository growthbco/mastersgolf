---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-oak-run.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - Oak Run Golf Cart Rentals",
	"description": "Golf cart rentals for Oak Run residents in Ocala, FL. Delivery to all Oak Run neighborhoods including Royal Oaks and Eagle's Point.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-oak-run",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Oak Run",
		"Royal Oaks",
		"Eagle's Point",
		"SW Ocala",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "How fast can you deliver to Oak Run?",
  "answer": "Often the same or next day when carts are available. Book ahead for holidays and busy event weeks."
 },
 {
  "question": "Is there a delivery fee?",
  "answer": "Delivery is quoted with your reservation based on your address. Call (352) 307-0111 for a quick number."
 },
 {
  "question": "Is there a minimum rental?",
  "answer": "Yes, 3 days. After that, rent by the week, the month or the season."
 },
 {
  "question": "How old do I have to be?",
  "answer": "Renters must be 21 or older with a valid driver license."
 },
 {
  "question": "Can I extend?",
  "answer": "Yes. Call us before your end date and we will extend it if the cart is available."
 }
];

const LEAD = ["Masters Golf Cars provides convenient golf cart rentals for Oak Run residents in Ocala. Whether your personal cart is being serviced, you have guests visiting, or you want to try before buying, we deliver premium rentals directly to your Oak Run home.", "Located nearby at 12885 S US Highway 441 in Belleview, we've served Oak Run residents since 1999. Our carts are perfect for accessing the Oak Run Country Club, Island Club, pools, and all community amenities."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals for Oak Run", url: "https://mastersgolfcars.com/golf-cart-rentals-oak-run" }
];
---

<Layout title="Golf Cart Rentals for Oak Run | Ocala, FL" description="Golf cart rentals for Oak Run residents in Ocala. Delivery to all Oak Run neighborhoods. Convenient service since 1999. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-oak-run" breadcrumbs={crumbs} quoteHref="#reserve">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="community" name="Oak Run" slug="golf-cart-rentals-oak-run" eyebrow="Golf cart rentals for Oak Run, Ocala" heading="Golf cart rentals," accent="delivered to Oak Run." lead={LEAD} img={R + 'cart-2p.jpg'} imgLabel="Oak Run and the SW 27th corridor" proof={[["pin", "14 miles away", "About 20 minutes from our shop"], ["truck", "Delivered to your door", "Any Oak Run neighborhood"], ["key", "300+ carts", "Availability most weeks"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultLocation="Oak Run, FL" />
</Layout>
