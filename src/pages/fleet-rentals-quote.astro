---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';
import FleetQuoteForm from '../components/forms/FleetQuoteForm.astro';
import FormShell from '../components/forms/FormShell.astro';
import HeroDark from '../components/sections/HeroDark.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import Steps from '../components/sections/Steps.astro';
import Reviews from '../components/sections/Reviews.astro';
import CartCard from '../components/sections/CartCard.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Check from '../components/ui/Check.astro';
import Icon from '../components/ui/Icon.astro';
import { EVENTS, R } from '../lib/areas';

const fleetRentalsSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	"@id": "https://mastersgolfcars.com/fleet-rentals-quote/#service",
	"name": "Golf Cart Fleet Rentals",
	"description": "Golf cart fleet rentals for events across Central Florida. Over 300 late-model, gas-powered carts available for weddings, festivals, concerts, equestrian events, and corporate gatherings.",
	"provider": {
		"@type": "AutoDealer",
		"name": "Masters Golf Cars, LLC",
		"url": "https://mastersgolfcars.com",
		"telephone": "+1-352-307-0111",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "12885 S US Hwy 441",
			"addressLocality": "Belleview",
			"addressRegion": "FL",
			"postalCode": "34420",
			"addressCountry": "US"
		}
	},
	"serviceType": "Golf Cart Fleet Rental",
	"areaServed": [
		{
			"@type": "State",
			"name": "Florida"
		}
	]
};
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Fleet Rentals Quote", url: "https://mastersgolfcars.com/fleet-rentals-quote" }
];
const GAL = [
	{ img: 'fleet-aerial-sky.jpg', alt: 'Aerial view of the rental fleet', pos: '50% 60%', tall: true },
	{ img: 'clubcar-row.jpg', alt: 'Row of white Club Car carts', pos: '50% 50%' },
	{ img: 'yamaha-aisle.jpg', alt: 'Aisle between rows of Yamaha carts', pos: '50% 50%' },
	{ img: 'clubcar-utility-row.jpg', alt: 'Row of utility carts', pos: '50% 60%' },
	{ img: 'delivery.jpg', alt: 'Masters trucks hauling trailers of carts', pos: '50% 88%' },
];
---

<Layout title="Fleet Rentals Quote - Masters Golf Cars" description="Request a customized quote for Masters Golf Cars fleet rentals. Choose from 2, 4, 6 passenger, and utility carts for events across Central Florida." breadcrumbs={crumbs} quoteHref="#fleetquote">
	<Schema schema={fleetRentalsSchema} slot="schema" />

	<HeroDark eyebrow="Fleet and event rentals, throughout Florida" heading="Big events require" accent="big fleets." lead="Over 300 carts, delivered, staged and picked up by a team that has done it for 25 years. From a few carts to a full-scale event fleet, we are ready." cta="Request a fleet quote" ctaHref="#fleetquote" img={R + 'fleet-aerial-road.jpg'} alt="Aerial view of the Masters rental fleet" video={R + 'sweep.mp4'} />
	<ProofBar items={[['key', '300+ carts', 'Late model gas carts'], ['truck', 'Delivered and staged', 'Anywhere in Florida'], ['award', 'Since 1999', 'Experienced event management'], ['calendar', 'Daily, weekly, monthly', 'Event and seasonal rates']]} />

	<section class="sec white diff">
		<div class="head"><Eyebrow>The Masters difference</Eyebrow><h2 class="h2">Experience matters. Trust Masters to drive your event <span class="g">forward.</span></h2><p class="lead" style="max-width:520px">Reliable carts. Professional delivery. Experienced event management.</p></div>
		<div class="stack" style="gap:28px">
			<p class="body" style="font-size:17px;line-height:28px">Masters Golf Cars is the source in Ocala, The Villages, Central Florida and the Southeast for golf cart fleet rentals. We keep a rental fleet of over 300 carts for large events and can supply carts anywhere in the Southeast.</p>
			<p class="body" style="font-size:17px;line-height:28px">All fleet rentals are late model, gas powered carts in 2 passenger, 4 passenger, 6 passenger and utility. Daily, weekly and monthly rates, with discounted large event and seasonal lease rates. 3 day minimum.</p>
			<div class="check-list" style="gap:14px 24px">{['Delivered on time, every time', 'Staged where you need them', 'Fuel, keys and a contact number', 'Picked up when the event ends'].map((t) => <Check>{t}</Check>)}</div>
		</div>
	</section>

	<section class="sec paper stack" style="gap:48px">
		<div class="head"><Eyebrow>Events we roll with</Eyebrow><h2 class="h2">If it happens in Florida, we have carts there.</h2><p class="lead">Equestrian events, tournaments, festivals, corporate events, gun clubs, dog shows, air shows, sporting events, holidays and special events.</p></div>
		<div class="ev-list">{EVENTS.map((e) => <div class="ev"><Icon name="check" size={18} sw={2} color="#2f6b0c" /><span>{e}</span></div>)}</div>
	</section>

	<section class="sec white stack" style="gap:48px">
		<div class="head"><Eyebrow>The fleet</Eyebrow><h2 class="h2">Four types. Any quantity.</h2></div>
		<div class="grid4 cards">
			<CartCard href="#fleetquote" img={R + 'cart-2p.jpg'} alt="Two passenger rental golf cart" title="2 passenger" sub="Staff, vendors and quick runs." price="Quoted per event" />
			<CartCard href="#fleetquote" img={R + 'cart-4p.jpg'} alt="Four passenger rental golf cart" title="4 passenger" sub="Our most requested event cart." price="Quoted per event" badge="Most requested" />
			<CartCard href="#fleetquote" img={R + 'cart-6p.jpg'} alt="Six passenger rental golf cart" title="6 passenger shuttle" sub="Guest shuttles and VIP groups." price="Quoted per event" />
			<CartCard href="#fleetquote" img={R + 'carryall.jpg'} alt="Club Car Carryall utility cart" title="Utility cart" sub="Hauls gear, feed and supplies." price="Quoted per event" contain />
		</div>
	</section>

	<Steps eyebrow="How it works" heading="From quote to pickup." lead="One contact from the first call to the last cart on the trailer." items={[['1', 'tag', 'Tell us about the event', 'Dates, venue, how many carts and what they are for.'], ['2', 'calendar', 'We confirm and schedule', 'A written quote, then delivery and pickup windows that fit your setup.'], ['3', 'truck', 'Delivered and staged', 'Fueled, keyed and parked where you want them.'], ['4', 'check', 'We pick them up', 'When the event ends, our trucks come get them.']]} cta="Request a fleet quote" ctaHref="#fleetquote" />

	<section class="sec paper stack" style="gap:48px">
		<div class="head"><Eyebrow>On the ground</Eyebrow><h2 class="h2 md">The fleet, ready to roll.</h2></div>
		<div class="gal">{GAL.map((g) => <div class:list={['gph', { tall: g.tall }]}><img src={R + g.img} alt={g.alt} loading="lazy" width="640" height="300" style={`object-position:${g.pos}`} /></div>)}</div>
	</section>

	<Reviews heading="Trusted at Florida's biggest events." />

	<FormShell id="fleetquote" eyebrow="Fleet quote" heading="Let us get your event" accent="moving." lead="Tell us about the event and our rental manager will check availability and get back to you with a quote as soon as possible during business hours.">
		<FleetQuoteForm pageSource="fleet-rentals-quote" idPrefix="fleet" />
	</FormShell>
</Layout>

<style>
	.diff { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; align-items: center; }
	.ev-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; border-top: 1px solid var(--line); }
	.ev { display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 15px; font-weight: 500; color: var(--ink); }
	.gal { display: grid; grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: 300px 300px; gap: 16px; }
	.gph { overflow: hidden; background: var(--black); }
	.gph.tall { grid-row: 1 / 3; }
	.gph img { display: block; width: 100%; height: 100%; object-fit: cover; }
	@media (max-width: 1100px) { .diff { grid-template-columns: 1fr; gap: 40px; } .ev-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } .gal { grid-template-columns: 1fr 1fr; grid-template-rows: 240px 240px 240px; } .gph.tall { grid-row: auto; grid-column: 1 / -1; } }
	@media (max-width: 760px) { .ev-list { grid-template-columns: 1fr; } .cards { grid-template-columns: 1fr; } .gal { grid-template-columns: 1fr; grid-template-rows: none; } .gph { height: 200px; } }
</style>
