---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-wec.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - World Equestrian Center Golf Cart Rentals",
	"description": "Golf cart rentals for World Equestrian Center events in Ocala, FL. Fleet rentals for horse shows, exhibitors, trainers, and spectators at WEC.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-wec",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"World Equestrian Center",
		"WEC Ocala",
		"Grand Arena",
		"Equestrian Hotel",
		"Marion County",
		"Ocala Horse Country"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "How many carts can you supply?",
  "answer": "Over 300 in the fleet, in 2, 4, 6 passenger and utility. Tell us the size of the event and we will build the mix."
 },
 {
  "question": "How far in advance should I book?",
  "answer": "As early as you can for busy months. A few weeks is usually fine, but big weekends and show weeks fill up."
 },
 {
  "question": "Do you deliver and pick up at the venue?",
  "answer": "Yes. We deliver, stage the carts where you want them, and pick them up when the event ends."
 },
 {
  "question": "Do the carts come fueled?",
  "answer": "Yes. Every cart arrives fueled and keyed, with a contact number in case anything comes up."
 },
 {
  "question": "What are the rates?",
  "answer": "Daily, weekly and event rates, quoted per event. Fill out the form or call (352) 307-0111."
 }
];

const LEAD = ["Need a golf cart for World Equestrian Center in Ocala? Masters Golf Cars has you covered. We rent golf carts to people who compete, watch, or work at WEC horse shows.", "We have been helping horse people in Marion County for over 26 years. Our shop sits on US-441 in Belleview, about 15 minutes south of WEC. With more than 300 golf carts ready to go, we can handle events big or small."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals at World Equestrian Center (WEC) Ocala", url: "https://mastersgolfcars.com/golf-cart-rentals-wec" }
];
---

<Layout title="Golf Cart Rentals at World Equestrian Center (WEC) Ocala | Masters Golf Cars" description="Rent golf carts for World Equestrian Center events in Ocala, FL. Fleet rentals for horse shows, equestrian events. Delivery to WEC grounds. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-wec" breadcrumbs={crumbs} quoteHref="#fleetquote">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="venue" name="World Equestrian Center" slug="golf-cart-rentals-wec" eyebrow="Golf cart rentals at World Equestrian Center, Ocala" heading="Show week carts," accent="staged at WEC." lead={LEAD} img={R + 'fleet-aerial-road.jpg'} imgLabel="Delivered and staged at the barns" proof={[["flag", "WEC regulars", "Staged there every show season"], ["truck", "Delivered and staged", "Barn to ring to parking"], ["key", "300+ carts", "Any quantity, any week"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultEventType="World Equestrian Center (WEC)" />
</Layout>
