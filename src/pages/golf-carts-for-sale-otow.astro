---
import Layout from '../layouts/Layout.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';
import servicesData from '../data/services.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - On Top of The World Golf Carts for Sale",
	"description": "New and used golf carts for sale for On Top of The World (OTOW) residents in Ocala, FL. Serving Circle Square Commons, The Town Square, Recreation Center, and all OTOW neighborhoods.",
	"url": "https://mastersgolfcars.com/golf-carts-for-sale-otow",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"On Top of The World",
		"OTOW",
		"Circle Square Commons",
		"The Town Square",
		"Candler Hills",
		"Indigo East",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
---

<Layout
	title="Golf Carts for Sale in On Top of The World (OTOW) | Masters Golf Cars"
	description="Buy golf carts in On Top of The World, Ocala FL. New & used golf carts for OTOW residents. Sales, service, rentals. Financing available. 26+ years experience. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-carts-for-sale-otow"
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Golf Carts for Sale in On Top of The World</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Live in <strong>On Top of The World</strong>? Need a golf cart? <strong>Masters Golf Cars</strong> has been helping OTOW folks since 1999. We sell new and used carts that work great in your community.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						Our shop is at <strong>12885 S US Highway 441</strong> in Belleview. Take <strong>SR-200</strong> east and you will find us in about 15 minutes. We sell <strong>Club Car</strong>, <strong>Yamaha</strong>, and <strong>EZ-GO</strong>. We also fix carts and rent them.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/golf-cart-inventory" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							View Inventory
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/golf-cart-rentals-page/club-car_img_v68_250813_154125925.webp" alt="Golf carts for sale for On Top of The World residents" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Why Buy From Us -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why OTOW Folks Buy From Masters Golf Cars</h2>
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-6">
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">We Know OTOW</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							<strong>On Top of The World</strong> is a big place. Over 10,000 homes. Miles of paths. Golf courses. The <strong>Recreation Center</strong>. <strong>Circle Square Commons</strong>. <strong>The Town Square</strong>. We know you need a cart that can handle it all. We have been selling to OTOW for 26 years.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Carts Made for Your Lifestyle</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Golf carts are not just for golf here. People use them to go to the pool, the gym, shops, and to see friends. OTOW has paths all over. A cart saves you time. It is fun too. We help you find the right one.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Close to You</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							From OTOW, take <strong>SW 80th Street</strong> to <strong>SR-200 East</strong>. Then go south on <strong>US-441</strong>. We are on the right, across from the <strong>Market of Marion</strong>. The whole drive takes about 15 minutes.
						</p>
					</div>
				</div>
				<div>
					<div class="bg-white rounded-lg p-8 shadow-lg mb-6">
						<h3 class="text-xl font-bold text-gray-900 mb-4">Places You Can Go by Cart in OTOW</h3>
						<ul class="space-y-2 text-gray-700 font-semibold mb-6">
							<li>&#10003; The Town Square</li>
							<li>&#10003; Circle Square Commons</li>
							<li>&#10003; Recreation Center</li>
							<li>&#10003; The Candler Hills Golf Course</li>
							<li>&#10003; Fitness Centers</li>
							<li>&#10003; Pools</li>
							<li>&#10003; Shops and Restaurants</li>
							<li>&#10003; Dog Parks</li>
							<li>&#10003; Walking Trails</li>
						</ul>
					</div>
					<div class="bg-brand-green text-white rounded-lg p-8">
						<h3 class="text-xl font-bold mb-4">We Offer Financing</h3>
						<p class="mb-4 font-semibold">
							Do not want to pay all at once? We work with <strong>Sheffield Financial</strong>. You can pay month by month. Low payments. Easy to apply.
						</p>
						<a href="https://prequalify.sheffieldfinancial.com/Apply/Landing?source=web&dealer=57070" target="_blank" rel="noopener noreferrer" class="inline-block bg-black text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-900 transition">
							Apply for Financing
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Brands We Carry -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Top Golf Cart Brands for OTOW</h2>
			<p class="text-lg text-gray-700 text-center mb-10 font-semibold max-w-3xl mx-auto">
				We sell the best names in golf carts. Each brand works great for life in <strong>On Top of The World</strong>. Come see them at our shop.
			</p>
			<div class="grid md:grid-cols-2 grid-cols-3 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'Club Car')?.icon || '/images/logos/club-car-icon-0-0.webp'} alt="Club Car golf carts for OTOW" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">Club Car</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Comfy and strong. Many OTOW folks pick <strong>Club Car</strong>. Works great for daily trips around the community.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'Yamaha')?.icon || '/images/logos/yamaha-icon-0-1.webp'} alt="Yamaha golf carts for OTOW" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">Yamaha</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Good battery range. Smooth ride. <strong>Yamaha</strong> carts get you from one end of OTOW to the other with no trouble.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'EZ-GO')?.icon || '/images/logos/ez-go-icon-0-2.webp'} alt="EZ-GO golf carts for OTOW" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">EZ-GO</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Good price. Runs well for years. Lots of OTOW folks drive an <strong>EZ-GO</strong>. Hard to beat the value.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- New vs Used -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">New or Used - Your Choice</h2>
			<div class="grid md:grid-cols-2 gap-12">
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">New Golf Carts</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Want a cart with zero miles? We have new ones from the top brands. They come with full warranties. You can pick colors and options.
					</p>
					<ul class="space-y-3 text-gray-700 font-semibold mb-6">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Full warranty from the maker</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Newest features</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Pick your colors</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Financing ready</span>
						</li>
					</ul>
					<a href="/golf-cart-inventory?condition=new" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
						View New Inventory
					</a>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">Used Golf Carts</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Good carts do not have to be new. We have used ones that run great. Many come from right here in <strong>Marion County</strong>. We check them out before we sell them.
					</p>
					<ul class="space-y-3 text-gray-700 font-semibold mb-6">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>We check and fix them first</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Save money</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Trade in your old cart</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Financing on used too</span>
						</li>
					</ul>
					<a href="/golf-cart-inventory?condition=used" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
						View Used Inventory
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Services for OTOW -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">All Your Golf Cart Needs - One Place</h2>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
					<h3 class="text-2xl font-bold text-gray-900 mb-4">Sales</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Buy new or used. We have lots to pick from. We help OTOW folks find what they need.
					</p>
					<ul class="space-y-2 text-gray-700 font-semibold text-sm mb-6">
						<li>&#8226; Club Car, Yamaha, and EZ-GO</li>
						<li>&#8226; New and pre-owned</li>
						<li>&#8226; Financing ready</li>
						<li>&#8226; Trade-ins welcome</li>
					</ul>
					<a href="/golf-cart-inventory" class="text-brand-green font-bold hover:underline">View Inventory</a>
				</div>
				<div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
					<h3 class="text-2xl font-bold text-gray-900 mb-4">Service and Repairs</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Cart not running right? Bring it in. We fix all brands. Fast work. Fair prices.
					</p>
					<ul class="space-y-2 text-gray-700 font-semibold text-sm mb-6">
						<li>&#8226; Tune-ups</li>
						<li>&#8226; Battery work</li>
						<li>&#8226; Brakes</li>
						<li>&#8226; Electrical fixes</li>
					</ul>
					<a href="/schedule-golf-cart-service" class="text-brand-green font-bold hover:underline">Schedule Service</a>
				</div>
				<div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
					<h3 class="text-2xl font-bold text-gray-900 mb-4">Rentals</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Cart in the shop? Have guests in town? Rent one from us. We can bring it to you.
					</p>
					<ul class="space-y-2 text-gray-700 font-semibold text-sm mb-6">
						<li>&#8226; Daily or weekly</li>
						<li>&#8226; Month-long too</li>
						<li>&#8226; Delivery to OTOW</li>
						<li>&#8226; 2, 4, or 6 seats</li>
					</ul>
					<a href="/rent-a-golf-cart" class="text-brand-green font-bold hover:underline">Request Rental</a>
				</div>
			</div>
		</div>
	</section>

	<!-- About OTOW -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div>
					<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-6">About On Top of The World</h2>
					<p class="text-gray-700 leading-relaxed font-semibold mb-4">
						<strong>On Top of The World</strong> is one of the biggest 55+ spots in Florida. It sits in <strong>Marion County</strong> near <strong>Ocala</strong>. Over 10,000 homes. Three golf courses. Pools. Gyms. Clubs for every hobby you can think of.
					</p>
					<p class="text-gray-700 leading-relaxed font-semibold mb-4">
						<strong>Circle Square Commons</strong> has shops, a movie theater, and places to eat. <strong>The Town Square</strong> has live music most weekends. People love it here. And most of them get around by golf cart.
					</p>
					<p class="text-gray-700 leading-relaxed font-semibold mb-6">
						Paths connect the whole place. Go from your house to the pool. Visit friends in other neighborhoods. Head to dinner. A golf cart makes it all easy and fun.
					</p>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<p class="text-3xl font-bold text-brand-green mb-1">10,000+</p>
							<p class="text-gray-700 font-semibold text-sm">Homes</p>
						</div>
						<div>
							<p class="text-3xl font-bold text-brand-green mb-1">3</p>
							<p class="text-gray-700 font-semibold text-sm">Golf Courses</p>
						</div>
						<div>
							<p class="text-3xl font-bold text-brand-green mb-1">55+</p>
							<p class="text-gray-700 font-semibold text-sm">Community</p>
						</div>
						<div>
							<p class="text-3xl font-bold text-brand-green mb-1">100+</p>
							<p class="text-gray-700 font-semibold text-sm">Clubs</p>
						</div>
					</div>
				</div>
				<div>
					<img src="/images/gallery/02-04-2025-14-28-46_34.webp" alt="Golf cart lifestyle at On Top of The World" class="w-full h-auto rounded-lg shadow-lg mb-6" loading="lazy" width="800" height="600" />
					<img src="/images/gallery/02-04-2025-14-26-11_29.webp" alt="Golf cart in active adult community" class="w-full h-auto rounded-lg shadow-lg" loading="lazy" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Testimonials -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h3 class="text-3xl font-black text-gray-900 text-center mb-4">What OTOW Folks Say</h3>
			<div class="flex justify-center gap-1 mb-12">
				{Array.from({ length: 5 }).map((_star, index) => (
					<svg class="w-6 h-6" fill="#FFD700" viewBox="0 0 20 20">
						<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
					</svg>
				))}
			</div>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-gray-50 rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"Got my EZ-GO from Masters. They knew just what I needed for OTOW. Good service. Fair price. I drive it to Circle Square all the time!"
					</p>
					<p class="font-black text-gray-900">-Barbara S., On Top of The World</p>
				</div>
				<div class="bg-gray-50 rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"They fixed my cart quick. I live in OTOW and I need my cart every day. Masters got me back on the road fast. Great team."
					</p>
					<p class="font-black text-gray-900">-Richard M., On Top of The World</p>
				</div>
				<div class="bg-gray-50 rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"Traded in my old cart for a new Club Car. Easy deal. Good trade value. Now I ride in style to The Town Square every weekend."
					</p>
					<p class="font-black text-gray-900">-Carol T., On Top of The World</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Related Services Section -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Ways We Help OTOW</h2>
				<div class="grid md:grid-cols-2 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Need a cart for a while? We rent them. We can bring it right to OTOW.
						</p>
						<a href="/golf-cart-rentals-ocala" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn About Rentals
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Repairs</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Something wrong with your cart? We fix <strong>Club Car</strong>, <strong>Yamaha</strong>, <strong>EZ-GO</strong>, and more.
						</p>
						<a href="/golf-cart-repairs-ocala" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn About Repairs
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Other Locations -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">We Serve Other Areas Too</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Ocala</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf carts for all of <strong>Marion County</strong>. New and used.
						</p>
						<a href="/golf-carts-for-sale-ocala" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">The Villages</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Carts for <strong>The Villages</strong> in <strong>Sumter County</strong>. Stop by and see us.
						</p>
						<a href="/golf-carts-for-sale-the-villages" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Spruce Creek</h3>
						<p class="text-gray-700 font-semibold mb-4">
