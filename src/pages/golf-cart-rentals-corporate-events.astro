---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-corporate-events.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - Corporate Event Golf Cart Rentals",
	"description": "Golf cart rentals for corporate events, conferences, and retreats in Central Florida. Fleet rentals available for Ocala, The Villages, and Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-corporate-events",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Marion County",
		"Sumter County",
		"Lake County",
		"Alachua County",
		"Ocala",
		"The Villages"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "How many carts can you supply?",
  "answer": "Over 300 in the fleet, in 2, 4, 6 passenger and utility. Tell us the size of the event and we will build the mix."
 },
 {
  "question": "How far in advance should I book?",
  "answer": "As early as you can for busy months. A few weeks is usually fine, but big weekends and show weeks fill up."
 },
 {
  "question": "Do you deliver and pick up at the venue?",
  "answer": "Yes. We deliver, stage the carts where you want them, and pick them up when the event ends."
 },
 {
  "question": "Do the carts come fueled?",
  "answer": "Yes. Every cart arrives fueled and keyed, with a contact number in case anything comes up."
 },
 {
  "question": "What are the rates?",
  "answer": "Daily, weekly and event rates, quoted per event. Fill out the form or call (352) 307-0111."
 }
];

const LEAD = ["Elevate your corporate event with professional golf cart rentals from Masters Golf Cars. Since 1999, we've provided fleet rentals for company retreats at Mission Inn Resort, conferences at World Equestrian Center, golf tournaments at Golden Ocala, and corporate gatherings throughout Central Florida.", "From small executive outings to large-scale corporate events requiring 20+ carts, we have the fleet and expertise to ensure your event runs smoothly. Our team coordinates delivery, setup, and pickup around your event schedule."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Corporate Event Golf Cart Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals-corporate-events" }
];
---

<Layout title="Corporate Event Golf Cart Rentals | Fleet Rentals in Central Florida" description="Golf cart fleet rentals for corporate events, conferences, and retreats. Serving Ocala, The Villages, Marion County. Professional service since 1999. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-corporate-events" breadcrumbs={crumbs} quoteHref="#fleetquote">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="event" name="corporate events" slug="golf-cart-rentals-corporate-events" eyebrow="Corporate event golf cart rentals" heading="Move your people" accent="professionally." lead={LEAD} img={R + 'cart-4p.jpg'} imgLabel="Conferences, retreats, grand openings and company days" proof={[["users", "Guest and staff carts", "2, 4 and 6 passenger"], ["truck", "Delivered and staged", "Set before your guests arrive"], ["shield", "One point of contact", "From quote to pickup"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultEventType="Corporate event" faqTitle="Corporate event questions." />
</Layout>
