---
import Layout from '../layouts/Layout.astro';
import FleetQuoteForm from '../components/forms/FleetQuoteForm.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - Corporate Event Golf Cart Rentals",
	"description": "Golf cart rentals for corporate events, conferences, and retreats in Central Florida. Fleet rentals available for Ocala, The Villages, and Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-corporate-events",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Marion County",
		"Sumter County",
		"Lake County",
		"Alachua County",
		"Ocala",
		"The Villages"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
---

<Layout
	title="Corporate Event Golf Cart Rentals | Fleet Rentals in Central Florida"
	description="Golf cart fleet rentals for corporate events, conferences, and retreats. Serving Ocala, The Villages, Marion County. Professional service since 1999. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-cart-rentals-corporate-events"
	breadcrumbs={[
		{ name: "Home", url: "https://mastersgolfcars.com" },
		{ name: "Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals" },
		{ name: "Corporate Events", url: "https://mastersgolfcars.com/golf-cart-rentals-corporate-events" }
	]}
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Corporate Event Golf Cart Rentals</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Elevate your corporate event with professional golf cart rentals from Masters Golf Cars. Since 1999, we've provided fleet rentals for company retreats at <strong>Mission Inn Resort</strong>, conferences at <strong>World Equestrian Center</strong>, golf tournaments at <strong>Golden Ocala</strong>, and corporate gatherings throughout Central Florida.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						From small executive outings to large-scale corporate events requiring 20+ carts, we have the fleet and expertise to ensure your event runs smoothly. Our team coordinates delivery, setup, and pickup around your event schedule.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/fleet-rentals-quote" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							Request Fleet Quote
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" alt="Corporate event golf cart fleet rental" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Corporate Event Types -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Corporate Events We Serve</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Company Retreats</h3>
					<p class="text-gray-700 font-semibold">
						Golf cart transportation for corporate retreats at resorts like <strong>Mission Inn Resort</strong>, <strong>The Grand Oaks Resort</strong>, and <strong>World Equestrian Center's Equestrian Hotel</strong>. Perfect for team-building activities and executive gatherings.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Tournaments</h3>
					<p class="text-gray-700 font-semibold">
						Fleet rentals for corporate golf tournaments at courses including <strong>Golden Ocala Golf Club</strong>, <strong>Juliette Falls</strong>, <strong>Stone Creek Golf Club</strong>, and <strong>The Villages Executive Golf Courses</strong>.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Trade Shows & Conferences</h3>
					<p class="text-gray-700 font-semibold">
						VIP transportation and staff mobility at <strong>World Equestrian Center</strong> trade shows, <strong>Southeastern Livestock Pavilion</strong> events, and conferences at Ocala's hotels and convention facilities.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Product Launches</h3>
					<p class="text-gray-700 font-semibold">
						Golf carts for outdoor product launches and demonstrations. Perfect for automotive reveals, equipment demos, and experiential marketing events at venues throughout Marion and Sumter counties.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Employee Appreciation Events</h3>
					<p class="text-gray-700 font-semibold">
						Team outings and company picnics at <strong>Silver Springs State Park</strong>, <strong>Carney Island Recreation Area</strong>, and other Central Florida outdoor venues.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Hospitality & Entertainment</h3>
					<p class="text-gray-700 font-semibold">
						Client entertainment and hospitality events. Transport guests at equestrian competitions, wine tastings at <strong>Lakeridge Winery</strong>, or exclusive gatherings at private estates.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Fleet Options -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">Corporate Fleet Options</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" alt="2-passenger executive golf cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Executive Carts</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						2-passenger carts for executives and VIP guests. Perfect for golf outings and personal transportation.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/4-seater-golf-cart_img_v64_250813_142836603.webp" alt="4-passenger team golf cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Team Carts</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						4-passenger carts ideal for team activities, golf tournaments, and small group transportation.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" alt="6-passenger shuttle cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Shuttle Carts</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						6-passenger carts for group shuttle service, venue navigation, and large event transportation.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/utility-cart_img_v66_250813_142912878.webp" alt="Utility cart for event operations" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Operations Carts</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Utility carts with cargo beds for event staff, setup crews, catering, and logistics support.
					</p>
				</div>
			</div>
			<div class="mt-12 bg-gray-50 rounded-lg p-8 text-center">
				<h3 class="text-2xl font-bold text-gray-900 mb-4">Custom Fleet Configurations</h3>
				<p class="text-gray-700 font-semibold mb-4 max-w-3xl mx-auto">
					Need a specific mix of cart types? We'll work with you to create the perfect fleet configuration for your corporate event. From 5 carts to 50+, we have the inventory and expertise to deliver.
				</p>
				<a href="/fleet-rentals-quote" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
					Request Custom Fleet Quote
				</a>
			</div>
		</div>
	</section>

	<!-- Popular Venues -->
	<section class="py-16 bg-brand-green text-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">Popular Corporate Event Venues</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div>
					<h3 class="text-xl font-bold mb-3">World Equestrian Center</h3>
					<p class="text-gray-100 font-semibold mb-2">Ocala, FL</p>
					<p class="text-gray-200 text-sm">
						Premier venue for large corporate events, trade shows, and conferences. Our carts help attendees navigate this expansive, world-class facility.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Mission Inn Resort & Club</h3>
					<p class="text-gray-100 font-semibold mb-2">Howey-in-the-Hills, FL</p>
					<p class="text-gray-200 text-sm">
						Historic resort with two championship golf courses. Ideal for corporate retreats, golf tournaments, and executive meetings.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Golden Ocala Golf & Equestrian</h3>
					<p class="text-gray-100 font-semibold mb-2">Ocala, FL</p>
					<p class="text-gray-200 text-sm">
						Exclusive private club offering world-class golf and meeting facilities. Perfect for high-end corporate events and client entertainment.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">The Grand Oaks Resort</h3>
					<p class="text-gray-100 font-semibold mb-2">Weirsdale, FL</p>
					<p class="text-gray-200 text-sm">
						Lakefront resort with meeting facilities and outdoor spaces. Excellent for corporate retreats and team-building events.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Southeastern Livestock Pavilion</h3>
					<p class="text-gray-100 font-semibold mb-2">Ocala, FL</p>
					<p class="text-gray-200 text-sm">
						Large venue hosting trade shows, expos, and agricultural events. Golf carts essential for navigating exhibit areas and vendor spaces.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">The Villages Event Centers</h3>
					<p class="text-gray-100 font-semibold mb-2">The Villages, FL</p>
					<p class="text-gray-200 text-sm">
						Multiple recreation centers and event facilities perfect for regional corporate events and conferences.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Choose Us -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why Companies Choose Masters Golf Cars</h2>
			<div class="grid md:grid-cols-2 gap-12">
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">Professional Fleet Service</h3>
					<ul class="space-y-3 text-gray-700 font-semibold">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Large fleet available for events up to 50+ carts</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>All carts cleaned and inspected before delivery</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Coordinated delivery and pickup around your schedule</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>On-site support available for multi-day events</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Backup carts available for peace of mind</span>
						</li>
					</ul>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">26+ Years Event Experience</h3>
					<ul class="space-y-3 text-gray-700 font-semibold">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Trusted by WEC, HITS, and major venues</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Experienced with corporate event logistics</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Flexible rental terms for your event timeline</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Single point of contact for all logistics</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Volume discounts for large fleet orders</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- How It Works -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">How Corporate Fleet Rental Works</h2>
			<div class="grid md:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">1</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Submit Request</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Complete our fleet rental form with event details, venue, dates, and number of carts needed.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">2</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Custom Quote</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Our corporate events team will provide a custom quote with fleet configuration options.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">3</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Delivery & Setup</h3>
					<p class="text-gray-700 font-semibold text-sm">
						We deliver and set up your fleet at the venue before your event begins.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">4</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Event Success</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Run your event seamlessly. We handle pickup after your event concludes.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Testimonial -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="bg-white rounded-3xl shadow-lg p-8 md:p-12 max-w-3xl mx-auto text-center">
				<div class="flex justify-center gap-1 mb-6">
					{Array.from({ length: 5 }).map((_star, index) => (
						<svg class="w-6 h-6" fill="#FFD700" viewBox="0 0 20 20">
							<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
						</svg>
					))}
				</div>
				<p class="text-gray-700 leading-relaxed mb-6 font-semibold text-lg">
					"Masters Golf Cars provided 12 carts for our company retreat at Mission Inn Resort. The logistics were flawless and the carts were immaculate. Our team loved the convenience and it made navigating the resort property effortless. Highly recommend for any corporate event."
				</p>
				<p class="font-black text-gray-900">-Corporate Events Manager, Fortune 500 Company</p>
			</div>
		</div>
	</section>

	<!-- Related Services -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Event Rental Services</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Wedding Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf cart rentals for weddings at Central Florida venues.
						</p>
						<a href="/golf-cart-rentals-weddings" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Festival Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Fleet rentals for festivals, concerts, and large outdoor events.
						</p>
						<a href="/golf-cart-rentals-festivals" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Tournament Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Cart fleets for charity and corporate golf tournaments.
						</p>
						<a href="/golf-cart-rentals-golf-tournaments" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<FleetQuoteForm pageSource="Corporate Events Page" idPrefix="fleet-corp" defaultEventType="Corporate event" />

	<!-- CTA Section -->
	<section class="py-16 bg-gray-900 text-white">
		<div class="container mx-auto px-4 max-w-6xl text-center">
			<h2 class="text-3xl md:text-4xl font-black mb-6">Ready to Reserve Golf Carts for Your Corporate Event?</h2>
			<p class="text-xl mb-8 font-semibold text-gray-300">
				Contact Masters Golf Cars today for a custom fleet quote. We serve corporate events at venues throughout Central Florida including <strong>World Equestrian Center</strong>, <strong>Mission Inn Resort</strong>, <strong>Golden Ocala</strong>, and more.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
				<a href="/fleet-rentals-quote" class="bg-brand-green text-white font-bold py-4 px-8 rounded-lg hover:opacity-90 transition">
					Request Fleet Quote
				</a>
				<a href="tel:3523070111" class="bg-white text-gray-900 font-bold py-4 px-8 rounded-lg hover:bg-gray-100 transition">
					Call (352) 307-0111
				</a>
			</div>
			<p class="text-gray-400 font-semibold">
				{companyData.location.full} | Serving Central Florida Since 1999
			</p>
		</div>
	</section>

	<Schema schema={localBusinessSchema} />
</Layout>
