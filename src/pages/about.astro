---
import Layout from '../layouts/Layout.astro';
import HeroDark from '../components/sections/HeroDark.astro';
import Reviews from '../components/sections/Reviews.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Ring from '../components/ui/Ring.astro';
import Btn from '../components/ui/Btn.astro';
import companyData from '../data/company.json';
import { R } from '../lib/areas';
const crumbs = [{ name: "Home", url: "https://mastersgolfcars.com" }, { name: "About", url: "https://mastersgolfcars.com/about" }];
const photos = [[R + 'yamaha-aisle.jpg', 'Rows of rental carts at the Belleview lot'], [R + 'clubcar-utility-row.jpg', 'Utility carts lined up at the shop'], [R + 'delivery.jpg', 'Masters trucks hauling trailers of carts']];
---

<Layout title="About Masters Golf Cars | Family Run in Belleview, FL Since 1999" description="Masters Golf Cars has rented, sold, serviced and customized golf carts from one shop on US 441 in Belleview since 1999. Meet the team behind Central Florida's largest rental fleet." breadcrumbs={crumbs} quoteHref="/contact">
	<HeroDark eyebrow="About Masters Golf Cars" heading="Family run in Belleview" accent="since 1999." lead="Rentals, sales, service, lithium and custom builds, all from one shop on 441 between Ocala and The Villages." cta="Come see the shop" ctaHref="/contact" img={R + 'fleet-poster.jpg'} alt="Drone view of the Masters lot" />

	<section class="sec paper stats">{[['1999', 'The year it started'], ['300+', 'Carts in the rental fleet'], ['25+ yrs', 'Serving Central Florida'], ['4.9', 'Google rating, 93 reviews']].map(([b, s]) => <div class="stat"><div class="fd" style="font-size:40px;line-height:1">{b}</div><div class="small">{s}</div></div>)}</section>

	<section class="sec white story">
		<div class="head"><Eyebrow>Our story</Eyebrow><h2 class="h2">It is not just business. It is personal.</h2></div>
		<div class="stack" style="gap:22px">
			<p class="sp">{companyData.description}</p>
			<p class="sp">What started with a handful of carts grew into the largest rental fleet in the area, a full service shop that works on gas and electric carts every day, new and pre-owned sales, Bolt Energy lithium conversions and custom builds. Fleets from Belleview now show up at horse shows, festivals, tournaments and weddings across Florida.</p>
			<p class="sp">What has not changed: a real person answers the phone, deliveries and repairs happen when we said they would, and if something is not right, we make it right.</p>
		</div>
	</section>

	<section class="sec paper stack" style="gap:48px">
		<div class="head"><Eyebrow>How we work</Eyebrow><h2 class="h2 md">Three things we will not skip.</h2></div>
		<div class="grid3" style="gap:40px">{[['phone', 'We answer the phone', 'Mon to Fri 8:30 to 5, Sat 9 to 2. A person, not a menu.'], ['clock', 'We show up on time', 'Deliveries, pickups and repairs, when we said.'], ['shield', 'We stand behind it', 'If something is not right, call us and we will make it right.']].map(([i, t, s]) => <div class="val"><Ring name={i} fill /><h3 class="h3" style="font-size:20px;line-height:26px">{t}</h3><p class="body">{s}</p></div>)}</div>
	</section>

	<section class="sec white stack" style="gap:48px">
		<div class="head"><Eyebrow>Around the shop</Eyebrow><h2 class="h2 md">On 441 in Belleview.</h2></div>
		<div class="grid3" style="gap:16px">{photos.map(([src, alt]) => <div class="ph"><img src={src} alt={alt} loading="lazy" width="440" height="280" /></div>)}</div>
		<div class="row btn-row" style="gap:16px"><Btn href="/gallery" kind="ghost">See the gallery</Btn><Btn href="/contact">Visit or call</Btn></div>
	</section>

	<Reviews heading="25+ years of showing up on time." bg="paper" />
</Layout>

<style>
	.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; padding-top: 56px; padding-bottom: 56px; }
	.stat { display: flex; flex-direction: column; gap: 8px; padding-top: 20px; border-top: 1px solid var(--rule); }
	.story { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: start; }
	.sp { margin: 0; font-size: 18px; line-height: 30px; color: var(--ink); }
	.val { display: flex; flex-direction: column; gap: 16px; padding-top: 24px; border-top: 1px solid var(--line); }
	.ph { height: 280px; overflow: hidden; background: var(--black); }
	.ph img { display: block; width: 100%; height: 100%; object-fit: cover; }
	@media (max-width: 1100px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } .story { grid-template-columns: 1fr; gap: 32px; } }
	@media (max-width: 760px) { .ph { height: 200px; } }
</style>
