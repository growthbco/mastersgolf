---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-gainesville.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Gainesville Golf Cart Rentals",
	"description": "Golf cart rentals in Gainesville, FL. Serving Haile Plantation, Tioga, Archer, University of Florida area, Newberry, and all of Alachua County.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-gainesville",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Haile Plantation",
		"Tioga",
		"Archer",
		"University of Florida",
		"Newberry",
		"Downtown Gainesville",
		"Alachua County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "How fast can you deliver to Gainesville?",
  "answer": "Often the same or next day when carts are available. Book ahead for holidays and busy event weeks."
 },
 {
  "question": "Is there a delivery fee?",
  "answer": "Delivery is quoted with your reservation based on your address. Call (352) 307-0111 for a quick number."
 },
 {
  "question": "Is there a minimum rental?",
  "answer": "Yes, 3 days. After that, rent by the week, the month or the season."
 },
 {
  "question": "How old do I have to be?",
  "answer": "Renters must be 21 or older with a valid driver license."
 },
 {
  "question": "Can I extend?",
  "answer": "Yes. Call us before your end date and we will extend it if the cart is available."
 }
];

const LEAD = ["Since 1999, Masters Golf Cars has been serving Gainesville and Alachua County with premium golf cart rentals. We serve neighborhoods throughout Gainesville including Haile Plantation, Tioga, Archer, and the University of Florida area. Our convenient location at 12885 S US Highway 441 in Belleview makes us easily accessible from I-75, US-441, and Archer Road.", "With over 26 years of experience serving Central Florida, we deliver reliable golf carts directly to your Gainesville location. Whether you need a cart for exploring Paynes Prairie Preserve State Park, attending events at Ben Hill Griffin Stadium, or navigating your neighborhood, we have the perfect rental solution."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals in Gainesville, FL", url: "https://mastersgolfcars.com/golf-cart-rentals-gainesville" }
];
---

<Layout title="Golf Cart Rentals in Gainesville, FL | Masters Golf Cars - UF Area" description="Rent golf carts in Gainesville, FL. Serving UF area, Haile Plantation, Tioga & more. Delivery available. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-gainesville" breadcrumbs={crumbs} quoteHref="#reserve">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="city" name="Gainesville" slug="golf-cart-rentals-gainesville" eyebrow="Golf cart rentals in Gainesville, FL" heading="Golf cart rentals," accent="delivered in Gainesville." lead={LEAD} img={R + 'cart-4p.jpg'} imgLabel="UF area, Haile Plantation, Tioga and Alachua County" proof={[["pin", "55 miles away", "About an hour up 441"], ["truck", "Delivered to you", "Home, campus or venue"], ["key", "300+ carts", "Availability most weeks"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultLocation="Gainesville, FL" />
</Layout>
