---
import Layout from '../layouts/Layout.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';
import servicesData from '../data/services.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - The Villages Golf Carts for Sale",
	"description": "New and used golf carts for sale in The Villages, FL. Serving Spanish Springs, Lake Sumter Landing, Brownwood, and all Villages neighborhoods.",
	"url": "https://mastersgolfcars.com/golf-carts-for-sale-the-villages",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Spanish Springs",
		"Lake Sumter Landing",
		"Brownwood",
		"The Villages",
		"Sumter County",
		"Marion County Villages",
		"Lake County Villages"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
---

<Layout 
	title="Golf Carts for Sale in The Villages, FL | Masters Golf Cars - New & Used" 
	description="Buy golf carts in The Villages, FL. New & used golf carts for sale. Perfect for exploring The Villages. Financing available. 26+ years experience. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-carts-for-sale-the-villages"
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Golf Carts for Sale in The Villages, FL</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Since 1999, Masters Golf Cars has been The Villages' trusted source for new and used golf carts. We serve residents throughout The Villages, America's premier active adult retirement community, with over 130,000 residents and 100+ miles of golf cart paths.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						Our convenient location at <strong>12885 S US Highway 441 in Belleview</strong> (just minutes from The Villages) makes us easily accessible. With over 26 years of experience serving The Villages, we're your trusted source for Club Car, Yamaha, and EZ-GO golf carts perfect for exploring The Villages' town squares, golf courses, and recreational facilities.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/golf-cart-inventory" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							View Inventory
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/golf-cart-rentals-page/golf-cart-rentals-in-the-villages_img_v69_250813_160043497.webp" alt="Golf carts for sale in The Villages Florida" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Why Buy From Us -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why The Villages Chooses Masters Golf Cars</h2>
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-6">
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">26+ Years Serving The Villages</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Since 1999, we've been The Villages' trusted golf cart dealership. We've sold thousands of golf carts to residents throughout The Villages. Our deep understanding of The Villages lifestyle means we can help you find the perfect cart for navigating the community's extensive golf cart paths.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Perfect for The Villages Lifestyle</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Golf carts are essential in The Villages, with over 100 miles of golf cart paths connecting neighborhoods, town squares, golf courses, and recreational facilities. We understand the specific needs of The Villages residents and can recommend carts perfect for exploring <strong>Spanish Springs</strong>, <strong>Lake Sumter Landing</strong>, <strong>Brownwood</strong>, and all The Villages has to offer.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Authorized Dealer for Top Brands</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							We're an authorized dealer for <strong>Club Car</strong>, <strong>Yamaha</strong>, and <strong>EZ-GO</strong> - the brands most trusted by The Villages residents. Whether you need a cart for daily errands, golf course access, or exploring The Villages' amenities, we have the perfect solution.
						</p>
					</div>
				</div>
				<div>
					<div class="bg-white rounded-lg p-8 shadow-lg mb-6">
						<h3 class="text-xl font-bold text-gray-900 mb-4">The Villages Communities We Serve</h3>
						<ul class="space-y-2 text-gray-700 font-semibold mb-6">
							<li>✓ All Villages Neighborhoods</li>
							<li>✓ Spanish Springs Area</li>
							<li>✓ Lake Sumter Landing Area</li>
							<li>✓ Brownwood Area</li>
							<li>✓ All of Sumter County</li>
							<li>✓ Marion County Villages Areas</li>
							<li>✓ Lake County Villages Areas</li>
						</ul>
					</div>
					<div class="bg-brand-green text-white rounded-lg p-8">
						<h3 class="text-xl font-bold mb-4">Easy Financing Available</h3>
						<p class="mb-4 font-semibold">
							We offer flexible financing options through Sheffield Financial and other lenders. Stop by our location at <strong>12885 S US Highway 441</strong> to discuss financing options that work for you.
						</p>
						<a href="https://prequalify.sheffieldfinancial.com/Apply/Landing?source=web&dealer=57070" target="_blank" rel="noopener noreferrer" class="inline-block bg-black text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-900 transition">
							Apply for Financing
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Brands We Carry -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Golf Cart Brands Perfect for The Villages</h2>
			<p class="text-lg text-gray-700 text-center mb-10 font-semibold max-w-3xl mx-auto">
				We're an authorized dealer for the top golf cart brands trusted by The Villages residents. Each brand offers unique features perfect for The Villages lifestyle.
			</p>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'Club Car')?.icon || '/images/logos/club-car-icon-0-0.webp'} alt="Club Car golf carts The Villages" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">Club Car</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Premium golf carts known for durability and performance. Popular choice in The Villages for reliability and comfort.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'Yamaha')?.icon || '/images/logos/yamaha-icon-0-1.webp'} alt="Yamaha golf carts The Villages" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">Yamaha</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Reliable and efficient golf carts with excellent battery life. Great for daily use exploring The Villages.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'EZ-GO')?.icon || '/images/logos/ez-go-icon-0-2.webp'} alt="EZ-GO golf carts The Villages" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">EZ-GO</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Affordable and versatile golf carts perfect for The Villages lifestyle. Popular choice for value and reliability.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- New vs Used -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">New & Used Golf Carts in The Villages</h2>
			<div class="grid md:grid-cols-2 gap-12">
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">New Golf Carts</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Browse our selection of brand new golf carts from Club Car, Yamaha, and EZ-GO. New carts come with full manufacturer warranties and the latest features perfect for The Villages lifestyle.
					</p>
					<ul class="space-y-3 text-gray-700 font-semibold mb-6">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Full manufacturer warranty</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Latest features and technology</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Customization options available</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Financing available</span>
						</li>
					</ul>
					<a href="/golf-cart-inventory?condition=new" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
						View New Inventory
					</a>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">Used Golf Carts</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Find quality pre-owned golf carts at great prices. We carefully inspect all used carts and offer trade-ins from The Villages residents, ensuring you get a reliable cart that's perfect for your needs.
					</p>
					<ul class="space-y-3 text-gray-700 font-semibold mb-6">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Thoroughly inspected and serviced</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Great value for your budget</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Trade-ins accepted</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Financing available on used carts</span>
						</li>
					</ul>
					<a href="/golf-cart-inventory?condition=used" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
						View Used Inventory
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Related Services Section - Internal Linking -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Services in The Villages</h2>
				<div class="grid md:grid-cols-2 gap-6">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Rentals in The Villages</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Need a golf cart for a short-term need? We offer convenient rentals throughout The Villages with delivery to your location.
						</p>
						<a href="/the-villages-golf-cart-rentals" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn More About The Villages Rentals
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Repairs</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Keep your golf cart running smoothly with our expert repair services. Fast, reliable service for The Villages residents.
						</p>
						<a href="/golf-cart-repairs" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn More About Repairs
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Other Locations Section - Internal Linking -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Golf Carts for Sale in Other Areas</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Ocala Sales</h3>
						<p class="text-gray-700 font-semibold mb-4">
							New and used golf carts for sale in Ocala, FL. Serving Ocala Palms, Golden Ocala, and more.
						</p>
						<a href="/golf-carts-for-sale-ocala" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Gainesville Sales</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf carts for sale in Gainesville, FL. Serving UF area and Alachua County.
						</p>
						<a href="/golf-carts-for-sale-gainesville" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Belleview Sales</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf carts for sale in Belleview, FL. Our home location with convenient service.
						</p>
						<a href="/golf-cart-inventory" class="text-brand-green font-bold hover:underline">View Inventory</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Related Articles -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 text-center mb-8">Related Articles</h2>
				<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 hover:border-brand-green transition">
					<a href="/blog/golf-cart-guide-the-villages" class="block">
						<h3 class="text-xl font-bold text-gray-900 mb-2">The Ultimate Golf Cart Guide for The Villages</h3>
						<p class="text-gray-700 font-semibold">Everything you need to know about owning and using a golf cart in The Villages, from paths and rules to the best destinations.</p>
					</a>
				</div>
			</div>
		</div>
	</section>

	<CartInquiryForm pageSource="The Villages Sales" idPrefix="sales-villages" />

	<!-- CTA Section -->
	<section class="py-16 bg-gray-900 text-white">
		<div class="container mx-auto px-4 max-w-6xl text-center">
			<h2 class="text-3xl md:text-4xl font-black mb-6">Ready to Buy a Golf Cart in The Villages?</h2>
			<p class="text-xl mb-8 font-semibold text-gray-300">
				Visit Masters Golf Cars today to see our selection of new and used golf carts perfect for The Villages lifestyle. We're conveniently located at <strong>12885 S US Highway 441 in Belleview</strong>, just minutes from The Villages.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
				<a href="/golf-cart-inventory" class="bg-brand-green text-white font-bold py-4 px-8 rounded-lg hover:opacity-90 transition">
					View Inventory
				</a>
				<a href="tel:3523070111" class="bg-white text-gray-900 font-bold py-4 px-8 rounded-lg hover:bg-gray-100 transition">
					Call (352) 307-0111
				</a>
			</div>
			<p class="text-gray-400 font-semibold">
				{companyData.location.full} | Serving The Villages Since 1999
			</p>
		</div>
	</section>

	<Schema schema={localBusinessSchema} />
</Layout>
