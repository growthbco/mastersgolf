---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import HeroSplit from '../components/sections/HeroSplit.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import LocalContent from '../components/sections/LocalContent.astro';
import Reviews from '../components/sections/Reviews.astro';
import Faq from '../components/sections/Faq.astro';
import FormShell from '../components/forms/FormShell.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Check from '../components/ui/Check.astro';
import local from '../data/locations/golf-carts-for-sale-the-villages.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - The Villages Golf Carts for Sale",
	"description": "New and used golf carts for sale in The Villages, FL. Serving Spanish Springs, Lake Sumter Landing, Brownwood, and all Villages neighborhoods.",
	"url": "https://mastersgolfcars.com/golf-carts-for-sale-the-villages",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Spanish Springs",
		"Lake Sumter Landing",
		"Brownwood",
		"The Villages",
		"Sumter County",
		"Marion County Villages",
		"Lake County Villages"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "Do you deliver carts to The Villages?",
  "answer": "Yes. New and pre-owned carts are delivered to The Villages from our shop in Belleview."
 },
 {
  "question": "Do you offer financing?",
  "answer": "Yes, through Sheffield Financial. Apply online in minutes."
 },
 {
  "question": "Do you take trade-ins?",
  "answer": "Yes. Trade toward any cart in stock, or sell your cart to us outright."
 },
 {
  "question": "What comes with a new cart?",
  "answer": "A free first year of 24hr Cart Club roadside assistance, and service from the shop that sold it."
 }
];

const LEAD = ["Since 1999, Masters Golf Cars has been The Villages' trusted source for new and used golf carts. We serve residents throughout The Villages, America's premier active adult retirement community, with over 130,000 residents and 100+ miles of golf cart paths.", "Our convenient location at 12885 S US Highway 441 in Belleview (just minutes from The Villages) makes us easily accessible. With over 26 years of experience serving The Villages, we're your trusted source for Club Car, Yamaha, and EZ-GO golf carts perfect for exploring The Villages' town squares, golf courses, and recreational facilities."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Inventory", url: "https://mastersgolfcars.com/golf-cart-inventory" },
	{ name: "The Villages", url: "https://mastersgolfcars.com/golf-carts-for-sale-the-villages" }
];
---

<Layout title="Golf Carts for Sale in The Villages, FL | Masters Golf Cars - New & Used" description="Buy golf carts in The Villages, FL. New & used golf carts for sale. Perfect for exploring The Villages. Financing available. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-carts-for-sale-the-villages" breadcrumbs={crumbs} quoteHref="#askcart">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />

	<HeroSplit eyebrow="Golf carts for sale in The Villages" heading="Your next cart," accent="delivered to The Villages." lead={LEAD[0]} cta="Browse inventory" ctaHref="#inventory" checks={['New and pre-owned', 'Financing through Sheffield Financial', 'Trade-ins welcome', 'Delivered to The Villages']} img={R + 'clubcar-row.jpg'} alt="Row of golf carts for sale at Masters Golf Cars" label="10 miles from our shop" pos="50% 60%" />
	<ProofBar items={[['tag', 'New and pre-owned', 'Club Car, Yamaha, E-Z-GO, Advanced EV'], ['dollar', 'Financing', 'Apply online with Sheffield Financial'], ['truck', 'Delivered to The Villages', 'Set up and ready to drive'], ['star', '4.9 on Google', 'From 93 customer reviews']]} />
	{LEAD.length > 1 && <section class="sec white" style="padding-bottom:0"><div class="stack" style="gap:16px;max-width:820px">{LEAD.slice(1).map((p) => <p class="body" style="font-size:17px;line-height:28px">{p}</p>)}</div></section>}
	<LocalContent sections={local.sections} eyebrow="Buying a cart in The Villages" />

	<section class="sec dark on-dark fin">
		<div class="head"><Eyebrow>Financing</Eyebrow><h2 class="h2">Easy financing on <span class="g">new and used carts.</span></h2><p class="lead" style="max-width:460px">Apply online in a few minutes through Sheffield Financial. Approved buyers can drive away the same day.</p></div>
		<div class="stack" style="gap:28px">
			<div class="check-list" style="gap:14px 24px">{['Apply online, from home', 'New and pre-owned carts', 'Trade-ins accepted toward your purchase', 'Free first year of 24hr Cart Club with every new cart'].map((t) => <Check>{t}</Check>)}</div>
			<div class="row btn-row" style="gap:16px"><Btn href="https://www.sheffieldfinancial.com/" kind="solid">Apply for financing</Btn><Btn href="/sell-your-cart" kind="ghost-d">Sell or trade your cart</Btn></div>
		</div>
	</section>

	<Reviews heading="What The Villages buyers say." />
	<Faq items={pageFAQs} heading="The Villages questions." />

	<FormShell id="askcart" eyebrow="Ask about a cart" heading="Found one you" accent="like?" lead="Tell us what you are looking for and our sales team will get back to you as soon as possible during business hours.">
		<CartInquiryForm pageSource="golf-carts-for-sale-the-villages" idPrefix="sales" />
	</FormShell>
</Layout>

<style>
	.fin { display: grid; grid-template-columns: 1fr 1.3fr; gap: 80px; align-items: center; }
	@media (max-width: 1100px) { .fin { grid-template-columns: 1fr; gap: 40px; } }
</style>
