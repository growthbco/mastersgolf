---
import Layout from '../layouts/Layout.astro';
import ServiceRequestForm from '../components/forms/ServiceRequestForm.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Belleview Golf Cart Repairs",
	"description": "Golf cart repair service in Belleview, FL. Our home location serving Belleview, Ocala, The Villages, and all of Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-repairs-belleview",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Belleview",
		"Ocala",
		"The Villages",
		"Summerfield",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
---

<Layout 
	title="Golf Cart Repairs in Belleview, FL | Masters Golf Cars - 24-Hour Service" 
	description="Fast golf cart repairs in Belleview, FL. Our home location! 24-hour turnaround. Pickup & delivery. 26+ years experience. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-cart-repairs-belleview"
>
	<!-- Hero Section -->
	<section class="bg-white py-16">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h1 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900 text-center">Golf Cart Repairs in Belleview, FL</h1>
				<h2 class="text-2xl md:text-3xl font-semibold mb-10 text-gray-900 text-center">Fast, Reliable Golf Cart Service - Right Here in Belleview</h2>

				<div class="bg-white rounded-3xl shadow-2xl p-6 md:p-10 flex flex-col md:flex-row gap-10 items-center">
					<!-- Image -->
					<div class="relative w-full md:w-1/2">
						<div class="overflow-hidden rounded-2xl shadow-xl">
							<img src="/images/golf cart repair page/05-08-2025-14-31-50_52.webp" alt="Golf cart repair service in Belleview Florida" class="w-full h-64 md:h-[360px] object-cover" loading="eager" />
						</div>
					</div>

					<!-- Text Content -->
					<div class="w-full md:w-1/2">
						<p class="text-lg text-gray-700 mb-6 leading-relaxed font-semibold">
							Since 1999, Masters Golf Cars has been Belleview's trusted golf cart repair and service center. Located right here in Belleview at <strong>12885 S US Highway 441</strong> (across from the <strong>Market of Marion</strong>), we're your local experts for all golf cart repair needs.
						</p>
						<p class="text-lg text-gray-700 mb-8 leading-relaxed font-semibold">
							With over 26 years of experience serving Belleview and surrounding Marion County, we specialize in both gas and electric golf cart repairs. Our certified technicians provide fast, affordable service with most repairs completed within 24 hours. Since we're right here in Belleview, we can provide the fastest pickup and delivery service in the area.
						</p>
						<a href="/schedule-golf-cart-service" class="bg-brand-green text-white px-8 py-4 rounded-lg font-bold transition inline-flex items-center justify-center gap-2 hover:opacity-90 shadow-lg">
							Schedule Your Golf Cart Repairs
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Fast 24-Hour Repairs Section -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold mb-6 text-gray-900 text-center">Fast, 24-Hour Golf Cart Repairs in Belleview</h2>
				<p class="text-lg text-gray-700 font-semibold mb-4">
					We understand how important your golf cart is to your daily life. Since we're right here in Belleview, we can provide the fastest service turnaround in the area. Most repairs are completed within 24 hours, getting you back on the road quickly.
				</p>
				<p class="text-lg text-gray-700 font-semibold">
					Our experienced technicians work diligently to diagnose and fix issues promptly without compromising on quality. Whether you need service for your daily driver or a cart you use for special occasions, we're here to help.
				</p>
			</div>
		</div>
	</section>

	<!-- Why Choose Us Section -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<div class="bg-gray-100 rounded-[32px] px-6 py-12 md:px-12 md:py-16 shadow-xl">
					<div class="flex flex-col items-center text-center gap-6 mb-10">
						<div class="flex gap-3">
							{Array.from({ length: 5 }).map((_item, index) => (
								<svg class="w-10 h-10 md:w-12 md:h-12" fill="currentColor" viewBox="0 0 20 20" style="color: #FFD24D;" aria-hidden="true">
									<title>Star {index + 1}</title>
									<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
								</svg>
							))}
						</div>
						<h2 class="text-3xl md:text-4xl font-bold text-gray-900">Why Belleview Chooses Us For Golf Cart Repairs</h2>
					</div>

					<div class="grid md:grid-cols-2 gap-8 mb-10">
						<div class="bg-white rounded-lg p-6">
							<h3 class="text-xl font-bold text-gray-900 mb-4">26+ Years Serving Belleview</h3>
							<p class="text-gray-700 font-semibold mb-4">
								Since 1999, we've been Belleview's trusted golf cart repair shop. We've built our reputation by providing exceptional service to thousands of Belleview residents and surrounding communities.
							</p>
							<ul class="space-y-2 text-gray-700 font-semibold">
								<li>✓ Locally owned and operated since 1999</li>
								<li>✓ Right here in Belleview</li>
								<li>✓ 5-star Google reviews from local customers</li>
								<li>✓ Authorized service for all major brands</li>
							</ul>
						</div>
						<div class="bg-white rounded-lg p-6">
							<h3 class="text-xl font-bold text-gray-900 mb-4">Fastest Service in the Area</h3>
							<p class="text-gray-700 font-semibold mb-4">
								Since we're right here in Belleview, we can provide the fastest pickup, repair, and delivery service. No need to travel far - we're your local experts.
							</p>
							<ul class="space-y-2 text-gray-700 font-semibold">
								<li>✓ Certified technicians with 26+ years experience</li>
								<li>✓ Most repairs completed in 24 hours</li>
								<li>✓ Convenient pickup and delivery</li>
								<li>✓ Easy drop-off at our Belleview location</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Schedule Section -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: #86CA26;">Schedule Your Golf Cart Repairs in Belleview Today</h2>
				<p class="text-lg text-gray-700 font-semibold mb-8">
					Don't wait until your golf cart breaks down completely. Schedule a repair appointment today and keep your cart running smoothly. Our team is ready to help with all your golf cart maintenance and repair needs right here in Belleview.
				</p>
				<a href="/schedule-golf-cart-service" class="bg-brand-green text-white px-8 py-4 rounded-lg font-bold transition inline-block hover:opacity-90">
					Schedule Your Golf Cart Repairs
				</a>
			</div>
		</div>
	</section>

	<!-- Related Services Section - Internal Linking -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Services in Belleview</h2>
				<div class="grid md:grid-cols-2 gap-6">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Rentals in Belleview</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Need a golf cart while yours is being repaired? We offer convenient rentals right here in Belleview.
						</p>
						<a href="/golf-cart-rentals-belleview" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn More About Belleview Rentals
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Carts for Sale</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Browse our selection of new and used golf carts. Visit our Belleview location to see our inventory.
						</p>
						<a href="/golf-cart-inventory" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							View Inventory
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Other Locations Section - Internal Linking -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Golf Cart Repairs in Other Areas</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Ocala Repairs</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Fast golf cart repairs in Ocala, FL. Serving Ocala Palms, Golden Ocala, and more.
						</p>
						<a href="/golf-cart-repairs-ocala" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Gainesville Repairs</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf cart repair service in Gainesville, FL. Serving UF area and Alachua County.
						</p>
						<a href="/golf-cart-repairs-gainesville" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">The Villages Repairs</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Expert golf cart repairs serving The Villages and surrounding communities.
						</p>
						<a href="/golf-cart-repairs" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<ServiceRequestForm pageSource="Belleview Repairs" idPrefix="repair-belleview" defaultLocation="Belleview, FL" />

	<!-- CTA Section -->
	<section class="py-16 bg-gray-900 text-white">
		<div class="container mx-auto px-4 max-w-6xl text-center">
			<h2 class="text-3xl md:text-4xl font-black mb-6">Ready to Repair Your Golf Cart in Belleview?</h2>
			<p class="text-xl mb-8 font-semibold text-gray-300">
				Contact Masters Golf Cars today for fast, reliable golf cart repairs. We're right here in Belleview, ready to serve you!
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
				<a href="/schedule-golf-cart-service" class="bg-brand-green text-white font-bold py-4 px-8 rounded-lg hover:opacity-90 transition">
					Schedule Service
				</a>
				<a href="tel:3523070111" class="bg-white text-gray-900 font-bold py-4 px-8 rounded-lg hover:bg-gray-100 transition">
					Call (352) 307-0111
				</a>
			</div>
			<p class="text-gray-400 font-semibold">
				{companyData.location.full} | Serving Belleview Since 1999
			</p>
		</div>
	</section>

	<Schema schema={localBusinessSchema} />
</Layout>
