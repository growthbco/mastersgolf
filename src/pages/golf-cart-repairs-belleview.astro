---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import ServicePage from '../components/sections/ServicePage.astro';
import local from '../data/locations/golf-cart-repairs-belleview.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Belleview Golf Cart Repairs",
	"description": "Golf cart repair service in Belleview, FL. Our home location serving Belleview, Ocala, The Villages, and all of Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-repairs-belleview",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Belleview",
		"Ocala",
		"The Villages",
		"Summerfield",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
const repairsBelleviewFAQs = [
	{
		question: "Where can I get golf cart repair in Belleview, FL?",
		answer: "Masters Golf Cars provides golf cart service and repairs at 12885 S US Hwy 441, Belleview, FL 34420, across from the Market of Marion. Call (352) 307-0111 to schedule service."
	},
	{
		question: "Is Masters Golf Cars a reputable golf cart repair shop in Belleview?",
		answer: "Masters Golf Cars is a family-run, established Central Florida service shop that has operated in Belleview since 1999, handling repairs for carts across Marion, Sumter, Lake, and Alachua counties."
	},
	{
		question: "What golf cart brands does Masters Golf Cars service?",
		answer: "We service Club Car, Yamaha, and EZ-GO golf carts and install Trojan batteries."
	},
	{
		question: "What areas do you serve for golf cart repairs?",
		answer: "We serve Belleview, Ocala, The Villages, Gainesville, and surrounding Central Florida communities across Marion, Sumter, Lake, and Alachua counties."
	},
	{
		question: "What are your service hours?",
		answer: "We are open Monday through Friday 8:30am to 5:00pm and Saturday 9:00am to 2:00pm. Call (352) 307-0111 or email sales@mastersgolfcars.com."
	}
];

const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Repairs", url: "https://mastersgolfcars.com/golf-cart-repairs" },
	{ name: "Belleview", url: "https://mastersgolfcars.com/golf-cart-repairs-belleview" }
];
---

<Layout title="Golf Cart Repairs in Belleview, FL | Masters Golf Cars - 24-Hour Service" description="Fast golf cart repairs in Belleview, FL. Our home location! 24-hour turnaround. Pickup & delivery. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-repairs-belleview" breadcrumbs={crumbs} quoteHref="#schedule">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={repairsBelleviewFAQs} />
	<ServicePage city="Belleview" pageSource="golf-cart-repairs-belleview" faqs={repairsBelleviewFAQs} local={local} defaultLocation="Belleview, FL" />
</Layout>
