---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';

// LocalBusiness Schema for Contact Page
const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"@id": "https://mastersgolfcars.com/#localbusiness",
	"name": "Masters Golf Cars, LLC",
	"alternateName": "Masters Golf Cars",
	"description": companyData.description,
	"url": "https://mastersgolfcars.com",
	"logo": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"image": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"telephone": "+1-352-307-0111",
	"email": "sales@mastersgolfcars.com",
	"foundingDate": "1999",
	"priceRange": "$$",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420",
		"addressCountry": "US"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 29.034576,
		"longitude": -82.025011
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			"opens": "08:30",
			"closes": "17:00"
		},
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": "Saturday",
			"opens": "09:00",
			"closes": "14:00"
		}
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Services",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Rentals",
					"description": "Short-term and long-term golf cart rentals for The Villages, Ocala, and surrounding areas"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Sales",
					"description": "New and pre-owned golf carts for sale including Club Car, E-Z-GO, and Yamaha"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Customization",
					"description": "Custom golf cart builds with lift kits, custom wheels, lighting, and accessories"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Service & Repairs",
					"description": "Maintenance, repairs, and parts for all golf cart brands"
				}
			}
		]
	},
	"paymentAccepted": ["Cash", "Credit Card", "Debit Card", "Financing Available"],
	"sameAs": [
		"https://www.facebook.com/mastersgolfcars",
		"https://www.instagram.com/mastersgolfcars/"
	],
	"areaServed": [
		{
			"@type": "County",
			"name": "Marion County, FL"
		},
		{
			"@type": "County",
			"name": "Sumter County, FL"
		},
		{
			"@type": "County",
			"name": "Lake County, FL"
		},
		{
			"@type": "County",
			"name": "Alachua County, FL"
		}
	]
};
---

<Layout title="Contact Us - Masters Golf Cars" description="Contact Masters Golf Cars for sales, rentals, service, and more">
	<Schema schema={localBusinessSchema} slot="schema" />
	<section class="bg-white py-12">
		<div class="container mx-auto px-4">
			<h1 class="text-4xl md:text-5xl font-bold text-center text-gray-900 mb-10">Contact Us</h1>
		</div>
	</section>

	<section class="bg-white py-0">
		<div class="container mx-auto px-4">
			<div class="grid md:grid-cols-[1fr,1.05fr] gap-10 items-start">
				<div class="bg-white border border-gray-200 rounded-[32px] shadow-xl p-6 md:p-10">
					<div class="flex flex-col md:flex-row gap-8">
						<div class="md:w-5/12">
							<img src="/images/logos/master-golf-cars-delivery-truck_img_v19.webp" alt="Masters Golf Cars service truck" class="w-full h-auto rounded-3xl shadow-lg object-cover" loading="lazy" />
						</div>
						<div class="md:flex-1 space-y-6">
							<div>
								<h2 class="text-2xl font-bold text-gray-900 mb-1">Get In Touch</h2>
								<p class="text-gray-700">{companyData.location.full}</p>
								<p class="text-gray-600 text-sm mt-1">Located between Ocala and The Villages, right on 441 across from the Market of Marion.</p>
							</div>
							<div class="grid sm:grid-cols-2 gap-6">
								<div>
									<h3 class="text-lg font-semibold text-gray-900">Phone</h3>
									<a href={companyData.contact.phoneLink} class="text-2xl font-bold text-brand-green hover:underline">
										{companyData.contact.phone}
									</a>
								</div>
								<div>
									<h3 class="text-lg font-semibold text-gray-900">Email</h3>
									<a href={`mailto:${companyData.contact.email}`} class="text-brand-green hover:underline">
										{companyData.contact.email}
									</a>
								</div>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-gray-900 mb-2">Hours</h3>
								<ul class="text-gray-700 space-y-1">
									<li>Monday – Friday: 8:30am – 5:00pm</li>
									<li>Saturday: 9:00am – 2:00pm</li>
									<li>Sunday: Closed</li>
								</ul>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-gray-900 mb-2">Connect With Us</h3>
								<div class="flex items-center gap-4">
									<a href="https://www.facebook.com/mastersgolfcars" target="_blank" rel="noopener noreferrer" class="text-[#1877F2] hover:text-[#0f5bb5] transition">
										<span class="sr-only">Facebook</span>
										<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
											<path d="M22 12.073c0-5.522-4.477-10-10-10s-10 4.478-10 10c0 4.991 3.657 9.128 8.438 9.878v-6.988H7.898v-2.89h2.54V9.845c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.459h-1.26c-1.241 0-1.63.771-1.63 1.562v1.875h2.773l-.443 2.89h-2.33v6.988C18.343 21.201 22 17.064 22 12.073z" />
										</svg>
									</a>
									<a href="https://www.instagram.com/mastersgolfcars/" target="_blank" rel="noopener noreferrer" class="text-[#E1306C] hover:text-[#b32555] transition">
										<span class="sr-only">Instagram</span>
										<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
											<path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5Zm4.25 4a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm5.5-.875a1.125 1.125 0 1 1-2.25 0 1.125 1.125 0 0 1 2.25 0Z" />
										</svg>
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="space-y-6">
					<div class="grid gap-4 sm:grid-cols-2">
						<div class="border border-gray-200 rounded-2xl p-4 shadow-sm">
							<div class="flex items-center gap-1 text-yellow-400 mb-2">
								{Array.from({ length: 5 }).map(() => (
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
									</svg>
								))}
							</div>
							<p class="text-sm font-semibold text-gray-900 mb-2">Scott Lennox</p>
							<p class="text-gray-700 text-sm">"Fantastic people to work with. Delivered my rental cart on time as promised. Highly recommend!"</p>
						</div>
						<div class="border border-gray-200 rounded-2xl p-4 shadow-sm">
							<div class="flex items-center gap-1 text-yellow-400 mb-2">
								{Array.from({ length: 5 }).map(() => (
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
									</svg>
								))}
							</div>
							<p class="text-sm font-semibold text-gray-900 mb-2">C Porter</p>
							<p class="text-gray-700 text-sm">"Matt spoke with my husband at length and sincerely expressed his appreciation for our business."</p>
						</div>
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						<div class="border border-gray-200 rounded-2xl p-4 shadow-sm">
							<div class="flex items-center gap-1 text-yellow-400 mb-2">
								{Array.from({ length: 5 }).map(() => (
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
									</svg>
								))}
							</div>
							<p class="text-sm font-semibold text-gray-900 mb-2">Beth R</p>
							<p class="text-gray-700 text-sm">"Can't remember exactly who I spoke with over the phone - he sounded like a middle aged/older gentleman. Anyw..."</p>
						</div>
						<div class="border border-gray-200 rounded-2xl p-4 shadow-sm">
							<div class="flex items-center gap-1 text-yellow-400 mb-2">
								{Array.from({ length: 5 }).map(() => (
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
									</svg>
								))}
							</div>
							<p class="text-sm font-semibold text-gray-900 mb-2">Reboot Self Care</p>
							<p class="text-gray-700 text-sm">"My kart started hesitating when I accelerated, the team at Masters recommended a check up. I wasn..."</p>
						</div>
					</div>

					<!-- Google Review Button -->
					<div class="text-center pt-2">
						<a href="https://g.page/r/Ce6p7W6HMgpTEBM/review" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-black hover:bg-gray-900 text-white px-6 py-3 font-bold uppercase text-sm transition rounded-lg">
							<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
								<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
								<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
								<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
								<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
							</svg>
							Leave a Review on Google
						</a>
					</div>

					<div class="space-y-4">
						<h3 class="text-xl md:text-2xl font-bold text-gray-900 uppercase tracking-wide text-center">Contact Form</h3>
						<div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 md:p-8 shadow-sm">
							<form
								name="contact"
								method="POST"
								data-netlify="true"
								netlify-honeypot="bot-field"
								action="/success"
								class="space-y-5"
							>
								<input type="hidden" name="form-name" value="contact" />
								<p class="hidden">
									<label>Don't fill this out if you're human: <input name="bot-field" /></label>
								</p>

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									<div>
										<label for="contact-name" class="block text-sm font-bold text-gray-900 mb-1">Full Name <span class="text-red-600">*</span></label>
										<input type="text" id="contact-name" name="name" required placeholder="Your name" autocomplete="name" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
									</div>
									<div>
										<label for="contact-phone" class="block text-sm font-bold text-gray-900 mb-1">Phone <span class="text-red-600">*</span></label>
										<input type="tel" id="contact-phone" name="phone" required placeholder="(352) 555-1234" autocomplete="tel" inputmode="tel" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
									</div>
								</div>

								<div>
									<label for="contact-email" class="block text-sm font-bold text-gray-900 mb-1">Email <span class="text-red-600">*</span></label>
									<input type="email" id="contact-email" name="email" required placeholder="you@email.com" autocomplete="email" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
								</div>

								<div>
									<label for="contact-subject" class="block text-sm font-bold text-gray-900 mb-1">Subject</label>
									<select id="contact-subject" name="subject" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none">
										<option value="General question">General question</option>
										<option value="Sales inquiry">Sales inquiry</option>
										<option value="Rental inquiry">Rental inquiry</option>
										<option value="Service / Repair">Service / Repair</option>
										<option value="Parts & Accessories">Parts &amp; Accessories</option>
										<option value="Fleet / Event Rentals">Fleet / Event Rentals</option>
										<option value="Other">Other</option>
									</select>
								</div>

								<div>
									<label for="contact-message" class="block text-sm font-bold text-gray-900 mb-1">Message <span class="text-red-600">*</span></label>
									<textarea id="contact-message" name="message" rows="5" required placeholder="How can we help?" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none"></textarea>
								</div>

								<div class="flex items-start gap-3 pt-1">
									<input type="checkbox" id="contact-sms-consent" name="sms_consent" value="yes" class="mt-1 h-4 w-4 rounded border-gray-400 text-brand-green focus:ring-brand-green" />
									<label for="contact-sms-consent" class="text-sm text-gray-700 leading-relaxed">
										I agree to receive SMS text messages from Masters Golf Cars in response to this inquiry, including appointment reminders, service updates, quotes, and follow-up communications. Message frequency varies. Msg and data rates may apply. Reply STOP to opt out or HELP for help. Consent is not a condition of purchase. See our <a href="/privacy-policy" class="text-brand-green font-bold underline hover:opacity-80">Privacy Policy</a> and <a href="/terms-conditions" class="text-brand-green font-bold underline hover:opacity-80">Terms and Conditions</a>.
									</label>
								</div>

								<button type="submit" class="w-full bg-brand-green text-white font-bold uppercase tracking-wide py-3 px-4 rounded-md hover:opacity-90 transition-colors">
									Send Message
								</button>

								<p class="text-center text-xs text-gray-500 flex items-center justify-center gap-1">
									<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4 4 0 00-4 4v3H5a2 2 0 00-2 2v7a2 2 0 002 2h10a2 2 0 002-2v-7a2 2 0 00-2-2h-1V5a4 4 0 00-4-4zm2 7V5a2 2 0 10-4 0v3h4z" clip-rule="evenodd"/></svg>
									Your information is secure and will never be shared.
								</p>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl font-bold text-center text-gray-900 mb-8">Visit Our Showroom</h2>
			<div class="max-w-4xl mx-auto rounded-2xl overflow-hidden shadow-xl border border-gray-200">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6976.811623455518!2d-82.025011!3d29.034576000000005!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88e7cfcec122cd0d%3A0x530a32876eeda9ee!2sMasters%20Golf%20Cars!5e0!3m2!1sen!2sus!4v1762801860534!5m2!1sen!2sus"
					width="100%"
					height="450"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</div>
		</div>
	</section>
</Layout>

