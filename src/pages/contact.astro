---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Ring from '../components/ui/Ring.astro';
import Icon from '../components/ui/Icon.astro';
import Check from '../components/ui/Check.astro';
import FormShell from '../components/forms/FormShell.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"@id": "https://mastersgolfcars.com/#localbusiness",
	"name": "Masters Golf Cars, LLC",
	"alternateName": "Masters Golf Cars",
	"description": companyData.description,
	"url": "https://mastersgolfcars.com",
	"logo": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"image": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png",
	"telephone": "+1-352-307-0111",
	"email": "sales@mastersgolfcars.com",
	"foundingDate": "1999",
	"priceRange": "$$",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420",
		"addressCountry": "US"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 29.034576,
		"longitude": -82.025011
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			"opens": "08:30",
			"closes": "17:00"
		},
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": "Saturday",
			"opens": "09:00",
			"closes": "14:00"
		}
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Services",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Rentals",
					"description": "Short-term and long-term golf cart rentals for The Villages, Ocala, and surrounding areas"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Sales",
					"description": "New and pre-owned golf carts for sale including Club Car, E-Z-GO, and Yamaha"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Customization",
					"description": "Custom golf cart builds with lift kits, custom wheels, lighting, and accessories"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Golf Cart Service & Repairs",
					"description": "Maintenance, repairs, and parts for all golf cart brands"
				}
			}
		]
	},
	"paymentAccepted": ["Cash", "Credit Card", "Debit Card", "Financing Available"],
	"sameAs": [
		"https://www.facebook.com/mastersgolfcars",
		"https://www.instagram.com/mastersgolfcars/"
	],
	"areaServed": [
		{
			"@type": "County",
			"name": "Marion County, FL"
		},
		{
			"@type": "County",
			"name": "Sumter County, FL"
		},
		{
			"@type": "County",
			"name": "Lake County, FL"
		},
		{
			"@type": "County",
			"name": "Alachua County, FL"
		}
	]
};
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Contact", url: "https://mastersgolfcars.com/contact" }
];
const MAPS = 'https://maps.google.com/?q=12885+S+US+Hwy+441+Belleview,+FL+34420';
const EMBED = 'https://www.google.com/maps?q=12885+S+US+Hwy+441,+Belleview,+FL+34420&output=embed';
const CARDS = [
	['pin', 'Visit the shop', ['12885 S US Hwy 441', 'Belleview, FL 34420', 'Across from the Market of Marion']],
	['clock', 'Business hours', ['Monday to Friday: 8:30 AM to 5:00 PM', 'Saturday: 9:00 AM to 2:00 PM', 'Sunday: Closed']],
	['phone', 'Call or text', [companyData.contact.phone, 'Rentals, sales, service and lithium', 'Text us and we text back']],
	['mail', 'Email', [companyData.contact.email, 'We reply during business hours']],
];
const DEPTS = [
	['key', 'Rentals', 'One cart for the week or a fleet for an event.', 'Reserve a cart', '/golf-cart-rentals#reserve'],
	['wrench', 'Service', 'Repairs, annual service and lithium conversions.', 'Schedule service', '/golf-cart-repairs#schedule'],
	['tag', 'Sales', 'New and pre-owned carts, financing and trade-ins.', 'See inventory', '/golf-cart-inventory'],
	['battery', 'Bolt lithium', 'Conversion pricing and pack recommendations.', 'Get my price', '/bolt-lithium'],
];
---

<Layout title="Contact Us - Masters Golf Cars" description="Contact Masters Golf Cars for sales, rentals, service, and more" breadcrumbs={crumbs} quoteHref="#contactform">
	<Schema schema={localBusinessSchema} slot="schema" />

	<section class="chero paper">
		<div class="stack" style="gap:28px">
			<Eyebrow>Contact Masters Golf Cars</Eyebrow>
			<h1 class="h1 ch">Come by, call or <span class="g">send a note.</span></h1>
			<p class="lead" style="max-width:480px">We are between Ocala and The Villages, right on 441 across from the Market of Marion. A real person answers the phone during business hours.</p>
			<div class="row btn-row" style="gap:16px"><Btn href={companyData.contact.phoneLink}>Call {companyData.contact.phone}</Btn><Btn href={MAPS} kind="ghost">Get directions</Btn></div>
		</div>
		<div class="cards">
			{CARDS.map(([i, t, lines]) => <div class="card"><Ring name={i as string} fill /><h3 class="h3" style="font-size:18px;line-height:24px">{t}</h3><div class="stack small" style="gap:4px;font-size:15px;line-height:23px">{(lines as string[]).map((l) => (l.includes('@') ? <a href={`mailto:${l}`} style="color:var(--ink);font-weight:600">{l}</a> : l.startsWith('(') ? <a href={companyData.contact.phoneLink} style="color:var(--ink);font-weight:600">{l}</a> : <span>{l}</span>))}</div></div>)}
		</div>
	</section>

	<section class="map on-dark">
		<div class="stack map-copy" style="gap:28px">
			<div class="head"><Eyebrow>Find us</Eyebrow><h2 class="h2" style="font-size:44px">On 441 in Belleview.</h2><p class="lead" style="max-width:440px">Coming from The Villages, we are about 10 minutes north on 441. From Ocala, about 15 minutes south. Look for the carts.</p></div>
			<div class="check-list" style="grid-template-columns:1fr;gap:12px">{['Plenty of parking', 'Bring your cart for service', 'Test drives welcome'].map((c) => <Check>{c}</Check>)}</div>
		</div>
		<iframe src={EMBED} title="Map to Masters Golf Cars, 12885 S US Hwy 441, Belleview FL" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
	</section>

	<section class="sec white stack" style="gap:48px">
		<div class="head"><Eyebrow>What do you need?</Eyebrow><h2 class="h2 md">Get to the right person faster.</h2></div>
		<div class="grid4 depts">
			{DEPTS.map(([i, t, s, c, h]) => <a href={h} class="dept"><Ring name={i} fill /><h3 class="h3" style="font-size:20px;line-height:26px">{t}</h3><p class="body" style="font-size:15px;line-height:24px">{s}</p><span class="dlink">{c}<Icon name="arrow" size={16} /></span></a>)}
		</div>
	</section>

	<FormShell id="contactform" eyebrow="Send a message" heading="How can we" accent="help?" lead="Tell us what you need and our team will get back to you as soon as possible during business hours.">
		<CartInquiryForm pageSource="contact" idPrefix="contact" placeholder="Tell us what you need: a rental, service, a cart, a lithium conversion or anything else." />
	</FormShell>
</Layout>

<style>
	.chero { padding: 72px var(--gx); background: var(--paper); display: grid; grid-template-columns: 1fr 1.3fr; gap: 72px; align-items: start; }
	.ch { font-size: 64px; line-height: 1.02; letter-spacing: -0.015em; }
	.cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
	.card { display: flex; flex-direction: column; gap: 14px; padding: 28px; background: #fff; border: 1px solid var(--line); }
	.map { background: var(--black); display: grid; grid-template-columns: 1fr 1fr; }
	.map-copy { padding: 72px var(--gx) 72px; }
	.map iframe { width: 100%; min-height: 460px; height: 100%; border: 0; display: block; filter: grayscale(1) contrast(1.05); }
	.dept { display: flex; flex-direction: column; gap: 16px; padding: 28px; border: 1px solid var(--line); border-top: 4px solid var(--green); color: var(--ink); background: #fff; transition: transform .15s; }
	.dept:hover { transform: translateY(-2px); }
	.dlink { margin-top: auto; display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
	@media (max-width: 1100px) { .chero { grid-template-columns: 1fr; gap: 40px; } .ch { font-size: 48px; } .map { grid-template-columns: 1fr; } .map-copy { padding: 56px var(--gx); } .map iframe { min-height: 360px; } .depts { grid-template-columns: 1fr 1fr; } }
	@media (max-width: 760px) { .chero { padding: 48px var(--gx); } .ch { font-size: 38px; } .cards, .depts { grid-template-columns: 1fr; } .map .h2 { font-size: 32px !important; } }
</style>
