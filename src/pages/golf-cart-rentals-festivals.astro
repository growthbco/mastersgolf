---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-festivals.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Festival & Concert Golf Cart Rentals",
	"description": "Golf cart fleet rentals for festivals, concerts, and large outdoor events in Central Florida. Serving Ocala, Marion County, and surrounding areas.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-festivals",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Marion County",
		"Sumter County",
		"Lake County",
		"Alachua County",
		"Ocala",
		"Gainesville"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	}
};

const pageFAQs = [
 {
  "question": "How many carts can you supply?",
  "answer": "Over 300 in the fleet, in 2, 4, 6 passenger and utility. Tell us the size of the event and we will build the mix."
 },
 {
  "question": "How far in advance should I book?",
  "answer": "As early as you can for busy months. A few weeks is usually fine, but big weekends and show weeks fill up."
 },
 {
  "question": "Do you deliver and pick up at the venue?",
  "answer": "Yes. We deliver, stage the carts where you want them, and pick them up when the event ends."
 },
 {
  "question": "Do the carts come fueled?",
  "answer": "Yes. Every cart arrives fueled and keyed, with a contact number in case anything comes up."
 },
 {
  "question": "What are the rates?",
  "answer": "Daily, weekly and event rates, quoted per event. Fill out the form or call (352) 307-0111."
 }
];

const LEAD = ["Keep your festival, concert, or large outdoor event running smoothly with fleet golf cart rentals from Masters Golf Cars. Since 1999, we've provided VIP transportation, staff mobility, and logistics support for events at World Equestrian Center, Southeastern Livestock Pavilion, Florida Horse Park, and venues throughout Central Florida.", "From county fairs to music festivals, equestrian competitions to community events, our fleet keeps artists, VIPs, staff, and vendors moving efficiently across large event grounds."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Festival & Concert Golf Cart Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals-festivals" }
];
---

<Layout title="Festival & Concert Golf Cart Rentals | Fleet Rentals Central Florida" description="Golf cart fleet rentals for festivals, concerts, fairs, and outdoor events. VIP transport, staff mobility, vendor access. Ocala, Marion County. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-festivals" breadcrumbs={crumbs} quoteHref="#fleetquote">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="event" name="festivals" slug="golf-cart-rentals-festivals" eyebrow="Festival and concert golf cart rentals" heading="Keep the whole" accent="festival moving." lead={LEAD} img={R + 'fleet-aerial-road.jpg'} imgLabel="VIP transport, staff mobility and vendor access" proof={[["users", "Staff and VIP", "2, 4 and 6 passenger carts"], ["truck", "Utility carts", "Gear, vendors and cleanup"], ["key", "300+ carts", "Any size festival"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultEventType="Festival / Concert" faqTitle="Festival questions." />
</Layout>
