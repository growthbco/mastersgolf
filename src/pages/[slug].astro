---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import inventoryData from '../data/inventory.json';
import CartCard from '../components/CartCard.astro';
import FormShell from '../components/forms/FormShell.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Check from '../components/ui/Check.astro';
import companyData from '../data/company.json';

export async function getStaticPaths() {
	return inventoryData
		.filter(cart => cart.slug)
		.map((cart) => ({
			params: { slug: cart.slug },
			props: { cart, slug: cart.slug },
		}));
}

const { cart, slug } = Astro.props;
const cartImages = cart.images && cart.images.length > 0 ? cart.images : [cart.image];
const currentUrl = `https://mastersgolfcars.com/${slug}`;
// Get similar units (exclude current cart, show all inventory items)
const similarUnits = inventoryData.filter(c => c.id !== cart.id).slice(0, 5);

// Product Schema for individual cart pages
const productSchema = {
	"@context": "https://schema.org",
	"@type": "Product",
	"name": cart.name,
	"description": `${cart.year} ${cart.brand} ${cart.model} golf cart for sale at Masters Golf Cars. Features include Deluxe Sunbrella Enclosure, Luxury Bench Seat, 12" Wheels, 4 Wheel Disc Brakes, 160AH Lithium Battery Pack, LED Light Kit, and more.`,
	"image": cartImages,
	"url": currentUrl,
	"sku": cart.stock,
	"brand": {
		"@type": "Brand",
		"name": cart.brand
	},
	"model": cart.model,
	"productionDate": cart.year.toString(),
	"category": "Golf Carts",
	"offers": {
		"@type": "Offer",
		"url": currentUrl,
		"priceCurrency": "USD",
		"price": cart.salePrice || cart.price,
		"priceValidUntil": new Date(new Date().setFullYear(new Date().getFullYear() + 1)).toISOString().split('T')[0],
		"availability": "https://schema.org/InStock",
		"itemCondition": "https://schema.org/NewCondition",
		"seller": {
			"@type": "LocalBusiness",
			"name": "Masters Golf Cars",
			"telephone": "+1-352-307-0111",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "12885 S US Hwy 441",
				"addressLocality": "Belleview",
				"addressRegion": "FL",
				"postalCode": "34420",
				"addressCountry": "US"
			}
		}
	}
};
const price = cart.salePrice || cart.price;
const specs: [string, string][] = [['Year', String(cart.year ?? '')], ['Make', cart.brand ?? ''], ['Model', cart.model ?? ''], ['Type', cart.type ?? ''], ['Seats', String(cart.seats ?? '')], ['Power', cart.power ?? ''], ['Color', cart.color ?? ''], ['Stock #', cart.stock ?? '']].filter(([, v]) => v);
const features: string[] = cart.features ?? [];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Inventory", url: "https://mastersgolfcars.com/golf-cart-inventory" },
	{ name: cart.name, url: currentUrl }
];
---

<Layout title={`${cart.name} - Stock #${cart.stock} - Masters Golf Cars`} description={`${cart.name} for sale at Masters Golf Cars. Stock #${cart.stock}. Sale Price: $${price.toLocaleString()}`} breadcrumbs={crumbs} ogImage={cartImages[0]} quoteHref="#askcart">
	<Schema schema={productSchema} slot="schema" />

	<section class="top white">
		<div class="crumbs small"><a href="/golf-cart-inventory">Carts for sale</a><span>/</span><span style="color:var(--ink)">{cart.name}</span></div>
		<div class="top-grid">
			<div class="stack" style="gap:16px">
				<div class="main-ph"><img src={cartImages[0]} alt={cart.name} width="820" height="520" fetchpriority="high" id="mainimg" /></div>
				{cartImages.length > 1 && <div class="thumbs">{cartImages.map((src: string, i: number) => <button type="button" class:list={['thumb', { on: i === 0 }]} data-src={src}><img src={src} alt={`${cart.name} photo ${i + 1}`} loading="lazy" width="200" height="132" /></button>)}</div>}
			</div>
			<div class="stack" style="gap:28px">
				<Eyebrow>{cart.condition ?? 'New'}{cart.seats ? `, ${cart.seats} passenger` : ''}</Eyebrow>
				<h1 class="h1" style="font-size:44px;line-height:1.04">{cart.name}</h1>
				<div class="row" style="gap:16px;align-items:baseline"><span class="fd" style="font-size:48px;line-height:1">${price.toLocaleString()}</span>{cart.salePrice && cart.salePrice < cart.price && <span class="small" style="text-decoration:line-through">${cart.price.toLocaleString()}</span>}</div>
				{cart.description && <p class="body" style="font-size:17px;line-height:28px">{cart.description}</p>}
				<div class="stack" style="gap:12px"><Btn href="#askcart">Ask about this cart</Btn><div class="row btn-row" style="gap:12px"><Btn href="https://www.sheffieldfinancial.com/" kind="ghost">Apply for financing</Btn><Btn href={companyData.contact.phoneLink} kind="ghost">Call {companyData.contact.phone}</Btn></div></div>
				{specs.length > 0 && <div class="specs">{specs.map(([k, v]) => <div class="spec"><span class="small">{k}</span><span style="font-weight:600">{v}</span></div>)}</div>}
				<div class="check-list" style="gap:12px 24px">{['Inspected and serviced', 'Free year of 24hr Cart Club with new carts', 'Lithium upgrade available', 'Delivery available'].map((t) => <Check>{t}</Check>)}</div>
			</div>
		</div>
	</section>

	{features.length > 0 && <section class="sec paper stack" style="gap:40px"><div class="head"><Eyebrow>What is on it</Eyebrow><h2 class="h2 md">Features and options.</h2></div><div class="check-list" style="grid-template-columns:repeat(3,minmax(0,1fr))">{features.map((f: string) => <Check>{f}</Check>)}</div></section>}

	{similarUnits.length > 0 && <section class="sec white stack" style="gap:48px"><div class="head"><Eyebrow>You might also like</Eyebrow><h2 class="h2 md">More carts in stock.</h2></div><div class="grid3">{similarUnits.slice(0, 3).map((c: any) => <CartCard {...c} />)}</div></section>}

	<FormShell id="askcart" eyebrow="Ask about this cart" heading="Want to see it" accent="in person?" lead="Tell us when works for you and our sales team will get back to you as soon as possible during business hours.">
		<CartInquiryForm pageSource={`cart-${slug}`} idPrefix="cart" stockNumber={cart.stock} cartName={cart.name} placeholder="Best time to visit, trade-in details, financing questions." />
	</FormShell>
</Layout>

<style>
	.top { padding: 40px var(--gx) 72px; background: #fff; display: flex; flex-direction: column; gap: 32px; }
	.crumbs { display: flex; align-items: center; gap: 10px; font-size: 13px; }
	.crumbs a { color: var(--muted); }
	.top-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 64px; align-items: start; }
	.main-ph { height: 520px; overflow: hidden; background: var(--paper); }
	.main-ph img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
	.thumbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
	.thumb { height: 132px; overflow: hidden; background: var(--paper); border: 1px solid var(--line); padding: 0; cursor: pointer; }
	.thumb.on { border: 2px solid var(--ink); }
	.thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.specs { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
	.spec { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
	@media (max-width: 1100px) { .top-grid { grid-template-columns: 1fr; gap: 40px; } .main-ph { height: 400px; } }
	@media (max-width: 760px) { .main-ph { height: 260px; } .thumb { height: 80px; } .thumbs { gap: 8px; } }
</style>
<script>
	const main = document.getElementById('mainimg') as HTMLImageElement | null;
	document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((b) => b.addEventListener('click', () => {
		if (main) main.src = b.dataset.src || main.src;
		document.querySelectorAll('.thumb').forEach((t) => t.classList.remove('on')); b.classList.add('on');
	}));
</script>
