---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/the-villages-golf-cart-rentals.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - The Villages Golf Cart Rentals",
	"description": "Golf cart rentals in The Villages, FL. Serving Spanish Springs, Lake Sumter Landing, Brownwood, and all Villages neighborhoods in Sumter, Marion, and Lake counties.",
	"url": "https://mastersgolfcars.com/the-villages-golf-cart-rentals",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Spanish Springs",
		"Lake Sumter Landing",
		"Brownwood",
		"The Villages",
		"Sumter County",
		"Marion County Villages",
		"Lake County Villages"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "How fast can you deliver to The Villages?",
  "answer": "Often the same or next day when carts are available. Book ahead for holidays and busy event weeks."
 },
 {
  "question": "Is there a delivery fee?",
  "answer": "Delivery is quoted with your reservation based on your address. Call (352) 307-0111 for a quick number."
 },
 {
  "question": "Is there a minimum rental?",
  "answer": "Yes, 3 days. After that, rent by the week, the month or the season."
 },
 {
  "question": "How old do I have to be?",
  "answer": "Renters must be 21 or older with a valid driver license."
 },
 {
  "question": "Can I extend?",
  "answer": "Yes. Call us before your end date and we will extend it if the cart is available."
 }
];

const LEAD = ["Explore The Villages with convenient, reliable golf cart rentals from Masters Golf Cars. We deliver directly to your location and offer flexible rental terms to fit your needs."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals in The Villages, FL", url: "https://mastersgolfcars.com/the-villages-golf-cart-rentals" }
];
---

<Layout title="Golf Cart Rentals in The Villages, FL - Masters Golf Cars" description="Rent a golf cart in The Villages, FL. We offer delivery, flexible rental terms, and premium golf carts for exploring The Villages neighborhoods, shopping centers, and recreational facilities." canonical="https://mastersgolfcars.com/the-villages-golf-cart-rentals" breadcrumbs={crumbs} quoteHref="#reserve">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="city" name="The Villages" slug="the-villages-golf-cart-rentals" eyebrow="Golf cart rentals in The Villages, FL" heading="Golf cart rentals," accent="delivered to your villa." lead={LEAD} img={R + 'yamaha-aisle.jpg'} imgLabel="Every village, Spanish Springs to Eastport" proof={[["pin", "10 miles away", "About 15 minutes from our shop"], ["truck", "Delivered to your door", "Any village, any square"], ["key", "300+ carts", "Availability most weeks"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultLocation="The Villages, FL" />
</Layout>
