---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-hits-ocala.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - HITS Ocala Golf Cart Rentals",
	"description": "Golf cart rentals for HITS Ocala horse shows. Fleet rentals for exhibitors, trainers, and spectators at HITS Post Time Farm and the Ocala Winter Circuit.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-hits-ocala",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"HITS Ocala",
		"HITS Post Time Farm",
		"Ocala Winter Circuit",
		"Marion County",
		"Ocala Horse Country"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	},
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Amanda K."
			},
			"datePublished": "2024-03-15",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "We rent from Masters every Winter Circuit. Good carts. Nice people. They bring it right to our barn row. Makes life so much easier at HITS."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "David M."
			},
			"datePublished": "2024-02-28",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Best cart rental around HITS. They showed up on time. The cart ran great for 6 weeks straight. Will use them next year too."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Megan O."
			},
			"datePublished": "2024-01-20",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Looking for a cart at HITS? Call Masters Golf Cars. Fair prices. Good service. The cart worked perfect all show long."
		}
	]
};

const pageFAQs = [
 {
  "question": "How many carts can you supply?",
  "answer": "Over 300 in the fleet, in 2, 4, 6 passenger and utility. Tell us the size of the event and we will build the mix."
 },
 {
  "question": "How far in advance should I book?",
  "answer": "As early as you can for busy months. A few weeks is usually fine, but big weekends and show weeks fill up."
 },
 {
  "question": "Do you deliver and pick up at the venue?",
  "answer": "Yes. We deliver, stage the carts where you want them, and pick them up when the event ends."
 },
 {
  "question": "Do the carts come fueled?",
  "answer": "Yes. Every cart arrives fueled and keyed, with a contact number in case anything comes up."
 },
 {
  "question": "What are the rates?",
  "answer": "Daily, weekly and event rates, quoted per event. Fill out the form or call (352) 307-0111."
 }
];

const LEAD = ["Heading to HITS Post Time Farm for a horse show? Masters Golf Cars rents golf carts to riders, trainers, and fans. We have been doing this for over 26 years.", "The Ocala Winter Circuit runs from January to April. It is a big deal in Marion County. Our shop on US-441 in Belleview is just a few miles from HITS. We keep more than 300 golf carts ready to go."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals at HITS Ocala", url: "https://mastersgolfcars.com/golf-cart-rentals-hits-ocala" }
];
---

<Layout title="Golf Cart Rentals at HITS Ocala | Masters Golf Cars - Horse Show Rentals" description="Rent golf carts for HITS Ocala horse shows. Fleet rentals for exhibitors, trainers, and spectators. Delivery to HITS grounds. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-hits-ocala" breadcrumbs={crumbs} quoteHref="#fleetquote">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="venue" name="HITS Ocala" slug="golf-cart-rentals-hits-ocala" eyebrow="Golf cart rentals at HITS Ocala" heading="Show week carts," accent="staged at HITS." lead={LEAD} img={R + 'clubcar-row.jpg'} imgLabel="Post Time Farm, exhibitors, trainers and families" proof={[["award", "HITS regulars", "Every winter circuit"], ["truck", "Delivered and staged", "At your barn or stabling"], ["key", "300+ carts", "Any quantity, any week"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultEventType="Equestrian / HITS / Florida Horse Park" />
</Layout>
