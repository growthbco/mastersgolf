---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - HITS Ocala Golf Cart Rentals",
	"description": "Golf cart rentals for HITS Ocala horse shows. Fleet rentals for exhibitors, trainers, and spectators at HITS Post Time Farm and the Ocala Winter Circuit.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-hits-ocala",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"HITS Ocala",
		"HITS Post Time Farm",
		"Ocala Winter Circuit",
		"Marion County",
		"Ocala Horse Country"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	},
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Amanda K."
			},
			"datePublished": "2024-03-15",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "We rent from Masters every Winter Circuit. Good carts. Nice people. They bring it right to our barn row. Makes life so much easier at HITS."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "David M."
			},
			"datePublished": "2024-02-28",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Best cart rental around HITS. They showed up on time. The cart ran great for 6 weeks straight. Will use them next year too."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Megan O."
			},
			"datePublished": "2024-01-20",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Looking for a cart at HITS? Call Masters Golf Cars. Fair prices. Good service. The cart worked perfect all show long."
		}
	]
};
---

<Layout
	title="Golf Cart Rentals at HITS Ocala | Masters Golf Cars - Horse Show Rentals"
	description="Rent golf carts for HITS Ocala horse shows. Fleet rentals for exhibitors, trainers, and spectators. Delivery to HITS grounds. 26+ years experience. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-cart-rentals-hits-ocala"
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Golf Cart Rentals for HITS Ocala</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Heading to <strong>HITS Post Time Farm</strong> for a horse show? <strong>Masters Golf Cars</strong> rents golf carts to riders, trainers, and fans. We have been doing this for over 26 years.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						The <strong>Ocala Winter Circuit</strong> runs from January to April. It is a big deal in <strong>Marion County</strong>. Our shop on <strong>US-441</strong> in Belleview is just a few miles from HITS. We keep more than 300 golf carts ready to go.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/fleet-rentals-quote" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							Request Fleet Quote
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/gallery/golf-cart-fleet-rentals-at-masters-golf-cars_img_v27.webp" alt="Golf cart fleet rentals for HITS Ocala horse shows" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Why Choose Us for HITS -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why HITS Exhibitors Choose Masters Golf Cars</h2>
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-6">
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">We Know the Winter Circuit</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							The <strong>HITS Ocala Winter Circuit</strong> brings top riders from all over. Some show for one week. Others stay for months. We get it. <strong>Masters Golf Cars</strong> works with your show dates. Need to add more weeks? No problem.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">We Bring Carts to HITS</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Our drivers know <strong>HITS Post Time Farm</strong> well. Tell us your barn number. We drop off your cart right there. No need to come to us. The grounds are big. Our team knows the way around.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Lots of Carts Ready</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							We have over 300 golf carts. Need just one? We got you. Need 20 for your whole barn? We can do that too. <strong>Masters Golf Cars</strong> has been in business since 1999. We know how to handle big events.
						</p>
					</div>
				</div>
				<div>
					<div class="bg-white rounded-lg p-8 shadow-lg mb-6">
						<h3 class="text-xl font-bold text-gray-900 mb-4">HITS Shows We Serve</h3>
						<ul class="space-y-2 text-gray-700 font-semibold mb-6">
							<li>&#10003; Ocala Winter Circuit</li>
							<li>&#10003; HITS Championship Series</li>
							<li>&#10003; Hunter/Jumper Weeks</li>
							<li>&#10003; Grand Prix Events</li>
							<li>&#10003; Junior/Amateur Classes</li>
							<li>&#10003; Pony Finals Qualifiers</li>
							<li>&#10003; Medal Finals</li>
							<li>&#10003; Year-Round Shows</li>
						</ul>
					</div>
					<div class="bg-brand-green text-white rounded-lg p-8">
						<h3 class="text-xl font-bold mb-4">Save Money on Long Rentals</h3>
						<p class="mb-4 font-semibold">
							Showing for many weeks? We give better prices for longer rentals. Call early to lock in your rate. The Winter Circuit books up fast.
						</p>
						<a href="/fleet-rentals-quote" class="inline-block bg-black text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-900 transition">
							Get a Custom Quote
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Cart Options -->
	<section class="py-16 bg-brand-green text-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">Golf Carts We Rent for HITS Shows</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-white rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" alt="2-passenger golf cart for HITS" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">2-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm">
						Good for riders and trainers. Fits through barn aisles. Easy to park near the rings.
					</p>
					<ul class="space-y-1 font-semibold text-sm text-left max-w-xs mx-auto">
						<li>&#8226; Small and quick</li>
						<li>&#8226; Good for quick trips</li>
						<li>&#8226; Easy to drive</li>
					</ul>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-white rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/4-seater-golf-cart_img_v64_250813_142836603.webp" alt="4-passenger golf cart for horse shows" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">4-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm">
						The one most people pick. Great for trainers with students or families watching the show.
					</p>
					<ul class="space-y-1 font-semibold text-sm text-left max-w-xs mx-auto">
						<li>&#8226; Most popular choice</li>
						<li>&#8226; Room for bags</li>
						<li>&#8226; All-day comfort</li>
					</ul>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-white rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" alt="6-passenger golf cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">6-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm">
						Big barns love this one. Move your whole team at once. Great for busy trainers.
					</p>
					<ul class="space-y-1 font-semibold text-sm text-left max-w-xs mx-auto">
						<li>&#8226; Seats six people</li>
						<li>&#8226; Good for groups</li>
						<li>&#8226; Client rides</li>
					</ul>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-white rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/utility-cart_img_v66_250813_142912878.webp" alt="Utility golf cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Utility Cart</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm">
						Need to haul stuff? This one has a big bed. Carry tack trunks, feed, and gear.
					</p>
					<ul class="space-y-1 font-semibold text-sm text-left max-w-xs mx-auto">
						<li>&#8226; Big cargo area</li>
						<li>&#8226; Built for work</li>
						<li>&#8226; Heavy loads OK</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- About HITS Ocala -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div>
					<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-6">About HITS Post Time Farm</h2>
					<p class="text-gray-700 leading-relaxed font-semibold mb-4">
						<strong>HITS Post Time Farm</strong> sits in Ocala, Florida. It is home to the famous <strong>Ocala Winter Circuit</strong>. Top hunter/jumper riders from all over come here. The shows run from January through April.
					</p>
					<p class="text-gray-700 leading-relaxed font-semibold mb-4">
						The farm has a Grand Prix ring, warm-up areas, and space for 1,500 horses. Big events like the <strong>$1 Million Grand Prix</strong> happen here. Riders compete for prize money and points all season.
					</p>
					<p class="text-gray-700 leading-relaxed font-semibold mb-6">
						The grounds spread out. Getting around on foot takes forever. That is why most people rent a golf cart. <strong>Masters Golf Cars</strong> brings yours right to your barn.
					</p>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<p class="text-3xl font-bold text-brand-green mb-1">4+</p>
							<p class="text-gray-700 font-semibold text-sm">Month Season</p>
						</div>
						<div>
							<p class="text-3xl font-bold text-brand-green mb-1">12+</p>
							<p class="text-gray-700 font-semibold text-sm">Show Weeks</p>
						</div>
						<div>
							<p class="text-3xl font-bold text-brand-green mb-1">$1M+</p>
							<p class="text-gray-700 font-semibold text-sm">Grand Prix Prize</p>
						</div>
						<div>
							<p class="text-3xl font-bold text-brand-green mb-1">1,500+</p>
							<p class="text-gray-700 font-semibold text-sm">Horse Stalls</p>
						</div>
					</div>
				</div>
				<div>
					<img src="/images/gallery/golf-cart-fleet-rental-delivery_img_v35.webp" alt="Golf cart fleet delivery for HITS Ocala" class="w-full h-auto rounded-lg shadow-lg mb-6" loading="lazy" width="800" height="600" />
					<img src="/images/logos/masters-golf-cars-fleet-rentals_img_v36.webp" alt="Masters Golf Cars fleet" class="w-full h-auto rounded-lg shadow-lg" loading="lazy" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- How It Works -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">How to Rent Golf Carts for HITS</h2>
			<div class="grid md:grid-cols-2 gap-12 items-start">
				<div class="space-y-8">
					<div class="flex gap-4">
						<div class="flex-shrink-0 w-12 h-12 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-xl">1</div>
						<div>
							<h3 class="text-xl font-bold text-gray-900 mb-2">Call or Email Early</h3>
							<p class="text-gray-700 font-semibold">
								Tell us which weeks you are showing. The <strong>Winter Circuit</strong> books fast. The sooner you call, the better your chance of getting what you want.
							</p>
						</div>
					</div>
					<div class="flex gap-4">
						<div class="flex-shrink-0 w-12 h-12 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-xl">2</div>
						<div>
							<h3 class="text-xl font-bold text-gray-900 mb-2">Pick Your Dates</h3>
							<p class="text-gray-700 font-semibold">
								We will give you a price. Plans change? No problem. We can add or drop weeks during the circuit. Just let us know.
							</p>
						</div>
					</div>
					<div class="flex gap-4">
						<div class="flex-shrink-0 w-12 h-12 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-xl">3</div>
						<div>
							<h3 class="text-xl font-bold text-gray-900 mb-2">We Bring Your Cart</h3>
							<p class="text-gray-700 font-semibold">
								Our team brings your golf cart to <strong>HITS Post Time Farm</strong>. It shows up with gas and ready to go. We drop it at your barn.
							</p>
						</div>
					</div>
					<div class="flex gap-4">
						<div class="flex-shrink-0 w-12 h-12 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-xl">4</div>
						<div>
							<h3 class="text-xl font-bold text-gray-900 mb-2">We Pick It Up</h3>
							<p class="text-gray-700 font-semibold">
								When your show weeks end, just call. We come get the cart. Need to stay longer? We can stretch your rental easy.
							</p>
						</div>
					</div>
				</div>
				<div>
					<img src="/images/gallery/02-04-2025-14-23-09_23.webp" alt="Golf cart delivery" class="w-full h-auto rounded-lg shadow-lg mb-8" loading="lazy" width="800" height="600" />
					<div class="bg-white rounded-lg p-8 shadow-lg">
						<h3 class="text-2xl font-bold text-gray-900 mb-4">What You Need to Rent</h3>
						<ul class="space-y-3 text-gray-700 font-semibold mb-6">
							<li>&#8226; Be at least 21 years old</li>
							<li>&#8226; Have a driver's license</li>
							<li>&#8226; Have a credit card</li>
							<li>&#8226; Book ahead for best selection</li>
							<li>&#8226; Ask about multi-week deals</li>
						</ul>
						<a href="/fleet-rentals-quote" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition w-full text-center">
							Request a Fleet Quote
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Testimonials -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h3 class="text-3xl font-black text-gray-900 text-center mb-4">What HITS Riders Say About Us</h3>
			<div class="flex justify-center gap-1 mb-12">
				{Array.from({ length: 5 }).map((_star, index) => (
					<svg class="w-6 h-6" fill="#FFD700" viewBox="0 0 20 20">
						<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
					</svg>
				))}
			</div>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-gray-50 rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"We rent from Masters every Winter Circuit. Good carts. Nice people. They bring it right to our barn row. Makes life so much easier at HITS."
					</p>
					<p class="font-black text-gray-900">-Amanda K., Pro Trainer</p>
				</div>
				<div class="bg-gray-50 rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"Best cart rental around HITS. They showed up on time. The cart ran great for 6 weeks straight. Will use them next year too."
					</p>
					<p class="font-black text-gray-900">-David M., Barn Owner</p>
				</div>
				<div class="bg-gray-50 rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"Looking for a cart at HITS? Call Masters Golf Cars. Fair prices. Good service. The cart worked perfect all show long."
					</p>
					<p class="font-black text-gray-900">-Megan O., Amateur Rider</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Related Services -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Ways We Can Help</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">WEC Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Showing at <strong>World Equestrian Center</strong> too? We rent there as well. Same easy service.
						</p>
						<a href="/golf-cart-rentals-wec" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							WEC Rentals
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Fleet Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Have a big barn? We do group deals. Learn more about renting many carts at once.
						</p>
						<a href="/fleet-rentals-quote" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Fleet Rental Info
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Carts for Sale</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Want your own cart? We sell <strong>Club Car</strong>, <strong>Yamaha</strong>, <strong>EZ-GO</strong>, and more. New and used.
						</p>
						<a href="/golf-carts-for-sale-ocala" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							View Inventory
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Location Section -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid gap-10 lg:grid-cols-[1fr,1fr] items-start">
				<div class="space-y-4">
					<h2 class="text-3xl font-bold text-gray-900">Easy to Find - Close to HITS</h2>
					<p class="text-gray-600">
						<strong>Masters Golf Cars</strong> sits at <strong>12885 S US Highway 441 in Belleview</strong>. We are between <strong>Ocala</strong> and <strong>The Villages</strong>. Look for us across from the <strong>Market of Marion</strong>.
