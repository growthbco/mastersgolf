---
import Layout from '../layouts/Layout.astro';
import companyData from '../data/company.json';
---

<Layout title="Rent a Golf Cart - Masters Golf Cars" description="Reserve your golf cart rental today. Fill out our form and our rental manager will check availability and contact you promptly.">
	<!-- Hero Section -->
	<section class="bg-white py-12">
		<div class="container mx-auto px-4 max-w-6xl">
			<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-6">Reserve Your Golf Cart Rental</h1>
			<p class="text-gray-700 text-lg mb-8 font-semibold">
				Please fill out the form below. Our rental manager will check availability and contact you promptly.
			</p>
			
			<!-- Service Areas -->
			<div class="mb-10">
				<h2 class="text-2xl font-black text-gray-900 mb-4">Service Areas</h2>
				<p class="text-gray-700 mb-4 font-semibold">
					Below is a list of areas we service in Marion County, Sumter County, Lake County, Alachua County:
				</p>
				<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 mb-6">
					<div class="text-gray-700 font-semibold">The Villages</div>
					<div class="text-gray-700 font-semibold">Ocala</div>
					<div class="text-gray-700 font-semibold">Woodfields</div>
					<div class="text-gray-700 font-semibold">HITS Ocala</div>
					<div class="text-gray-700 font-semibold">Gainesville</div>
					<div class="text-gray-700 font-semibold">Belleview</div>
					<div class="text-gray-700 font-semibold">Downtown Ocala</div>
					<div class="text-gray-700 font-semibold">And More!</div>
				</div>
				<p class="text-gray-700 font-semibold">
					Call us at <a href="tel:3523070111" class="text-brand-green hover:underline font-bold">(352) 307-0111</a> or come by today and experience our superior service and selection! We look forward to serving you!
				</p>
			</div>

			<!-- Golf Cart Options -->
			<div class="mb-10">
				<h2 class="text-2xl font-black text-gray-900 mb-6 text-center">Choose Your Golf Cart</h2>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
					<div class="text-center">
						<img src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" alt="2-seater golf cart" class="w-full h-48 object-cover rounded-lg mb-3" loading="lazy" width="400" height="192" />
						<p class="font-semibold text-gray-800">2-Seater Cart</p>
					</div>
					<div class="text-center">
						<img src="/images/golf-cart-rentals-page/4-seater-golf-cart_img_v64_250813_142836603.webp" alt="4-seater golf cart" class="w-full h-48 object-cover rounded-lg mb-3" loading="lazy" width="400" height="192" />
						<p class="font-semibold text-gray-800">4-Seater Cart</p>
					</div>
					<div class="text-center">
						<img src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" alt="6-seater golf cart" class="w-full h-48 object-cover rounded-lg mb-3" loading="lazy" width="400" height="192" />
						<p class="font-semibold text-gray-800">6-Seater Cart</p>
					</div>
					<div class="text-center">
						<img src="/images/golf-cart-rentals-page/utility-cart_img_v66_250813_142912878.webp" alt="Utility golf cart" class="w-full h-48 object-cover rounded-lg mb-3" loading="lazy" width="400" height="192" />
						<p class="font-semibold text-gray-800">Utility Cart</p>
					</div>
				</div>
			</div>

			<!-- Rental Inquiry Form -->
			<div class="bg-gray-50 rounded-lg p-6 md:p-10 mb-10">
				<h2 class="text-2xl font-black text-gray-900 mb-6">Rental Inquiry Form</h2>
				<div class="bg-white rounded-lg p-6 md:p-8">
					<form
						name="rental-inquiry"
						method="POST"
						data-netlify="true"
						netlify-honeypot="bot-field"
						action="/success"
						class="space-y-5"
					>
						<input type="hidden" name="form-name" value="rental-inquiry" />
						<p class="hidden">
							<label>Don't fill this out if you're human: <input name="bot-field" /></label>
						</p>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="rental-name" class="block text-sm font-bold text-gray-900 mb-1">Full Name <span class="text-red-600">*</span></label>
								<input type="text" id="rental-name" name="name" required placeholder="Your name" autocomplete="name" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
							<div>
								<label for="rental-phone" class="block text-sm font-bold text-gray-900 mb-1">Phone <span class="text-red-600">*</span></label>
								<input type="tel" id="rental-phone" name="phone" required placeholder="(352) 555-1234" autocomplete="tel" inputmode="tel" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div>
							<label for="rental-email" class="block text-sm font-bold text-gray-900 mb-1">Email <span class="text-red-600">*</span></label>
							<input type="email" id="rental-email" name="email" required placeholder="you@email.com" autocomplete="email" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="rental-cart-type" class="block text-sm font-bold text-gray-900 mb-1">Cart Type <span class="text-red-600">*</span></label>
								<select id="rental-cart-type" name="cart_type" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none">
									<option value="">Select cart...</option>
									<option value="2-Seater">2-Seater</option>
									<option value="4-Seater">4-Seater</option>
									<option value="6-Seater">6-Seater</option>
									<option value="Utility Cart">Utility Cart</option>
									<option value="Not sure">Not sure</option>
								</select>
							</div>
							<div>
								<label for="rental-cart-qty" class="block text-sm font-bold text-gray-900 mb-1"># of Carts</label>
								<input type="number" id="rental-cart-qty" name="cart_quantity" min="1" placeholder="1" inputmode="numeric" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="rental-start" class="block text-sm font-bold text-gray-900 mb-1">Start Date <span class="text-red-600">*</span></label>
								<input type="date" id="rental-start" name="start_date" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
							<div>
								<label for="rental-end" class="block text-sm font-bold text-gray-900 mb-1">End Date <span class="text-red-600">*</span></label>
								<input type="date" id="rental-end" name="end_date" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div>
							<label for="rental-delivery" class="block text-sm font-bold text-gray-900 mb-1">Delivery Address / Location <span class="text-red-600">*</span></label>
							<input type="text" id="rental-delivery" name="delivery_address" required placeholder="Street, city, community, or venue" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
						</div>

						<div>
							<label for="rental-notes" class="block text-sm font-bold text-gray-900 mb-1">Additional Notes</label>
							<textarea id="rental-notes" name="notes" rows="4" placeholder="Anything else we should know about your rental." class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none"></textarea>
						</div>

						<div class="flex items-start gap-3 pt-1">
							<input type="checkbox" id="rental-sms-consent" name="sms_consent" value="yes" class="mt-1 h-4 w-4 rounded border-gray-400 text-brand-green focus:ring-brand-green" />
							<label for="rental-sms-consent" class="text-sm text-gray-700 leading-relaxed">
								I agree to receive SMS text messages from Masters Golf Cars in response to this inquiry, including appointment reminders, service updates, quotes, and follow-up communications. Message frequency varies. Msg and data rates may apply. Reply STOP to opt out or HELP for help. Consent is not a condition of purchase. See our <a href="/privacy-policy" class="text-brand-green font-bold underline hover:opacity-80">Privacy Policy</a> and <a href="/terms-conditions" class="text-brand-green font-bold underline hover:opacity-80">Terms and Conditions</a>.
							</label>
						</div>

						<button type="submit" class="w-full bg-brand-green text-white font-bold uppercase tracking-wide py-3 px-4 rounded-md hover:opacity-90 transition-colors">
							Check Availability
						</button>

						<p class="text-center text-xs text-gray-500">
							Your information is secure and will never be shared.
						</p>
					</form>
				</div>
			</div>
		</div>
	</section>

	<!-- Location Section -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl font-black text-gray-900 text-center mb-4">Visit Our Location</h2>
			<p class="text-center text-gray-700 mb-8 font-semibold">
				We are located between Ocala and The Villages right on 441 across from the Market of Marion.<br />
				{companyData.location.full}
			</p>
			<div class="max-w-4xl mx-auto rounded-2xl overflow-hidden shadow-xl border border-gray-200">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6976.811623455518!2d-82.025011!3d29.034576000000005!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88e7cfcec122cd0d%3A0x530a32876eeda9ee!2sMasters%20Golf%20Cars!5e0!3m2!1sen!2sus!4v1762801860534!5m2!1sen!2sus"
					width="100%"
					height="450"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</div>
		</div>
	</section>
</Layout>
