---
import Layout from '../layouts/Layout.astro';
import companyData from '../data/company.json';
---

<Layout title="Golf Cart Rentals - Masters Golf Cars" description="Rent golf carts for events and daily use in Central Florida">
	<!-- Hero Section -->
	<section style="background: linear-gradient(to right, #86CA26, var(--gradient-end, #6fa020));" class="bg-gradient-to-br  to-#5a8019 text-white py-20">
		<div class="container mx-auto px-4">
			<h1 class="text-5xl font-bold mb-6">Reserve Your Golf Cart Rental</h1>
			<p style="color: rgba(134, 202, 38, 0.1);" class="text-xl mb-8 (134, 202, 38, 0.1)">
				Whether you need a single cart or want to explore our neighborhood rental options,
				we have flexible rental packages to fit your needs.
			</p>
			<a href="/rent-a-golf-cart" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white text-gray-900 font-bold uppercase tracking-wide hover:bg-gray-100 transition text-lg shadow-lg">
				Request a Rental
			</a>
		</div>
	</section>

	<!-- Cart Types -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<h2 class="text-4xl font-bold text-center mb-12 text-gray-900">
				Choose Your Golf Cart
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<img 
						src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" 
						alt="2 Seater Golf Cart" 
						class="w-full h-48 object-contain rounded-lg mb-4"
						loading="lazy"
						width="400"
						height="300"
					/>
					<h3 class="text-xl font-bold mb-2">2-Seater Cart</h3>
					<p class="text-gray-600">Perfect for couples or individuals exploring the neighborhood</p>
				</div>
				
				<div class="text-center">
					<img 
						src="/images/golf-cart-rentals-page/4-seater-golf-cart_img_v64_250813_142836603.webp" 
						alt="4 Seater Golf Cart" 
						class="w-full h-48 object-contain rounded-lg mb-4"
						loading="lazy"
						width="400"
						height="300"
					/>
					<h3 class="text-xl font-bold mb-2">4-Seater Cart</h3>
					<p class="text-gray-600">Spacious seating for small groups and families</p>
				</div>
				
				<div class="text-center">
					<img 
						src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" 
						alt="6 Seater Golf Cart" 
						class="w-full h-48 object-contain rounded-lg mb-4"
						loading="lazy"
						width="400"
						height="300"
					/>
					<h3 class="text-xl font-bold mb-2">6-Seater Cart</h3>
					<p class="text-gray-600">Ideal for larger groups and events</p>
				</div>
				
				<div class="text-center">
					<img 
						src="/images/golf-cart-rentals-page/utility-cart_img_v66_250813_142912878.webp" 
						alt="Utility Cart" 
						class="w-full h-48 object-contain rounded-lg mb-4"
						loading="lazy"
						width="400"
						height="300"
					/>
					<h3 class="text-xl font-bold mb-2">Utility Cart</h3>
					<p class="text-gray-600">Built for work and convenience</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Areas Served -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<h2 class="text-4xl font-bold text-center mb-12 text-gray-900">
				Areas We Serve
			</h2>
			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
				<div class="bg-white p-4 rounded-lg text-center">
					<h4 class="font-semibold text-gray-900">The Villages</h4>
				</div>
				<div class="bg-white p-4 rounded-lg text-center">
					<h4 class="font-semibold text-gray-900">Ocala</h4>
				</div>
				<div class="bg-white p-4 rounded-lg text-center">
					<h4 class="font-semibold text-gray-900">Downtown Ocala</h4>
				</div>
				<div class="bg-white p-4 rounded-lg text-center">
					<h4 class="font-semibold text-gray-900">Gainesville</h4>
				</div>
				<div class="bg-white p-4 rounded-lg text-center">
					<h4 class="font-semibold text-gray-900">Belleview</h4>
				</div>
				<div class="bg-white p-4 rounded-lg text-center">
					<h4 class="font-semibold text-gray-900">WEC</h4>
				</div>
				<div class="bg-white p-4 rounded-lg text-center">
					<h4 class="font-semibold text-gray-900">HITS Ocala</h4>
				</div>
				<div class="bg-white p-4 rounded-lg text-center">
					<h4 class="font-semibold text-gray-900">And More!</h4>
				</div>
			</div>
			<p class="text-center text-gray-600 mt-8">
				We proudly serve Marion County, Sumter County, Lake County, and Alachua County
			</p>
		</div>
	</section>

	<!-- Rental Form -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<h2 class="text-4xl font-bold mb-6 text-gray-900 text-center">Ready to Rent?</h2>
				<p class="text-xl text-gray-600 mb-8 text-center">
					Fill out our rental form below and our rental manager will check availability 
					and contact you promptly.
				</p>
				<div class="bg-white rounded-lg p-6 md:p-8 shadow-lg">
					<form
						name="rental-inquiry"
						method="POST"
						data-netlify="true"
						netlify-honeypot="bot-field"
						action="/success"
						class="space-y-5"
					>
						<input type="hidden" name="form-name" value="rental-inquiry" />
						<p class="hidden">
							<label>Don't fill this out if you're human: <input name="bot-field" /></label>
						</p>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="rentals-name" class="block text-sm font-bold text-gray-900 mb-1">Full Name <span class="text-red-600">*</span></label>
								<input type="text" id="rentals-name" name="name" required placeholder="Your name" autocomplete="name" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
							<div>
								<label for="rentals-phone" class="block text-sm font-bold text-gray-900 mb-1">Phone <span class="text-red-600">*</span></label>
								<input type="tel" id="rentals-phone" name="phone" required placeholder="(352) 555-1234" autocomplete="tel" inputmode="tel" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div>
							<label for="rentals-email" class="block text-sm font-bold text-gray-900 mb-1">Email <span class="text-red-600">*</span></label>
							<input type="email" id="rentals-email" name="email" required placeholder="you@email.com" autocomplete="email" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="rentals-cart-type" class="block text-sm font-bold text-gray-900 mb-1">Cart Type <span class="text-red-600">*</span></label>
								<select id="rentals-cart-type" name="cart_type" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none">
									<option value="">Select cart...</option>
									<option value="2-Seater">2-Seater</option>
									<option value="4-Seater">4-Seater</option>
									<option value="6-Seater">6-Seater</option>
									<option value="Utility Cart">Utility Cart</option>
									<option value="Not sure">Not sure</option>
								</select>
							</div>
							<div>
								<label for="rentals-cart-qty" class="block text-sm font-bold text-gray-900 mb-1"># of Carts</label>
								<input type="number" id="rentals-cart-qty" name="cart_quantity" min="1" placeholder="1" inputmode="numeric" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="rentals-start" class="block text-sm font-bold text-gray-900 mb-1">Start Date <span class="text-red-600">*</span></label>
								<input type="date" id="rentals-start" name="start_date" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
							<div>
								<label for="rentals-end" class="block text-sm font-bold text-gray-900 mb-1">End Date <span class="text-red-600">*</span></label>
								<input type="date" id="rentals-end" name="end_date" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div>
							<label for="rentals-delivery" class="block text-sm font-bold text-gray-900 mb-1">Delivery Address / Location <span class="text-red-600">*</span></label>
							<input type="text" id="rentals-delivery" name="delivery_address" required placeholder="Street, city, community, or venue" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
						</div>

						<div>
							<label for="rentals-notes" class="block text-sm font-bold text-gray-900 mb-1">Additional Notes</label>
							<textarea id="rentals-notes" name="notes" rows="4" placeholder="Anything else we should know about your rental." class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none"></textarea>
						</div>

						<div class="flex items-start gap-3 pt-1">
							<input type="checkbox" id="rentals-sms-consent" name="sms_consent" value="yes" class="mt-1 h-4 w-4 rounded border-gray-400 text-brand-green focus:ring-brand-green" />
							<label for="rentals-sms-consent" class="text-sm text-gray-700 leading-relaxed">
								I agree to receive SMS text messages from Masters Golf Cars in response to this inquiry, including appointment reminders, service updates, quotes, and follow-up communications. Message frequency varies. Msg and data rates may apply. Reply STOP to opt out or HELP for help. Consent is not a condition of purchase. See our <a href="/privacy-policy" class="text-brand-green font-bold underline hover:opacity-80">Privacy Policy</a> and <a href="/terms-conditions" class="text-brand-green font-bold underline hover:opacity-80">Terms and Conditions</a>.
							</label>
						</div>

						<button type="submit" class="w-full bg-brand-green text-white font-bold uppercase tracking-wide py-3 px-4 rounded-md hover:opacity-90 transition-colors">
							Check Availability
						</button>

						<p class="text-center text-xs text-gray-500">
							Your information is secure and will never be shared.
						</p>
					</form>
				</div>
			</div>
		</div>
	</section>

	<!-- Contact Info -->
	<section class="py-16 bg-gray-900 text-white">
		<div class="container mx-auto px-4 text-center">
			<h2 class="text-3xl font-bold mb-4">Have Questions?</h2>
			<p class="text-xl mb-6 text-gray-400">
				Call us at <a href={companyData.contact.phoneLink} class="hover:underline font-semibold text-white">
					{companyData.contact.phone}
				</a> or come by today
			</p>
			<p class="text-gray-400">
				{companyData.location.full}
			</p>
		</div>
	</section>
</Layout>

