---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-weddings.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Wedding Golf Cart Rentals",
	"description": "Golf cart rentals for weddings in Central Florida. Serving The Villages, Ocala, Marion County, and surrounding areas. Perfect for outdoor weddings, reception venues, and vineyard celebrations.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-weddings",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"The Villages",
		"Ocala",
		"Belleview",
		"Marion County",
		"Sumter County",
		"Lake County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	},
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Jennifer M."
			},
			"datePublished": "2024-11-15",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Perfect addition to our outdoor wedding at Citra Royal Palm RV Park! The decorated golf cart made for amazing photos and our guests loved the shuttle service."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Amanda & David"
			},
			"datePublished": "2024-09-28",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Masters Golf Cars provided 4 carts for our vineyard wedding near Ocala. The delivery was seamless and the carts were beautiful. Highly recommend!"
		}
	]
};

const pageFAQs = [
 {
  "question": "How many carts can you supply?",
  "answer": "Over 300 in the fleet, in 2, 4, 6 passenger and utility. Tell us the size of the event and we will build the mix."
 },
 {
  "question": "How far in advance should I book?",
  "answer": "As early as you can for busy months. A few weeks is usually fine, but big weekends and show weeks fill up."
 },
 {
  "question": "Do you deliver and pick up at the venue?",
  "answer": "Yes. We deliver, stage the carts where you want them, and pick them up when the event ends."
 },
 {
  "question": "Do the carts come fueled?",
  "answer": "Yes. Every cart arrives fueled and keyed, with a contact number in case anything comes up."
 },
 {
  "question": "What are the rates?",
  "answer": "Daily, weekly and event rates, quoted per event. Fill out the form or call (352) 307-0111."
 }
];

const LEAD = ["Make your special day unforgettable with golf cart rentals from Masters Golf Cars. Since 1999, we've helped couples throughout Central Florida create magical wedding experiences at venues like Citra Royal Palm RV Park, World Equestrian Center, Florida Horse Park, and beautiful vineyard venues near Ocala.", "Golf carts are perfect for outdoor weddings, transporting guests between ceremony and reception sites, bridal party transportation, and creating memorable photo opportunities. Our fleet includes elegant options for the bride and groom, plus practical carts for guest shuttles."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Wedding Golf Cart Rentals in Central Florida", url: "https://mastersgolfcars.com/golf-cart-rentals-weddings" }
];
---

<Layout title="Wedding Golf Cart Rentals in Central Florida | Masters Golf Cars" description="Rent golf carts for weddings in Central Florida. Perfect for outdoor ceremonies, vineyard weddings, and reception transportation. Delivery to Ocala, The Villages & more. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-weddings" breadcrumbs={crumbs} quoteHref="#fleetquote">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="event" name="weddings" slug="golf-cart-rentals-weddings" eyebrow="Wedding golf cart rentals, Central Florida" heading="Get your guests" accent="to the ceremony." lead={LEAD} img={R + 'cart-6p.jpg'} imgLabel="Six passenger shuttles for guests, two passengers for the couple" proof={[["users", "Guest shuttles", "6 passenger carts for the aisle to the tent"], ["truck", "Delivered and staged", "At the venue before guests arrive"], ["calendar", "Day or weekend rates", "Rehearsal to send off"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultEventType="Wedding" faqTitle="Wedding questions." />
</Layout>
