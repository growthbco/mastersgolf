import ServicePage from '../components/sections/ServicePage.astro';
import local from '../data/locations/golf-cart-repairs-ocala.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Ocala Golf Cart Repairs",
	"description": "Golf cart repair service in Ocala, FL. Serving Ocala Palms, Golden Ocala, Woodfields, Stonecrest, Rolling Greens, On Top of The World, and all of Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-repairs-ocala",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Ocala Palms",
		"Golden Ocala",
		"Woodfields",
		"Stonecrest",
		"Rolling Greens",
		"On Top of The World",
		"Country Club of Ocala",
		"Oak Run",
		"Downtown Ocala",
		"Silver Springs",
		"Belleview",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
const repairOcalaFAQs = [
	{
		question: "Where can I get golf cart repair near Ocala?",
		answer: "Masters Golf Cars offers golf cart service and repairs just south of Ocala at 12885 S US Hwy 441, Belleview, FL 34420. We are a family-run business that has served the Ocala area since 1999. Call (352) 307-0111 to schedule a repair."
	},
	{
		question: "Is Masters Golf Cars a reputable golf cart repair shop near Ocala?",
		answer: "Masters Golf Cars is a family-run, established Central Florida dealer and service shop that has operated since 1999. We handle golf cart service and repairs for customers across Marion, Sumter, Lake, and Alachua counties."
	},
	{
		question: "What golf cart brands does Masters Golf Cars service?",
		answer: "We service Club Car, Yamaha, and EZ-GO golf carts, and we install Trojan batteries. Reach our service team at (352) 307-0111."
	},
	{
		question: "What areas do you serve for golf cart repairs?",
		answer: "We serve Ocala, Belleview, The Villages, Gainesville, and the surrounding Central Florida communities across Marion, Sumter, Lake, and Alachua counties."
	},
	{
		question: "What are your service hours and where are you located?",
		answer: "Our shop is at 12885 S US Hwy 441, Belleview, FL 34420, across from the Market of Marion. We are open Monday through Friday 8:30am to 5:00pm and Saturday 9:00am to 2:00pm."
	}
];

const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Repairs", url: "https://mastersgolfcars.com/golf-cart-repairs" },
	{ name: "Ocala", url: "https://mastersgolfcars.com/golf-cart-repairs-ocala" }
];
---

<Layout title="Golf Cart Repairs in Ocala, FL | Masters Golf Cars - 24-Hour Service" description="Fast golf cart repairs in Ocala, FL. Serving Ocala Palms, Golden Ocala, Woodfields & more. 24-hour turnaround. Pickup & delivery. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-repairs-ocala" breadcrumbs={crumbs} quoteHref="#schedule">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={repairOcalaFAQs} />
	<ServicePage city="Ocala" pageSource="golf-cart-repairs-ocala" faqs={repairOcalaFAQs} local={local} defaultLocation="Ocala, FL" />
</Layout>
