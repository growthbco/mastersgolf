---
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Icon from '../../components/ui/Icon.astro';
import { blogPosts } from '../../lib/posts';
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const [feat, ...rest] = blogPosts;
const crumbs = [{ name: "Home", url: "https://mastersgolfcars.com" }, { name: "Blog", url: "https://mastersgolfcars.com/blog" }];
---

<Layout title="Golf Cart Blog - Tips, Guides & News | Masters Golf Cars" description="Expert golf cart tips, buying guides, maintenance advice, and local insights from Masters Golf Cars. Serving The Villages, Ocala, and Central Florida since 1999." breadcrumbs={crumbs}>
	<section class="sec paper" style="padding-top:72px;padding-bottom:56px"><div class="head"><Eyebrow>Blog</Eyebrow><h1 class="h1" style="font-size:64px">Notes from the shop.</h1><p class="lead">Plain answers about renting, owning and powering a golf cart in Central Florida.</p></div></section>
	<section class="sec white" style="padding-top:0">
		<a href={`/blog/${feat.slug}`} class="feat">
			<div class="fph"><img src={feat.image} alt={feat.title} width="760" height="460" /></div>
			<div class="stack" style="gap:20px"><div class="meta"><span>{feat.category}</span><span class="small">{fmt(feat.date)}</span></div><h2 class="h2 md">{feat.title}</h2><p class="body" style="font-size:17px;line-height:28px">{feat.excerpt}</p><span class="read">Read the guide<Icon name="arrow" size={16} /></span></div>
		</a>
	</section>
	<section class="sec paper stack" style="gap:48px">
		<div class="head"><Eyebrow>More posts</Eyebrow><h2 class="h2 md">Recent.</h2></div>
		<div class="grid4" style="gap:32px">{rest.map((p) => <a href={`/blog/${p.slug}`} class="stack" style="gap:18px;color:var(--ink)"><div class="cph"><img src={p.image} alt={p.title} loading="lazy" width="420" height="240" /></div><div class="meta"><span>{p.category}</span><span class="small">{fmt(p.date)}</span></div><h3 class="h3">{p.title}</h3><p class="body" style="font-size:15px;line-height:24px">{p.excerpt}</p></a>)}</div>
	</section>
</Layout>
<style>
	.feat { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; color: var(--ink); }
	.fph { height: 460px; overflow: hidden; background: var(--paper); }
	.fph img, .cph img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.cph { height: 240px; overflow: hidden; background: #fff; }
	.meta { display: flex; align-items: center; gap: 14px; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--green-ink); }
	.read { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
	@media (max-width: 1100px) { .feat { grid-template-columns: 1fr; gap: 28px; } .fph { height: 320px; } .h1 { font-size: 44px !important; } }
	@media (max-width: 760px) { .fph { height: 220px; } .h1 { font-size: 36px !important; } }
</style>
