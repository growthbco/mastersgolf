---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import ServicePage from '../components/sections/ServicePage.astro';
import local from '../data/locations/golf-cart-repairs-gainesville.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Gainesville Golf Cart Repairs",
	"description": "Golf cart repair service in Gainesville, FL. Serving Haile Plantation, Tioga, Archer, University of Florida area, and all of Alachua County.",
	"url": "https://mastersgolfcars.com/golf-cart-repairs-gainesville",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Haile Plantation",
		"Tioga",
		"Archer",
		"University of Florida",
		"Newberry",
		"Downtown Gainesville",
		"Alachua County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "Do you pick up golf carts in Gainesville?",
  "answer": "Yes. Our driver can collect your cart from your Gainesville address and bring it back when the work is done. Ask when you schedule."
 },
 {
  "question": "How long will it take?",
  "answer": "Most repairs are finished within 24 hours of your approval. Your estimate will tell you if yours needs longer."
 },
 {
  "question": "What carts do you work on?",
  "answer": "All major gas and electric carts, including Club Car, Yamaha and E-Z-GO."
 },
 {
  "question": "Can you convert my cart to lithium?",
  "answer": "Yes. We install Bolt Energy lithium packs in 36, 48 and 72 volt carts, with a 12 year warranty."
 }
];

const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Repairs", url: "https://mastersgolfcars.com/golf-cart-repairs" },
	{ name: "Gainesville", url: "https://mastersgolfcars.com/golf-cart-repairs-gainesville" }
];
---

<Layout title="Golf Cart Repairs in Gainesville, FL | Masters Golf Cars - 24-Hour Service" description="Fast golf cart repairs in Gainesville, FL. Serving Haile Plantation, Tioga, UF area & more. 24-hour turnaround. Pickup & delivery. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-repairs-gainesville" breadcrumbs={crumbs} quoteHref="#schedule">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<ServicePage city="Gainesville" pageSource="golf-cart-repairs-gainesville" faqs={pageFAQs} local={local} defaultLocation="Gainesville, FL" />
</Layout>
