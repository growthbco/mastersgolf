---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-florida-horse-park.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - Florida Horse Park Golf Cart Rentals",
	"description": "Golf cart rentals for Florida Horse Park events in Ocala, FL. Fleet rentals for equestrian competitions, festivals, and outdoor events.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-florida-horse-park",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Florida Horse Park",
		"Ocala",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "How many carts can you supply?",
  "answer": "Over 300 in the fleet, in 2, 4, 6 passenger and utility. Tell us the size of the event and we will build the mix."
 },
 {
  "question": "How far in advance should I book?",
  "answer": "As early as you can for busy months. A few weeks is usually fine, but big weekends and show weeks fill up."
 },
 {
  "question": "Do you deliver and pick up at the venue?",
  "answer": "Yes. We deliver, stage the carts where you want them, and pick them up when the event ends."
 },
 {
  "question": "Do the carts come fueled?",
  "answer": "Yes. Every cart arrives fueled and keyed, with a contact number in case anything comes up."
 },
 {
  "question": "What are the rates?",
  "answer": "Daily, weekly and event rates, quoted per event. Fill out the form or call (352) 307-0111."
 }
];

const LEAD = ["Masters Golf Cars is the trusted provider for golf cart rentals at Florida Horse Park events. Located at 11008 S County Road 475 in Ocala, this premier multi-purpose equestrian facility hosts major competitions, festivals, and outdoor events throughout the year.", "Since 1999, we've provided fleet rentals for event organizers, exhibitors, and attendees at Florida Horse Park. Whether you need a single cart for navigating the grounds or a fleet for your organization, we deliver reliable golf carts directly to the venue."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals for Florida Horse Park", url: "https://mastersgolfcars.com/golf-cart-rentals-florida-horse-park" }
];
---

<Layout title="Golf Cart Rentals for Florida Horse Park | Ocala, FL Events" description="Golf cart rentals for Florida Horse Park events in Ocala. Fleet rentals for equestrian competitions, festivals, and outdoor events. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-florida-horse-park" breadcrumbs={crumbs} quoteHref="#fleetquote">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="venue" name="Florida Horse Park" slug="golf-cart-rentals-florida-horse-park" eyebrow="Golf cart rentals at Florida Horse Park, Ocala" heading="Event carts," accent="staged at the Horse Park." lead={LEAD} img={R + 'fleet-aerial-sky.jpg'} imgLabel="Shows, clinics and events on the Greenway" proof={[["star", "Horse Park regulars", "Shows, clinics and festivals"], ["truck", "Delivered and staged", "Where the event needs them"], ["key", "300+ carts", "Any quantity, any week"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultEventType="Equestrian / HITS / Florida Horse Park" />
</Layout>
