---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-golf-tournaments.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Golf Tournament Cart Rentals",
	"description": "Golf cart fleet rentals for charity golf tournaments, corporate outings, and golf events in Central Florida. Serving Ocala, The Villages, and Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-golf-tournaments",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Marion County",
		"Sumter County",
		"Lake County",
		"Ocala",
		"The Villages"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	}
};

const pageFAQs = [
 {
  "question": "How many carts can you supply?",
  "answer": "Over 300 in the fleet, in 2, 4, 6 passenger and utility. Tell us the size of the event and we will build the mix."
 },
 {
  "question": "How far in advance should I book?",
  "answer": "As early as you can for busy months. A few weeks is usually fine, but big weekends and show weeks fill up."
 },
 {
  "question": "Do you deliver and pick up at the venue?",
  "answer": "Yes. We deliver, stage the carts where you want them, and pick them up when the event ends."
 },
 {
  "question": "Do the carts come fueled?",
  "answer": "Yes. Every cart arrives fueled and keyed, with a contact number in case anything comes up."
 },
 {
  "question": "What are the rates?",
  "answer": "Daily, weekly and event rates, quoted per event. Fill out the form or call (352) 307-0111."
 }
];

const LEAD = ["Ensure your golf tournament runs smoothly with premium golf cart rentals from Masters Golf Cars. Since 1999, we've provided fleet rentals for charity tournaments, corporate golf outings, and club championships at courses including Golden Ocala Golf & Equestrian, Stone Creek Golf Club, Juliette Falls, and courses throughout The Villages.", "Whether you need 20 carts for a charity scramble or a few extra carts for sponsor shuttles and beverage service, we deliver clean, reliable carts directly to your golf course."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Tournament Cart Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals-golf-tournaments" }
];
---

<Layout title="Golf Tournament Cart Rentals | Fleet Rentals for Golf Events" description="Golf cart fleet rentals for charity tournaments, corporate golf outings, and golf events. Serving Ocala, The Villages, Marion County courses. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-golf-tournaments" breadcrumbs={crumbs} quoteHref="#fleetquote">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="event" name="golf tournaments" slug="golf-cart-rentals-golf-tournaments" eyebrow="Golf tournament cart rentals" heading="Extra carts for" accent="tournament day." lead={LEAD} img={R + 'clubcar-row.jpg'} imgLabel="Charity outings, corporate scrambles and club events" proof={[["flag", "Tournament carts", "Fill the gap when the course runs short"], ["truck", "Delivered and staged", "At the cart barn before tee time"], ["key", "300+ carts", "Any field size"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultEventType="Golf tournament" faqTitle="Tournament questions." />
</Layout>
