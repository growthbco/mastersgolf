---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Golf Tournament Cart Rentals",
	"description": "Golf cart fleet rentals for charity golf tournaments, corporate outings, and golf events in Central Florida. Serving Ocala, The Villages, and Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-golf-tournaments",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Marion County",
		"Sumter County",
		"Lake County",
		"Ocala",
		"The Villages"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	}
};
---

<Layout
	title="Golf Tournament Cart Rentals | Fleet Rentals for Golf Events"
	description="Golf cart fleet rentals for charity tournaments, corporate golf outings, and golf events. Serving Ocala, The Villages, Marion County courses. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-cart-rentals-golf-tournaments"
	breadcrumbs={[
		{ name: "Home", url: "https://mastersgolfcars.com" },
		{ name: "Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals" },
		{ name: "Golf Tournaments", url: "https://mastersgolfcars.com/golf-cart-rentals-golf-tournaments" }
	]}
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Golf Tournament Cart Rentals</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Ensure your golf tournament runs smoothly with premium golf cart rentals from Masters Golf Cars. Since 1999, we've provided fleet rentals for charity tournaments, corporate golf outings, and club championships at courses including <strong>Golden Ocala Golf & Equestrian</strong>, <strong>Stone Creek Golf Club</strong>, <strong>Juliette Falls</strong>, and courses throughout <strong>The Villages</strong>.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						Whether you need 20 carts for a charity scramble or a few extra carts for sponsor shuttles and beverage service, we deliver clean, reliable carts directly to your golf course.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/fleet-rentals-quote" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							Request Tournament Quote
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" alt="Golf tournament cart rental fleet" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Tournament Types -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Golf Events We Serve</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Charity Golf Tournaments</h3>
					<p class="text-gray-700 font-semibold">
						Support your fundraising event with reliable carts. We've worked with nonprofits hosting events at <strong>Golden Ocala</strong>, <strong>Stone Creek</strong>, and community courses throughout Marion and Sumter counties.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Corporate Golf Outings</h3>
					<p class="text-gray-700 font-semibold">
						Impress clients and colleagues with well-maintained carts for corporate golf days at premium courses like <strong>Juliette Falls</strong>, <strong>Mission Inn Resort</strong>, and <strong>Country Club of Ocala</strong>.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Club Championships</h3>
					<p class="text-gray-700 font-semibold">
						Extra carts for club championships and member-guest tournaments when your course's regular fleet isn't enough. Supplement your existing fleet seamlessly.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Pro-Am Events</h3>
					<p class="text-gray-700 font-semibold">
						Professional tournament support with premium carts for players, sponsors, and VIP guests at area golf events and pro-am competitions.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Memorial & Benefit Tournaments</h3>
					<p class="text-gray-700 font-semibold">
						Reliable service for annual memorial tournaments and benefit events. We understand the importance of these special occasions.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6 shadow-lg">
					<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Course Events</h3>
					<p class="text-gray-700 font-semibold">
						Demo days, grand openings, and course anniversaries. Extra carts for high-traffic days when your regular fleet needs backup.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Golf Courses We Serve -->
	<section class="py-16 bg-brand-green text-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">Golf Courses We Serve</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div>
					<h3 class="text-xl font-bold mb-3">Golden Ocala Golf & Equestrian</h3>
					<p class="text-gray-100 font-semibold mb-2">Ocala, FL</p>
					<p class="text-gray-200 text-sm">
						World-class private course featuring holes inspired by famous layouts. Premier venue for corporate and charity tournaments.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Stone Creek Golf Club</h3>
					<p class="text-gray-100 font-semibold mb-2">Ocala, FL</p>
					<p class="text-gray-200 text-sm">
						Challenging Arthur Hills design in the Stone Creek community. Popular for charity scrambles and corporate outings.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Juliette Falls Golf Club</h3>
					<p class="text-gray-100 font-semibold mb-2">Dunnellon, FL</p>
					<p class="text-gray-200 text-sm">
						Scenic course with elevation changes and waterfall views. Unique setting for memorable golf events.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">The Villages Golf Courses</h3>
					<p class="text-gray-100 font-semibold mb-2">The Villages, FL</p>
					<p class="text-gray-200 text-sm">
						Multiple executive and championship courses. We serve tournaments throughout The Villages' extensive golf network.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Country Club of Ocala</h3>
					<p class="text-gray-100 font-semibold mb-2">Ocala, FL</p>
					<p class="text-gray-200 text-sm">
						Historic private club with member-guest tournaments and club championships. Traditional Florida golf.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Mission Inn Resort</h3>
					<p class="text-gray-100 font-semibold mb-2">Howey-in-the-Hills, FL</p>
					<p class="text-gray-200 text-sm">
						Two championship courses at this historic resort. Perfect for overnight corporate golf retreats and tournaments.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Oak Run Country Club</h3>
					<p class="text-gray-100 font-semibold mb-2">Ocala, FL</p>
					<p class="text-gray-200 text-sm">
						Community course hosting member tournaments and charity events. Active adult community golf.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Ocala Palms Golf Club</h3>
					<p class="text-gray-100 font-semibold mb-2">Ocala, FL</p>
					<p class="text-gray-200 text-sm">
						Semi-private course welcoming tournaments and outside events. Accessible pricing for charity organizers.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3">Rainbow Springs Golf Club</h3>
					<p class="text-gray-100 font-semibold mb-2">Dunnellon, FL</p>
					<p class="text-gray-200 text-sm">
						Beautiful course near Rainbow Springs State Park. Popular for community and fundraising tournaments.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Tournament Cart Types -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">Tournament Cart Options</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" alt="Player golf cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Player Carts</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Standard 2-passenger golf carts for tournament players. Clean, reliable, and fully charged.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/4-seater-golf-cart_img_v64_250813_142836603.webp" alt="Sponsor cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Sponsor Carts</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						4-passenger carts for sponsors visiting holes and greeting players throughout the course.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" alt="Marshall cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Marshal Shuttles</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						6-passenger carts for course marshals, tournament officials, and VIP transportation.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/utility-cart_img_v66_250813_142912878.webp" alt="Beverage cart" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Beverage/Utility</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Utility carts with cargo beds for beverage service, supplies, and tournament operations.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Choose Us -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why Tournament Organizers Choose Us</h2>
			<div class="grid md:grid-cols-2 gap-12">
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">Tournament-Ready Carts</h3>
					<ul class="space-y-3 text-gray-700 font-semibold">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>All carts cleaned and fully charged</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Consistent fleet appearance</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Reliable performance throughout play</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Backup carts available on request</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Early delivery for shotgun starts</span>
						</li>
					</ul>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">Easy Tournament Logistics</h3>
					<ul class="space-y-3 text-gray-700 font-semibold">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Delivery directly to the course</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Flexible pickup timing post-event</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Volume pricing for large fleets</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>Coordination with course staff</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">✓</span>
							<span>26+ years of golf event experience</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- How It Works -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">How Tournament Rental Works</h2>
			<div class="grid md:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">1</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Request Quote</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Tell us your tournament date, golf course, and number of carts needed.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">2</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Confirm Details</h3>
					<p class="text-gray-700 font-semibold text-sm">
						We'll confirm cart types, delivery time, and coordinate with the course.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">3</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Delivery & Setup</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Carts delivered and staged before your first tee time.
					</p>
				</div>
				<div class="text-center">
					<div class="w-16 h-16 bg-brand-green text-white rounded-full flex items-center justify-center font-bold text-2xl mx-auto mb-4">4</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">Play & Pickup</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Focus on your event. We handle pickup after play concludes.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Related Services -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Event Rental Services</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Corporate Events</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Fleet rentals for corporate retreats and company events beyond the golf course.
						</p>
						<a href="/golf-cart-rentals-corporate-events" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Wedding Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf cart rentals for weddings at golf course venues.
						</p>
						<a href="/golf-cart-rentals-weddings" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Festival Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Fleet rentals for festivals and large outdoor events.
						</p>
						<a href="/golf-cart-rentals-festivals" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-16 bg-gray-900 text-white">
		<div class="container mx-auto px-4 max-w-6xl text-center">
			<h2 class="text-3xl md:text-4xl font-black mb-6">Planning a Golf Tournament?</h2>
			<p class="text-xl mb-8 font-semibold text-gray-300">
				Contact Masters Golf Cars today for tournament cart pricing. We deliver to courses throughout Central Florida including <strong>Golden Ocala</strong>, <strong>Stone Creek</strong>, <strong>The Villages</strong>, and more.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
				<a href="/fleet-rentals-quote" class="bg-brand-green text-white font-bold py-4 px-8 rounded-lg hover:opacity-90 transition">
					Request Tournament Quote
				</a>
				<a href="tel:3523070111" class="bg-white text-gray-900 font-bold py-4 px-8 rounded-lg hover:bg-gray-100 transition">
					Call (352) 307-0111
				</a>
			</div>
			<p class="text-gray-400 font-semibold">
				{companyData.location.full} | Serving Central Florida Golf Since 1999
			</p>
		</div>
	</section>

	<Schema schema={localBusinessSchema} />
</Layout>
