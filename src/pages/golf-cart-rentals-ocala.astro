			</div>
			<p class="text-center text-gray-600 mt-8 font-semibold">
				Don't see your neighborhood listed? We serve all of Marion County! Call us at <a href="tel:3523070111" class="text-brand-green hover:underline">(352) 307-0111</a> to confirm delivery to your area.
			</p>
		</div>
	</section>

	<!-- Local Attractions & Venues -->
	<section class="py-16 bg-brand-green text-white">
