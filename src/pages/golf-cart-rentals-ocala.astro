---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-ocala.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - Ocala Golf Cart Rentals",
	"description": "Golf cart rentals in Ocala, FL. Serving Ocala Palms, Golden Ocala, Woodfields, Stonecrest, Rolling Greens, On Top of The World, and all of Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-ocala",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Ocala Palms",
		"Golden Ocala",
		"Woodfields",
		"Stonecrest",
		"Rolling Greens",
		"On Top of The World",
		"Country Club of Ocala",
		"Oak Run",
		"Downtown Ocala",
		"Silver Springs",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "How fast can you deliver to Ocala?",
  "answer": "Often the same or next day when carts are available. Book ahead for holidays and busy event weeks."
 },
 {
  "question": "Is there a delivery fee?",
  "answer": "Delivery is quoted with your reservation based on your address. Call (352) 307-0111 for a quick number."
 },
 {
  "question": "Is there a minimum rental?",
  "answer": "Yes, 3 days. After that, rent by the week, the month or the season."
 },
 {
  "question": "How old do I have to be?",
  "answer": "Renters must be 21 or older with a valid driver license."
 },
 {
  "question": "Can I extend?",
  "answer": "Yes. Call us before your end date and we will extend it if the cart is available."
 }
];

const LEAD = ["Since 1999, Masters Golf Cars has been Ocala's trusted source for premium golf cart rentals. We serve neighborhoods throughout Ocala including Ocala Palms, Golden Ocala, Woodfields, Stonecrest, and Rolling Greens. Conveniently located at 12885 S US Highway 441 in Belleview, just minutes from downtown Ocala and across from the Market of Marion.", "With over 26 years of experience serving Marion County, we deliver reliable golf carts directly to your Ocala location. Whether you need a cart for exploring Silver Springs State Park, attending events at World Equestrian Center (WEC), or navigating your neighborhood, we have the perfect rental solution."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals in Ocala, FL", url: "https://mastersgolfcars.com/golf-cart-rentals-ocala" }
];
---

<Layout title="Golf Cart Rentals in Ocala, FL | Masters Golf Cars - Since 1999" description="Rent premium golf carts in Ocala, FL. Serving Ocala Palms, Golden Ocala, Woodfields & more. Delivery available. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-ocala" breadcrumbs={crumbs} quoteHref="#reserve">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="city" name="Ocala" slug="golf-cart-rentals-ocala" eyebrow="Golf cart rentals in Ocala, FL" heading="Golf cart rentals," accent="delivered in Ocala." lead={LEAD} img={R + 'cart-4p-deluxe.jpg'} imgLabel="Delivered to Ocala from Belleview, 12 miles" proof={[["pin", "12 miles away", "About 20 minutes from our shop"], ["truck", "Delivered to you", "Home, community or venue"], ["key", "300+ carts", "Availability most weeks"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} defaultLocation="Ocala, FL" />
</Layout>
