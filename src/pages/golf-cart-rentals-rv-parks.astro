---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-rv-parks.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - RV Park Golf Cart Rentals",
	"description": "Golf cart rentals for RV parks and campgrounds in Central Florida. Serving Citra Royal Palm RV Park, Sun RV Resorts, and campgrounds throughout Marion, Sumter, and Lake counties.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-rv-parks",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Citra Royal Palm RV Park",
		"Sun RV Resorts",
		"Marion County RV Parks",
		"Sumter County Campgrounds",
		"Lake County RV Parks"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "5",
		"bestRating": "5",
		"worstRating": "1",
		"reviewCount": "150"
	}
};

const pageFAQs = [
 {
  "question": "How fast can you deliver to RV parks and campgrounds?",
  "answer": "Often the same or next day when carts are available. Book ahead for holidays and busy event weeks."
 },
 {
  "question": "Is there a delivery fee?",
  "answer": "Delivery is quoted with your reservation based on your address. Call (352) 307-0111 for a quick number."
 },
 {
  "question": "Is there a minimum rental?",
  "answer": "Yes, 3 days. After that, rent by the week, the month or the season."
 },
 {
  "question": "How old do I have to be?",
  "answer": "Renters must be 21 or older with a valid driver license."
 },
 {
  "question": "Can I extend?",
  "answer": "Yes. Call us before your end date and we will extend it if the cart is available."
 }
];

const LEAD = ["Make the most of your RV park or campground stay with a golf cart rental from Masters Golf Cars. Since 1999, we've been delivering golf carts to RV resorts throughout Central Florida, including Citra Royal Palm RV Park, Sun RV Resorts, and campgrounds in Marion, Sumter, and Lake counties.", "Golf carts are the preferred way to explore RV resort amenities, visit neighbors, and travel to nearby attractions. We deliver directly to your RV site and pick up when your stay ends."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals for RV Parks & Campgrounds", url: "https://mastersgolfcars.com/golf-cart-rentals-rv-parks" }
];
---

<Layout title="Golf Cart Rentals for RV Parks & Campgrounds | Central Florida" description="Golf cart rentals for RV parks and campgrounds. Serving Citra Royal Palm, Sun RV Resorts & Central Florida campgrounds. Delivery available. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-rv-parks" breadcrumbs={crumbs} quoteHref="#reserve">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />
	<LocationPage kind="community" name="RV parks and campgrounds" slug="golf-cart-rentals-rv-parks" eyebrow="Golf cart rentals for RV parks and campgrounds" heading="A golf cart," accent="delivered to your campsite." lead={LEAD} img={R + 'carryall.jpg'} imgLabel="Elite RV, Tall Timbers and seasonal parks around Marion County" proof={[["pin", "Countywide", "Marion, Sumter and Lake County parks"], ["truck", "Delivered to your site", "Weekly, monthly or the season"], ["key", "300+ carts", "Availability most weeks"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={pageFAQs} checks={["Delivered to your campsite or park office", "Week, month or the whole season", "2, 4 and 6 passenger, plus utility", "3 day minimum"]} />
</Layout>
