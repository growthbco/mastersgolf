---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import HeroSplit from '../components/sections/HeroSplit.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import LocalContent from '../components/sections/LocalContent.astro';
import Reviews from '../components/sections/Reviews.astro';
import Faq from '../components/sections/Faq.astro';
import FormShell from '../components/forms/FormShell.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Check from '../components/ui/Check.astro';
import local from '../data/locations/golf-carts-for-sale-spruce-creek.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - Spruce Creek Golf Carts for Sale",
	"description": "New and used golf carts for sale for Spruce Creek communities. Serving Del Webb Spruce Creek, Spruce Creek South, Spruce Creek Preserve, and Summerfield area.",
	"url": "https://mastersgolfcars.com/golf-carts-for-sale-spruce-creek",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Del Webb Spruce Creek",
		"Spruce Creek South",
		"Spruce Creek Preserve",
		"Spruce Creek Golf & Country Club",
		"Summerfield",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};

const pageFAQs = [
 {
  "question": "Do you deliver carts to Spruce Creek?",
  "answer": "Yes. New and pre-owned carts are delivered to Spruce Creek from our shop in Belleview."
 },
 {
  "question": "Do you offer financing?",
  "answer": "Yes, through Sheffield Financial. Apply online in minutes."
 },
 {
  "question": "Do you take trade-ins?",
  "answer": "Yes. Trade toward any cart in stock, or sell your cart to us outright."
 },
 {
  "question": "What comes with a new cart?",
  "answer": "A free first year of 24hr Cart Club roadside assistance, and service from the shop that sold it."
 }
];

const LEAD = ["Live in a Spruce Creek community? Masters Golf Cars sells carts to folks in Del Webb Spruce Creek, Spruce Creek South, and Spruce Creek Preserve. We have been at it since 1999.", "Our shop is at 12885 S US Highway 441 in Belleview. That is just off County Road 475A, close to I-75. We sell Club Car, Yamaha, and EZ-GO. New and used. We fix carts too."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Inventory", url: "https://mastersgolfcars.com/golf-cart-inventory" },
	{ name: "Spruce Creek", url: "https://mastersgolfcars.com/golf-carts-for-sale-spruce-creek" }
];
---

<Layout title="Golf Carts for Sale in Spruce Creek Communities | Masters Golf Cars" description="Buy golf carts in Spruce Creek, FL. Serving Del Webb Spruce Creek, Spruce Creek South, Spruce Creek Preserve. New & used golf carts. Financing available. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-carts-for-sale-spruce-creek" breadcrumbs={crumbs} quoteHref="#askcart">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={pageFAQs} />

	<HeroSplit eyebrow="Golf carts for sale in Spruce Creek" heading="Your next cart," accent="delivered to Spruce Creek." lead={LEAD[0]} cta="Browse inventory" ctaHref="#inventory" checks={['New and pre-owned', 'Financing through Sheffield Financial', 'Trade-ins welcome', 'Delivered to Spruce Creek']} img={R + 'clubcar-row.jpg'} alt="Row of golf carts for sale at Masters Golf Cars" label="6 miles from our shop" pos="50% 60%" />
	<ProofBar items={[['tag', 'New and pre-owned', 'Club Car, Yamaha, E-Z-GO, Advanced EV'], ['dollar', 'Financing', 'Apply online with Sheffield Financial'], ['truck', 'Delivered to Spruce Creek', 'Set up and ready to drive'], ['star', '4.9 on Google', 'From 93 customer reviews']]} />
	{LEAD.length > 1 && <section class="sec white" style="padding-bottom:0"><div class="stack" style="gap:16px;max-width:820px">{LEAD.slice(1).map((p) => <p class="body" style="font-size:17px;line-height:28px">{p}</p>)}</div></section>}
	<LocalContent sections={local.sections} eyebrow="Buying a cart in Spruce Creek" />

	<section class="sec dark on-dark fin">
		<div class="head"><Eyebrow>Financing</Eyebrow><h2 class="h2">Easy financing on <span class="g">new and used carts.</span></h2><p class="lead" style="max-width:460px">Apply online in a few minutes through Sheffield Financial. Approved buyers can drive away the same day.</p></div>
		<div class="stack" style="gap:28px">
			<div class="check-list" style="gap:14px 24px">{['Apply online, from home', 'New and pre-owned carts', 'Trade-ins accepted toward your purchase', 'Free first year of 24hr Cart Club with every new cart'].map((t) => <Check>{t}</Check>)}</div>
			<div class="row btn-row" style="gap:16px"><Btn href="https://www.sheffieldfinancial.com/" kind="solid">Apply for financing</Btn><Btn href="/sell-your-cart" kind="ghost-d">Sell or trade your cart</Btn></div>
		</div>
	</section>

	<Reviews heading="What Spruce Creek buyers say." />
	<Faq items={pageFAQs} heading="Spruce Creek questions." />

	<FormShell id="askcart" eyebrow="Ask about a cart" heading="Found one you" accent="like?" lead="Tell us what you are looking for and our sales team will get back to you as soon as possible during business hours.">
		<CartInquiryForm pageSource="golf-carts-for-sale-spruce-creek" idPrefix="sales" />
	</FormShell>
</Layout>

<style>
	.fin { display: grid; grid-template-columns: 1fr 1.3fr; gap: 80px; align-items: center; }
	@media (max-width: 1100px) { .fin { grid-template-columns: 1fr; gap: 40px; } }
</style>
