---
import Layout from '../layouts/Layout.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';
import servicesData from '../data/services.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"name": "Masters Golf Cars - Spruce Creek Golf Carts for Sale",
	"description": "New and used golf carts for sale for Spruce Creek communities. Serving Del Webb Spruce Creek, Spruce Creek South, Spruce Creek Preserve, and Summerfield area.",
	"url": "https://mastersgolfcars.com/golf-carts-for-sale-spruce-creek",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Del Webb Spruce Creek",
		"Spruce Creek South",
		"Spruce Creek Preserve",
		"Spruce Creek Golf & Country Club",
		"Summerfield",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
---

<Layout
	title="Golf Carts for Sale in Spruce Creek Communities | Masters Golf Cars"
	description="Buy golf carts in Spruce Creek, FL. Serving Del Webb Spruce Creek, Spruce Creek South, Spruce Creek Preserve. New & used golf carts. Financing available. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-carts-for-sale-spruce-creek"
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Golf Carts for Sale in Spruce Creek</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Live in a Spruce Creek community? <strong>Masters Golf Cars</strong> sells carts to folks in <strong>Del Webb Spruce Creek</strong>, <strong>Spruce Creek South</strong>, and <strong>Spruce Creek Preserve</strong>. We have been at it since 1999.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						Our shop is at <strong>12885 S US Highway 441</strong> in Belleview. That is just off <strong>County Road 475A</strong>, close to <strong>I-75</strong>. We sell <strong>Club Car</strong>, <strong>Yamaha</strong>, and <strong>EZ-GO</strong>. New and used. We fix carts too.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/golf-cart-inventory" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							View Inventory
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/golf-cart-rentals-page/club-car_img_v68_250813_154125925.webp" alt="Golf carts for sale for Spruce Creek residents" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Why Buy From Us -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why Spruce Creek Picks Masters Golf Cars</h2>
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-6">
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">We Serve All Three Communities</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							There are three Spruce Creek spots near <strong>Summerfield</strong> and <strong>Belleview</strong>. <strong>Del Webb Spruce Creek</strong> is the big one with the golf course. <strong>Spruce Creek South</strong> is gated and quiet. <strong>Spruce Creek Preserve</strong> has nature trails. We sell carts to all three.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">26 Years of Trust</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							<strong>Masters Golf Cars</strong> opened in 1999. People in <strong>Marion County</strong> know us. We sell fair and fix things right. Your neighbors have bought from us. Ask around.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Easy to Get To</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							We are on <strong>US-441</strong> in Belleview. From <strong>Del Webb Spruce Creek</strong>, take <strong>County Road 475A</strong> north. You will see us in about 10 minutes. Right across from the <strong>Market of Marion</strong>.
						</p>
					</div>
				</div>
				<div>
					<div class="bg-white rounded-lg p-8 shadow-lg mb-6">
						<h3 class="text-xl font-bold text-gray-900 mb-4">The Three Spruce Creek Communities</h3>
						<ul class="space-y-4 text-gray-700 font-semibold mb-6">
							<li>
								<strong>Del Webb Spruce Creek</strong>
								<p class="text-sm text-gray-600 mt-1">The original one. Has the <strong>Spruce Creek Golf & Country Club</strong>. Biggest of the three.</p>
							</li>
							<li>
								<strong>Spruce Creek South</strong>
								<p class="text-sm text-gray-600 mt-1">Gated 55+ spot. Quiet streets. Close to shops on <strong>US-441</strong>.</p>
							</li>
							<li>
								<strong>Spruce Creek Preserve</strong>
								<p class="text-sm text-gray-600 mt-1">Nature lovers like this one. Has trails and woods. Very peaceful.</p>
							</li>
						</ul>
					</div>
					<div class="bg-brand-green text-white rounded-lg p-8">
						<h3 class="text-xl font-bold mb-4">We Offer Financing</h3>
						<p class="mb-4 font-semibold">
							Do not want to pay all at once? We work with <strong>Sheffield Financial</strong>. You can pay month by month. Easy to apply online.
						</p>
						<a href="https://prequalify.sheffieldfinancial.com/Apply/Landing?source=web&dealer=57070" target="_blank" rel="noopener noreferrer" class="inline-block bg-black text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-900 transition">
							Apply for Financing
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Brands We Carry -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Golf Cart Brands for Spruce Creek Life</h2>
			<p class="text-lg text-gray-700 text-center mb-10 font-semibold max-w-3xl mx-auto">
				We sell the top names. Each one works well for getting around your community. Come to our shop and try them out.
			</p>
			<div class="grid md:grid-cols-2 grid-cols-3 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'Club Car')?.icon || '/images/logos/club-car-icon-0-0.webp'} alt="Club Car golf carts for Spruce Creek" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">Club Car</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Rides smooth. Lasts a long time. Many <strong>Del Webb Spruce Creek</strong> folks drive a <strong>Club Car</strong>.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'Yamaha')?.icon || '/images/logos/yamaha-icon-0-1.webp'} alt="Yamaha golf carts for Spruce Creek" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">Yamaha</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Good battery. Quiet ride. <strong>Yamaha</strong> gets you from home to the clubhouse and back without running low.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-6">
						<img src={servicesData.brands.find(b => b.name === 'EZ-GO')?.icon || '/images/logos/ez-go-icon-0-2.webp'} alt="EZ-GO golf carts for Spruce Creek" class="h-16 mx-auto object-contain" loading="lazy" />
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-3">EZ-GO</h3>
					<p class="text-gray-700 font-semibold text-sm">
						Good price. Works well. Popular in <strong>Spruce Creek South</strong> and <strong>Spruce Creek Preserve</strong>.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Community Features -->
	<section class="py-16 bg-brand-green text-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">What Each Spruce Creek Has</h2>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-white/10 rounded-lg p-8">
					<h3 class="text-2xl font-bold mb-4">Del Webb Spruce Creek</h3>
					<p class="font-semibold mb-4">
						The biggest one. Has its own golf course, the <strong>Spruce Creek Golf & Country Club</strong>. Lots of clubs and things to do. Paths go all over.
					</p>
					<ul class="space-y-2 font-semibold text-sm">
						<li>&#8226; 18-Hole Golf Course</li>
						<li>&#8226; Fitness Center</li>
						<li>&#8226; Pools</li>
						<li>&#8226; Tennis & Pickleball</li>
						<li>&#8226; Clubhouse with Food</li>
					</ul>
				</div>
				<div class="bg-white/10 rounded-lg p-8">
					<h3 class="text-2xl font-bold mb-4">Spruce Creek South</h3>
					<p class="font-semibold mb-4">
						Gated and safe. Smaller than Del Webb. Close to stores on <strong>US-441</strong>. Nice homes. Friendly people.
					</p>
					<ul class="space-y-2 font-semibold text-sm">
						<li>&#8226; Gated Entry</li>
						<li>&#8226; Community Center</li>
						<li>&#8226; Pool</li>
						<li>&#8226; Social Events</li>
						<li>&#8226; Cart-Friendly Roads</li>
					</ul>
				</div>
				<div class="bg-white/10 rounded-lg p-8">
					<h3 class="text-2xl font-bold mb-4">Spruce Creek Preserve</h3>
					<p class="font-semibold mb-4">
						Nature all around. Trails through the woods. Quiet and green. Great for people who love the outdoors.
					</p>
					<ul class="space-y-2 font-semibold text-sm">
						<li>&#8226; Nature Trails</li>
						<li>&#8226; Wildlife Areas</li>
						<li>&#8226; Community Amenities</li>
						<li>&#8226; Peaceful Setting</li>
						<li>&#8226; Cart Paths</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- New vs Used -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">New or Used - We Have Both</h2>
			<div class="grid md:grid-cols-2 gap-12">
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">New Golf Carts</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Want one with no miles? We have new carts from the top brands. Pick your colors. Pick your options. Get a full warranty.
					</p>
					<ul class="space-y-3 text-gray-700 font-semibold mb-6">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Full warranty</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Latest features</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>You pick the look</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Financing ready</span>
						</li>
					</ul>
					<a href="/golf-cart-inventory?condition=new" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
						View New Inventory
					</a>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<h3 class="text-2xl font-bold text-gray-900 mb-6">Used Golf Carts</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Good carts do not have to be new. We have used ones that run great. Many came from right here in <strong>Marion County</strong>. We check them before we sell.
					</p>
					<ul class="space-y-3 text-gray-700 font-semibold mb-6">
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Checked and fixed up</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Save money</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Trade in your old one</span>
						</li>
						<li class="flex items-start">
							<span class="text-brand-green text-xl mr-3">&#10003;</span>
							<span>Financing on used too</span>
						</li>
					</ul>
					<a href="/golf-cart-inventory?condition=used" class="inline-block bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition">
						View Used Inventory
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Services -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">All Your Golf Cart Needs - One Place</h2>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
					<h3 class="text-2xl font-bold text-gray-900 mb-4">Sales</h3>
					<p class="text-gray-700 font-semibold mb-4">
						New and used. We help Spruce Creek folks find what fits their life.
					</p>
					<ul class="space-y-2 text-gray-700 font-semibold text-sm mb-6">
						<li>&#8226; Club Car, Yamaha, and EZ-GO</li>
						<li>&#8226; New and pre-owned</li>
						<li>&#8226; Financing ready</li>
						<li>&#8226; Trade-ins welcome</li>
					</ul>
					<a href="/golf-cart-inventory" class="text-brand-green font-bold hover:underline">View Inventory</a>
				</div>
				<div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
					<h3 class="text-2xl font-bold text-gray-900 mb-4">Service and Repairs</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Cart acting up? Bring it in. We fix all brands. Quick work. Fair prices.
					</p>
					<ul class="space-y-2 text-gray-700 font-semibold text-sm mb-6">
						<li>&#8226; Tune-ups</li>
						<li>&#8226; Batteries</li>
						<li>&#8226; Brakes</li>
						<li>&#8226; Electrical</li>
					</ul>
					<a href="/schedule-golf-cart-service" class="text-brand-green font-bold hover:underline">Schedule Service</a>
				</div>
				<div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
					<h3 class="text-2xl font-bold text-gray-900 mb-4">Rentals</h3>
					<p class="text-gray-700 font-semibold mb-4">
						Need a cart for a while? We rent them. Good for when yours is in the shop or guests come to town.
					</p>
					<ul class="space-y-2 text-gray-700 font-semibold text-sm mb-6">
						<li>&#8226; Day, week, or month</li>
						<li>&#8226; We can deliver</li>
						<li>&#8226; 2, 4, or 6 seats</li>
						<li>&#8226; Call for rates</li>
					</ul>
					<a href="/rent-a-golf-cart" class="text-brand-green font-bold hover:underline">Request Rental</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Testimonials -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h3 class="text-3xl font-black text-gray-900 text-center mb-4">What Spruce Creek Folks Say</h3>
			<div class="flex justify-center gap-1 mb-12">
				{Array.from({ length: 5 }).map((_star, index) => (
					<svg class="w-6 h-6" fill="#FFD700" viewBox="0 0 20 20">
						<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
					</svg>
				))}
			</div>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-white rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"Got our Club Car from Masters. They knew what would work for Del Webb Spruce Creek. We drive it to the clubhouse all the time. Great cart!"
					</p>
					<p class="font-black text-gray-900">-Jim & Nancy H., Del Webb Spruce Creek</p>
				</div>
				<div class="bg-white rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"We have bought two carts from Masters over the years. Always fair. Always friendly. They treat Spruce Creek folks right."
					</p>
					<p class="font-black text-gray-900">-Robert P., Spruce Creek South</p>
				</div>
				<div class="bg-white rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"Found a nice used Yamaha at Masters. It runs great on the trails here in Spruce Creek Preserve. Good people. Honest deal."
					</p>
					<p class="font-black text-gray-900">-Susan M., Spruce Creek Preserve</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Related Services Section -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Ways We Help</h2>
				<div class="grid md:grid-cols-2 gap-6">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Repairs</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Cart not running right? We fix <strong>Club Car</strong>, <strong>Yamaha</strong>, <strong>EZ-GO</strong>, and all the rest.
						</p>
						<a href="/golf-cart-repairs-ocala" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn About Repairs
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Need a loaner while yours is in the shop? We rent carts. Can bring them to Spruce Creek.
						</p>
						<a href="/golf-cart-rentals-ocala" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn About Rentals
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Other Locations -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">We Serve Other Areas Too</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Ocala</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf carts for all of <strong>Marion County</strong>. We are right off <strong>US-441</strong>.
						</p>
