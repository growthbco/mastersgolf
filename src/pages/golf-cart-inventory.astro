---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import inventoryData from '../data/inventory.json';
import HeroSplit from '../components/sections/HeroSplit.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import Reviews from '../components/sections/Reviews.astro';
import FormShell from '../components/forms/FormShell.astro';
import CartInquiryForm from '../components/forms/CartInquiryForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Check from '../components/ui/Check.astro';
import Ring from '../components/ui/Ring.astro';
import { R } from '../lib/areas';

const inventoryServiceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	"@id": "https://mastersgolfcars.com/golf-cart-inventory/#service",
	"name": "Golf Cart Sales",
	"description": "Browse our selection of new and used golf carts for sale in Central Florida. We carry Club Car, EZ-GO, and Yamaha golf carts. Financing available.",
	"provider": {
		"@type": "LocalBusiness",
		"name": "Masters Golf Cars, LLC",
		"url": "https://mastersgolfcars.com",
		"telephone": "+1-352-307-0111",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "12885 S US Hwy 441",
			"addressLocality": "Belleview",
			"addressRegion": "FL",
			"postalCode": "34420",
			"addressCountry": "US"
		}
	},
	"serviceType": "Golf Cart Sales",
	"areaServed": [
		{
			"@type": "City",
			"name": "The Villages",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Ocala",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Belleview",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Gainesville",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		}
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Carts for Sale",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "New Golf Carts",
					"description": "Brand new golf carts from Club Car, EZ-GO, and Yamaha",
					"brand": {
						"@type": "Brand",
						"name": "Masters Golf Cars"
					}
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Used Golf Carts",
					"description": "Quality pre-owned and refurbished golf carts at competitive prices"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Custom Golf Carts",
					"description": "Custom-built golf carts with personalized features and upgrades"
				}
			}
		]
	}
};

// Breadcrumbs for inventory page
const inventoryBreadcrumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Inventory", url: "https://mastersgolfcars.com/golf-cart-inventory" }
];
const FINANCING = 'https://www.sheffieldfinancial.com/';
---

<Layout title="Golf Cart Inventory - Masters Golf Cars" description="Browse our selection of new and used golf carts for sale in Central Florida" breadcrumbs={inventoryBreadcrumbs} quoteHref="#askcart">
	<Schema schema={inventoryServiceSchema} slot="schema" />

	<HeroSplit eyebrow="Golf carts for sale" heading="Find your" accent="next ride." lead="New and pre-owned carts from the brands we service every day. Financing available through Sheffield Financial, and every new cart comes with a free year of 24hr Cart Club roadside help." cta="Browse inventory" ctaHref="#inventory" secondCta="Apply for financing" secondHref={FINANCING} checks={['New and pre-owned', 'Financing available', 'Trade-ins welcome', 'Serviced by the people who sold it']} img={R + 'y4-side.jpg'} alt="Blue Yamaha four passenger golf cart" label="Sales, service and support under one roof" pos="50% 60%" />
	<ProofBar items={[['tag', 'New and pre-owned', 'Club Car, Yamaha, E-Z-GO, Advanced EV'], ['dollar', 'Financing', 'Apply online with Sheffield Financial'], ['shield', 'Serviced here', 'Same shop, same techs, after the sale'], ['key', 'Trade-ins', 'We buy carts too']]} />


	<section class="sec dark on-dark fin">
		<div class="head"><Eyebrow>Financing</Eyebrow><h2 class="h2">Easy financing on <span class="g">new and used carts.</span></h2><p class="lead" style="max-width:460px">Apply online in a few minutes through Sheffield Financial. Approved buyers can drive away the same day.</p></div>
		<div class="stack" style="gap:28px">
			<div class="check-list" style="gap:14px 24px">{['Apply online, from home', 'New and pre-owned carts', 'Trade-ins accepted toward your purchase', 'Free first year of 24hr Cart Club with every new cart'].map((t) => <Check>{t}</Check>)}</div>
			<div class="row btn-row" style="gap:16px"><Btn href={FINANCING} kind="solid">Apply for financing</Btn><Btn href="/sell-your-cart" kind="ghost-d">Sell or trade your cart</Btn></div>
		</div>
	</section>

	<section class="sec white stack" style="gap:48px">
		<div class="head"><Eyebrow>Why buy from Masters</Eyebrow><h2 class="h2">Bought here. Serviced here.</h2></div>
		<div class="grid3" style="gap:40px">
			{[['wrench', 'The shop is next door', 'The techs who prep your cart are the ones who service it for years.'], ['battery', 'Lithium ready', 'Add a Bolt Energy lithium pack with a 12 year warranty at purchase.'], ['sliders', 'Built your way', 'Lift, wheels, seats, lights and audio, installed before delivery.']].map(([i, t, s]) => (
				<div class="why"><Ring name={i} fill /><h3 class="h3" style="font-size:20px;line-height:26px">{t}</h3><p class="body">{s}</p></div>
			))}
		</div>
	</section>

	<Reviews heading="Customers for the long haul." bg="paper" />

	<FormShell id="askcart" eyebrow="Ask about a cart" heading="Found one you" accent="like?" lead="Tell us which cart and our sales team will get back to you as soon as possible during business hours.">
		<CartInquiryForm pageSource="golf-cart-inventory" idPrefix="inv" placeholder="Which cart or stock number, whether you have a trade-in, and any questions." />
	</FormShell>
</Layout>

<style>
	.fin { display: grid; grid-template-columns: 1fr 1.3fr; gap: 80px; align-items: center; }
	.why { display: flex; flex-direction: column; gap: 16px; padding-top: 24px; border-top: 1px solid var(--line); }
	@media (max-width: 1100px) { .fin { grid-template-columns: 1fr; gap: 40px; } }
</style>
