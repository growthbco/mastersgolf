---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import companyData from '../data/company.json';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Belleview Golf Cart Rentals",
	"description": "Golf cart rentals in Belleview, FL. Our home location serving Belleview, Ocala, The Villages, and all of Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-belleview",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Belleview",
		"Ocala",
		"The Villages",
		"Summerfield",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
---

<Layout 
	title="Golf Cart Rentals in Belleview, FL | Masters Golf Cars - Local Service" 
	description="Rent golf carts in Belleview, FL. Our home location! Serving Belleview & surrounding areas. Delivery available. 26+ years experience. Call (352) 307-0111"
	canonical="https://mastersgolfcars.com/golf-cart-rentals-belleview"
>
	<!-- Hero Section -->
	<section class="bg-white py-12 md:py-16">
		<div class="container mx-auto px-4 max-w-6xl">
			<div class="grid md:grid-cols-2 gap-8 items-center">
				<div>
					<h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">Golf Cart Rentals in Belleview, FL</h1>
					<p class="text-xl text-gray-700 font-semibold mb-4">
						Since 1999, Masters Golf Cars has been serving Belleview and surrounding Marion County with premium golf cart rentals. Located right here in Belleview at <strong>12885 S US Highway 441</strong> (across from the <strong>Market of Marion</strong>), we're your local golf cart rental experts.
					</p>
					<p class="text-lg text-gray-700 font-semibold mb-6">
						As Belleview's hometown golf cart dealership, we understand the unique needs of our local community. Whether you need a cart for exploring Belleview neighborhoods, accessing nearby <strong>Ocala</strong> or <strong>The Villages</strong>, or for local events, we have the perfect rental solution. Our convenient location makes pickup and delivery quick and easy for Belleview residents.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/rent-a-golf-cart" class="bg-brand-green text-white font-bold py-3 px-8 rounded-lg hover:opacity-90 transition text-center">
							Request a Rental
						</a>
						<a href="tel:3523070111" class="bg-gray-900 text-white font-bold py-3 px-8 rounded-lg hover:bg-gray-800 transition text-center">
							Call (352) 307-0111
						</a>
					</div>
				</div>
				<div>
					<img src="/images/golf-cart-rentals-page/club-car_img_v68_250813_154125925.webp" alt="Golf cart rentals in Belleview Florida" class="w-full h-auto rounded-lg shadow-lg" loading="eager" fetchpriority="high" width="800" height="600" />
				</div>
			</div>
		</div>
	</section>

	<!-- Why Rent in Belleview -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-12 text-center">Why Rent a Golf Cart in Belleview?</h2>
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-6">
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Your Hometown Golf Cart Dealership</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Masters Golf Cars has been serving Belleview since 1999. We're locally owned and operated, right here in your community at <strong>12885 S US Highway 441</strong>. Our convenient location across from the <strong>Market of Marion</strong> makes us easily accessible from anywhere in Belleview.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Convenient Location</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Located on <strong>US Highway 441</strong> (Pine Avenue), we're perfectly positioned to serve Belleview residents. Our location is easily accessible from <strong>State Road 200</strong>, <strong>I-75</strong>, and <strong>SR 40</strong>, making pickup and delivery quick and convenient.
						</p>
					</div>
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-3">Quick Delivery & Pickup</h3>
						<p class="text-gray-700 leading-relaxed font-semibold">
							Since we're right here in Belleview, we can provide the fastest delivery and pickup service in the area. Whether you're in central Belleview or on the outskirts, we'll get your golf cart to you quickly.
						</p>
					</div>
				</div>
				<div>
					<div class="bg-white rounded-lg p-8 shadow-lg">
						<h3 class="text-xl font-bold text-gray-900 mb-4">Serving Belleview Since 1999</h3>
						<p class="text-gray-700 font-semibold mb-4">
							As a locally owned and operated business, we understand Belleview's unique needs. Our team has deep roots in the community and has served thousands of Belleview residents over the past 26 years.
						</p>
						<ul class="space-y-2 text-gray-700 font-semibold">
							<li>• 26+ years serving Belleview</li>
							<li>• Locally owned and operated</li>
							<li>• Fastest delivery in the area</li>
							<li>• Trusted by Belleview residents</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Rental Options -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-black mb-12 text-center">Golf Cart Rental Options for Belleview</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" alt="2-passenger golf cart rental Belleview" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">2-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Perfect for couples exploring Belleview or nearby areas. Ideal for daily errands and local trips.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/4-seater-golf-cart_img_v64_250813_142836603.webp" alt="4-passenger golf cart rental Belleview" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">4-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Spacious seating for small groups. Excellent for families or hosting guests in Belleview.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" alt="6-passenger golf cart rental Belleview" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">6-Passenger</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Maximum capacity for larger groups. Perfect for social gatherings and local events.
					</p>
				</div>
				<div class="text-center">
					<div class="mb-6 bg-gray-50 rounded-lg p-4">
						<img src="/images/golf-cart-rentals-page/utility-cart_img_v66_250813_142912878.webp" alt="Utility golf cart rental Belleview" class="w-full h-auto object-contain max-h-64 mx-auto" loading="lazy" width="400" height="300" />
					</div>
					<h3 class="text-2xl font-bold mb-3">Utility Cart</h3>
					<p class="mb-4 font-semibold leading-relaxed text-sm text-gray-700">
						Versatile carts with cargo space. Ideal for moving items, groceries, or local errands.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Related Services Section - Internal Linking -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Other Services in Belleview</h2>
				<div class="grid md:grid-cols-2 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Cart Repairs in Belleview</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Fast, reliable golf cart repair service right here in Belleview. Most repairs completed within 24 hours.
						</p>
						<a href="/golf-cart-repairs-belleview" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							Learn More About Belleview Repairs
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
					<div class="bg-white rounded-lg p-6 border border-gray-200">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Golf Carts for Sale</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Browse our selection of new and used golf carts. Visit our Belleview location to see our inventory.
						</p>
						<a href="/golf-cart-inventory" class="text-brand-green font-bold hover:underline inline-flex items-center gap-2">
							View Inventory
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Other Locations Section - Internal Linking -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-8 text-center">Golf Cart Rentals in Nearby Areas</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Ocala Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf cart rentals in Ocala, FL. Just 8 miles north of Belleview.
						</p>
						<a href="/golf-cart-rentals-ocala" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">The Villages Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf cart rentals in The Villages, FL. Serving the premier retirement community.
						</p>
						<a href="/the-villages-golf-cart-rentals" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Gainesville Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4">
							Golf cart rentals in Gainesville, FL. Serving UF area and Alachua County.
						</p>
						<a href="/golf-cart-rentals-gainesville" class="text-brand-green font-bold hover:underline">Learn More</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-16 bg-gray-900 text-white">
		<div class="container mx-auto px-4 max-w-6xl text-center">
			<h2 class="text-3xl md:text-4xl font-black mb-6">Ready to Rent a Golf Cart in Belleview?</h2>
			<p class="text-xl mb-8 font-semibold text-gray-300">
				Contact Masters Golf Cars today to reserve your golf cart rental. We're right here in Belleview, ready to serve you!
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
				<a href="/rent-a-golf-cart" class="bg-brand-green text-white font-bold py-4 px-8 rounded-lg hover:opacity-90 transition">
					Request a Rental
				</a>
				<a href="tel:3523070111" class="bg-white text-gray-900 font-bold py-4 px-8 rounded-lg hover:bg-gray-100 transition">
					Call (352) 307-0111
				</a>
			</div>
			<p class="text-gray-400 font-semibold">
				{companyData.location.full} | Serving Belleview Since 1999
			</p>
		</div>
	</section>

	<Schema schema={localBusinessSchema} />
</Layout>
