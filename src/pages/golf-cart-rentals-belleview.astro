---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import LocationPage from '../components/sections/LocationPage.astro';
import local from '../data/locations/golf-cart-rentals-belleview.json';
import { R } from '../lib/areas';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Masters Golf Cars - Belleview Golf Cart Rentals",
	"description": "Golf cart rentals in Belleview, FL. Our home location serving Belleview, Ocala, The Villages, and all of Marion County.",
	"url": "https://mastersgolfcars.com/golf-cart-rentals-belleview",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420"
	},
	"areaServed": [
		"Belleview",
		"Ocala",
		"The Villages",
		"Summerfield",
		"Marion County"
	],
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "29.034576",
		"longitude": "-82.025011"
	}
};
const rentalsBelleviewFAQs = [
	{
		question: "Where can I rent a golf cart in Belleview, FL?",
		answer: "Masters Golf Cars offers golf cart rentals from our location at 12885 S US Hwy 441, Belleview, FL 34420. We have been family-run since 1999. Call (352) 307-0111 to reserve a cart."
	},
	{
		question: "How much does it cost to rent a golf cart?",
		answer: "Golf cart rentals start at $300/week (about $43/day) for a 4-passenger cart, with a 3-day minimum. Exact rates vary by cart type, rental length, and location, and free delivery is included. Call (352) 307-0111 for a quick quote. A deposit is required to book."
	},
	{
		question: "Who is a reputable golf cart dealer in Belleview, FL?",
		answer: "Masters Golf Cars is a trusted, established Central Florida dealer based in Belleview. Family-run since 1999, we offer rentals, new and pre-owned sales, service and repairs, and custom builds."
	},
	{
		question: "What golf cart brands does Masters Golf Cars carry?",
		answer: "We work with Club Car, Yamaha, and EZ-GO golf carts, and we use Trojan batteries."
	},
	{
		question: "What areas do you serve for golf cart rentals?",
		answer: "We serve Belleview, Ocala, The Villages, Gainesville, and the surrounding Central Florida area across Marion, Sumter, Lake, and Alachua counties."
	},
	{
		question: "What are your hours and where are you located?",
		answer: "Our Belleview location is at 12885 S US Hwy 441, Belleview, FL 34420. We are open Monday through Friday 8:30am to 5:00pm and Saturday 9:00am to 2:00pm."
	}
];

const LEAD = ["Since 1999, Masters Golf Cars has been serving Belleview and surrounding Marion County with premium golf cart rentals. Located right here in Belleview at 12885 S US Highway 441 (across from the Market of Marion), we're your local golf cart rental experts.", "As Belleview's hometown golf cart dealership, we understand the unique needs of our local community. Whether you need a cart for exploring Belleview neighborhoods, accessing nearby Ocala or The Villages, or for local events, we have the perfect rental solution. Our convenient location makes pickup and delivery quick and easy for Belleview residents."];
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Locations", url: "https://mastersgolfcars.com/locations" },
	{ name: "Golf Cart Rentals in Belleview, FL", url: "https://mastersgolfcars.com/golf-cart-rentals-belleview" }
];
---

<Layout title="Golf Cart Rentals in Belleview, FL | Masters Golf Cars - Local Service" description="Rent golf carts in Belleview, FL. Our home location! Serving Belleview & surrounding areas. Delivery available. 26+ years experience. Call (352) 307-0111" canonical="https://mastersgolfcars.com/golf-cart-rentals-belleview" breadcrumbs={crumbs} quoteHref="#reserve">
	<Schema schema={localBusinessSchema} slot="schema" />
	<FAQSchema faqs={rentalsBelleviewFAQs} />
	<LocationPage kind="city" name="Belleview" slug="golf-cart-rentals-belleview" eyebrow="Golf cart rentals in Belleview, FL" heading="Golf cart rentals," accent="right here in Belleview." lead={LEAD} img={R + 'clubcar-row.jpg'} imgLabel="Our shop, on 441 across from the Market of Marion" proof={[["pin", "Home base", "12885 S US Hwy 441"], ["truck", "Delivered or pick up", "Same day when available"], ["key", "300+ carts", "Availability most weeks"], ["star", "4.9 on Google", "From 93 customer reviews"]]} local={local} faqs={rentalsBelleviewFAQs} defaultLocation="Belleview, FL" />
</Layout>
