---
import Layout from '../layouts/Layout.astro';
import FormShell from '../components/forms/FormShell.astro';
import ServiceRequestForm from '../components/forms/ServiceRequestForm.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import Btn from '../components/ui/Btn.astro';
const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Repairs", url: "https://mastersgolfcars.com/golf-cart-repairs" },
	{ name: "Schedule Service", url: "https://mastersgolfcars.com/schedule-golf-cart-service" }
];
---

<Layout title="Schedule Golf Cart Service - Masters Golf Cars" description="Schedule your golf cart service appointment in The Villages and Ocala" breadcrumbs={crumbs} quoteHref="#schedule">
	<FormShell id="schedule" eyebrow="Schedule service" heading="Tell us what it is" accent="doing." lead="Fill this out and our team will get back to you as soon as possible during business hours. Or just call." note="Between Ocala and The Villages, right on 441 across from the Market of Marion.">
		<ServiceRequestForm pageSource="schedule-golf-cart-service" idPrefix="svc" />
	</FormShell>
	<ProofBar items={[['clock', '24 hour repairs', 'Most jobs done next day'], ['truck', 'Pickup and delivery', 'We come get it, we bring it back'], ['wrench', 'Gas and electric', 'All major makes and models'], ['star', '4.9 on Google', 'From 93 customer reviews']]} />
	<section class="sec paper row" style="justify-content:center"><Btn href="/golf-cart-repairs" kind="ghost">See everything we fix</Btn></section>
</Layout>
