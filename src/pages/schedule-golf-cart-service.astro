---
import Layout from '../layouts/Layout.astro';
import companyData from '../data/company.json';
---

<Layout title="Schedule Golf Cart Service - Masters Golf Cars" description="Schedule your golf cart service appointment in The Villages and Ocala">
	<!-- Hero Section -->
	<section class="bg-white py-12">
		<div class="container mx-auto px-4 text-center">
			<h1 class="text-4xl md:text-5xl font-bold uppercase tracking-wide text-gray-900">Schedule Service</h1>
			<p class="mt-4 text-lg md:text-xl text-gray-700 font-medium">
				Please fill out the form below and someone will contact you promptly.
			</p>
		</div>
	</section>

	<!-- Main Content -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-3xl mx-auto">
				<div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 md:p-8 shadow-sm">
					<form
						name="service-request"
						method="POST"
						data-netlify="true"
						netlify-honeypot="bot-field"
						action="/success"
						class="space-y-5"
					>
						<input type="hidden" name="form-name" value="service-request" />
						<p class="hidden">
							<label>Don't fill this out if you're human: <input name="bot-field" /></label>
						</p>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="service-name" class="block text-sm font-bold text-gray-900 mb-1">Full Name <span class="text-red-600">*</span></label>
								<input type="text" id="service-name" name="name" required placeholder="Your name" autocomplete="name" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
							<div>
								<label for="service-phone" class="block text-sm font-bold text-gray-900 mb-1">Phone <span class="text-red-600">*</span></label>
								<input type="tel" id="service-phone" name="phone" required placeholder="(352) 555-1234" autocomplete="tel" inputmode="tel" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div>
							<label for="service-email" class="block text-sm font-bold text-gray-900 mb-1">Email <span class="text-red-600">*</span></label>
							<input type="email" id="service-email" name="email" required placeholder="you@email.com" autocomplete="email" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
						</div>

						<div>
							<label for="service-address" class="block text-sm font-bold text-gray-900 mb-1">Service Address / Community <span class="text-red-600">*</span></label>
							<input type="text" id="service-address" name="service_address" required placeholder="Where is the cart located?" autocomplete="street-address" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
							<div>
								<label for="service-make" class="block text-sm font-bold text-gray-900 mb-1">Cart Make</label>
								<input type="text" id="service-make" name="cart_make" placeholder="Club Car, EZGO, Yamaha..." class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
							<div>
								<label for="service-model" class="block text-sm font-bold text-gray-900 mb-1">Model</label>
								<input type="text" id="service-model" name="cart_model" placeholder="Precedent, RXV..." class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
							<div>
								<label for="service-year" class="block text-sm font-bold text-gray-900 mb-1">Year</label>
								<input type="text" id="service-year" name="cart_year" placeholder="e.g. 2020" inputmode="numeric" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="service-type" class="block text-sm font-bold text-gray-900 mb-1">Service Needed <span class="text-red-600">*</span></label>
								<select id="service-type" name="service_type" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none">
									<option value="">Select...</option>
									<option value="Routine maintenance / tune-up">Routine maintenance / tune-up</option>
									<option value="Battery service">Battery service</option>
									<option value="Tires / brakes">Tires / brakes</option>
									<option value="Won't start / electrical">Won't start / electrical</option>
									<option value="Body / cosmetic">Body / cosmetic</option>
									<option value="Lift kit / accessories">Lift kit / accessories</option>
									<option value="Diagnosis - not sure">Diagnosis - not sure</option>
									<option value="Other">Other</option>
								</select>
							</div>
							<div>
								<label for="service-date" class="block text-sm font-bold text-gray-900 mb-1">Preferred Date</label>
								<input type="date" id="service-date" name="preferred_date" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
							</div>
						</div>

						<div>
							<label for="service-details" class="block text-sm font-bold text-gray-900 mb-1">Describe the Issue <span class="text-red-600">*</span></label>
							<textarea id="service-details" name="details" rows="5" required placeholder="What is the cart doing? Any error sounds, lights, or recent changes?" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none"></textarea>
						</div>

						<div class="flex items-start gap-3 pt-1">
							<input type="checkbox" id="service-sms-consent" name="sms_consent" value="yes" class="mt-1 h-4 w-4 rounded border-gray-400 text-brand-green focus:ring-brand-green" />
							<label for="service-sms-consent" class="text-sm text-gray-700 leading-relaxed">
								I agree to receive SMS text messages from Masters Golf Cars in response to this inquiry, including appointment reminders, service updates, quotes, and follow-up communications. Message frequency varies. Msg and data rates may apply. Reply STOP to opt out or HELP for help. Consent is not a condition of purchase. See our <a href="/privacy-policy" class="text-brand-green font-bold underline hover:opacity-80">Privacy Policy</a> and <a href="/terms-conditions" class="text-brand-green font-bold underline hover:opacity-80">Terms and Conditions</a>.
							</label>
						</div>

						<button type="submit" class="w-full bg-brand-green text-white font-bold uppercase tracking-wide py-3 px-4 rounded-md hover:opacity-90 transition-colors">
							Request Service
						</button>

						<p class="text-center text-xs text-gray-500">
							Your information is secure and will never be shared.
						</p>
					</form>
				</div>

				<!-- Contact Info -->
				<div class="mt-16 bg-gray-100 rounded-3xl p-8 md:p-10 text-center shadow-lg">
					<h2 class="text-2xl font-bold mb-4 text-gray-900 uppercase tracking-wide">Need Immediate Assistance?</h2>
					<p class="text-lg text-gray-700 mb-4">
						Call us at <a href={companyData.contact.phoneLink} class="font-semibold text-brand-green hover:underline">
							{companyData.contact.phone}
						</a>
					</p>
					<p class="text-gray-600">{companyData.location.full}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Visit Our Location -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 uppercase tracking-wide">Visit Our Location</h2>
				<p class="text-lg text-gray-700 mb-2">
					We are located between Ocala and The Villages right on 441 across from the Market of Marion.
				</p>
				<p class="text-lg font-semibold text-gray-900 mb-8">{companyData.location.full}</p>

				<div class="rounded-2xl overflow-hidden shadow-xl border border-gray-200">
					<iframe
						src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6976.811623455518!2d-82.025011!3d29.034576000000005!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88e7cfcec122cd0d%3A0x530a32876eeda9ee!2sMasters%20Golf%20Cars!5e0!3m2!1sen!2sus!4v1762801860534!5m2!1sen!2sus"
						width="100%"
						height="450"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>
		</div>
	</section>

</Layout>

