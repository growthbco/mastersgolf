								<a href="/golf-cart-rentals" class="text-blue-600 hover:underline">Golf Cart Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/rent-a-golf-cart" class="text-blue-600 hover:underline">Rent a Golf Cart</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/fleet-rentals-quote" class="text-blue-600 hover:underline">Fleet Rentals Quote</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/the-villages-golf-cart-rentals" class="text-blue-600 hover:underline">The Villages Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/golf-cart-rentals-ocala" class="text-blue-600 hover:underline">Ocala Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/golf-cart-rentals-gainesville" class="text-blue-600 hover:underline">Gainesville Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/golf-cart-rentals-belleview" class="text-blue-600 hover:underline">Belleview Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/golf-cart-rentals-wec" class="text-blue-600 hover:underline">WEC Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/golf-cart-rentals-hits-ocala" class="text-blue-600 hover:underline">HITS Ocala Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/golf-cart-rentals-otow" class="text-blue-600 hover:underline">OTOW Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/golf-cart-rentals-spruce-creek" class="text-blue-600 hover:underline">Spruce Creek Rentals</a>
							</li>
							<li class="list-circle list-inside">
								<a href="/golf-cart-rentals-oak-run" class="text-blue-600 hover:underline">Oak Run Rentals</a>
							</li>
							<li class="list-circle list-inside">
