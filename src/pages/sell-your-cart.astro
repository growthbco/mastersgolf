---
import Layout from '../layouts/Layout.astro';
import FAQSchema from '../components/FAQSchema.astro';
import Schema from '../components/Schema.astro';
import HeroSplit from '../components/sections/HeroSplit.astro';
import Steps from '../components/sections/Steps.astro';
import Reviews from '../components/sections/Reviews.astro';
import Faq from '../components/sections/Faq.astro';
import FormShell from '../components/forms/FormShell.astro';
import SellCartForm from '../components/forms/SellCartForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Check from '../components/ui/Check.astro';
import { R } from '../lib/areas';

const faqs = [
	{
		question: 'What information do you need about my cart?',
		answer:
			'Please share the make, model, year, condition, mileage, and any upgrades. Photos help us provide an accurate quote quickly.',
	},
	{
		question: 'How fast can I receive an offer?',
		answer:
			'Most owners receive a response within one business day. If we need clarification or photos, we will reach out right away.',
	},
	{
		question: 'Do you pick up the golf cart?',
		answer:
			'Yes. Once we agree on a price, we coordinate local pickup or drop-off at our Belleview location,whatever is easier for you.',
	},
	{
		question: 'Can I sell multiple carts or a fleet?',
		answer:
			'Absolutely. We buy single carts as well as business, resort, or community fleets. Use the form to outline your needs.',
	},
];

const sellCartSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"@id": "https://mastersgolfcars.com/#localbusiness",
	"name": "Masters Golf Cars, LLC",
	"description": "Sell your golf cart quickly with Masters Golf Cars. Fair offers, simple process, and fast pickup for owners across Central Florida.",
	"url": "https://mastersgolfcars.com/sell-your-cart",
	"telephone": "+1-352-307-0111",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "12885 S US Hwy 441",
		"addressLocality": "Belleview",
		"addressRegion": "FL",
		"postalCode": "34420",
		"addressCountry": "US"
	}
};

const crumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Sell Your Cart", url: "https://mastersgolfcars.com/sell-your-cart" }
];
---

<Layout title="Sell Your Golf Cart - Masters Golf Cars" description="Sell your golf cart quickly with Masters Golf Cars. Fair offers, simple process, and fast pickup for owners across Central Florida." breadcrumbs={crumbs} quoteHref="#selloffer">
	<Schema schema={sellCartSchema} slot="schema" />
	<FAQSchema faqs={faqs} />

	<HeroSplit eyebrow="Sell your golf cart" heading="Get an offer on" accent="your cart." lead="Own a cart you are ready to part with? Tell us about it and one of our staff will contact you with an offer. Trade it toward a new one or sell it outright." cta="Get my offer" ctaHref="#selloffer" checks={['Gas and electric', 'Any condition considered', 'Trade toward a new cart', 'We can pick it up']} img={R + 'clubcar-row.jpg'} alt="Row of white Club Car golf carts" label="We buy carts" pos="50% 60%" />

	<Steps eyebrow="How it works" heading="Three steps to a check." lead="No listing, no strangers in your driveway." items={[['1', 'mail', 'Tell us about it', 'Make, model, year, gas or electric and any extras. Photos help.'], ['2', 'tag', 'Get an offer', 'We look it over and give you a number, in person or by phone.'], ['3', 'dollar', 'Get paid', 'Accept, and we handle the paperwork and pickup.']]} cta="Get my offer" ctaHref="#selloffer" />

	<section class="sec white why">
		<div class="head"><Eyebrow>Why sell to Masters</Eyebrow><h2 class="h2 md">Simple, fair and fast.</h2><p class="lead" style="max-width:440px">We sell and service carts every day, so we know what yours is worth.</p></div>
		<div class="check-list" style="gap:14px 24px">{['No online listing or tire kickers', 'Offer good whether you buy from us or not', 'Trade-in credit toward any cart in stock', 'Pickup available around Ocala and The Villages', 'We handle title and paperwork', 'Paid on the spot when we agree'].map((t) => <Check>{t}</Check>)}</div>
	</section>

	<Reviews heading="People who dealt with us." bg="paper" />
	<Faq items={faqs} heading="Selling questions." bg="white" />

	<FormShell id="selloffer" eyebrow="Sell your cart" heading="Tell us about" accent="your cart." lead="Fill this out and one of our experienced staff will contact you as soon as possible during business hours.">
		<SellCartForm />
	</FormShell>
</Layout>

<style>
	.why { display: grid; grid-template-columns: 1fr 1.6fr; gap: 80px; align-items: center; }
	@media (max-width: 1100px) { .why { grid-template-columns: 1fr; gap: 40px; } }
</style>
