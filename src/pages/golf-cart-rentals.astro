---
import Layout from '../layouts/Layout.astro';
import FAQSchema from '../components/FAQSchema.astro';
import Schema from '../components/Schema.astro';
import RentalInquiryForm from '../components/forms/RentalInquiryForm.astro';

// Service Schema for Golf Cart Rentals
const rentalServiceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	"@id": "https://mastersgolfcars.com/golf-cart-rentals/#service",
	"name": "Golf Cart Rental Services",
	"description": "High-quality golf cart rentals for neighborhoods, events, and businesses across Central Florida. We offer 2, 4, and 6 passenger carts along with utility models. Minimum 3-day rental with weekly and monthly options available.",
	"provider": {
		"@type": "AutoDealer",
		"name": "Masters Golf Cars, LLC",
		"url": "https://mastersgolfcars.com",
		"telephone": "+1-352-307-0111",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "12885 S US Hwy 441",
			"addressLocality": "Belleview",
			"addressRegion": "FL",
			"postalCode": "34420",
			"addressCountry": "US"
		}
	},
	"serviceType": "Golf Cart Rental",
	"areaServed": [
		{
			"@type": "City",
			"name": "The Villages",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Ocala",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Belleview",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Gainesville",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		}
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Rental Options",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Product",
					"name": "2-Seater Golf Cart Rental",
					"description": "Compact 2-passenger golf cart perfect for couples or individuals"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Product",
					"name": "4-Seater Golf Cart Rental",
					"description": "Standard 4-passenger golf cart ideal for families and small groups"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Product",
					"name": "6-Seater Golf Cart Rental",
					"description": "Extended 6-passenger golf cart for larger groups"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Product",
					"name": "Utility Golf Cart Rental",
					"description": "Utility cart for hauling and work purposes"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Fleet Rentals for Events",
					"description": "Large fleet rentals for weddings, festivals, concerts, and corporate events up to 150 miles"
				}
			}
		]
	},
	"termsOfService": "Minimum 3-day rental. Renters must be 21 years or older. Valid credit card required. Delivery and pick-up included.",
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Scott Lenhart"
			},
			"datePublished": "2024-11-08",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Fantastic people to work with. Delivered my rental cart on time as promised. Highly recommended!"
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Megan O'Brien"
			},
			"datePublished": "2024-09-15",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "They were excellent to work with! They gave us an excellent deal on a rental while they fixed ours. The staff there is extremely knowledgeable and professional."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Daniel Clark"
			},
			"datePublished": "2024-06-20",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "The carts were delivered the day before, so we weren't waiting on the day of. The carts performed the job and then some. I would highly recommend renting carts from this great company with awesome staff."
		}
	]
};

// Breadcrumbs for rentals page
const rentalsBreadcrumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals" }
];

const rentalFAQs = [
	{
		question: "What is the minimum age to rent a golf cart?",
		answer: "You must be 21 years old or older to rent a golf cart from Masters Golf Cars. This is our rule for all rentals."
	},
	{
		question: "Can I rent a golf cart for an event?",
		answer: "Yes! Masters Golf Cars rents golf carts for big events like festivals, weddings, rodeos, and concerts. We bring the carts to you and pick them up when you're done. We deliver up to 150 miles from our Belleview shop on US-441. That covers most of Central Florida!"
	},
	{
		question: "Do I need to pay a deposit?",
		answer: "You need a credit card to hold your rental, but we don't charge a separate deposit. Masters Golf Cars only charges your card based on what you agreed to in your rental deal."
	},
	{
		question: "Can I extend my rental period?",
		answer: "Yes! If you want to keep your golf cart longer, just call Masters Golf Cars. We'll check if the cart is free and add more days to your rental. Call us at (352) 307-0111 as soon as you know you need more time."
	},
	{
		question: "Do you offer delivery for golf cart rentals?",
		answer: "Yes! Masters Golf Cars delivers every rental for free. We bring carts to homes within 50 miles of Belleview. For events, we go up to 150 miles. That includes The Villages, Ocala, Gainesville, and lots of other towns in Central Florida."
	}
];
---

<Layout title="Golf Cart Rentals - Masters Golf Cars" description="Reserve high-quality golf cart rentals for neighborhoods, events, and businesses across Central Florida." breadcrumbs={rentalsBreadcrumbs}>
	<Schema schema={rentalServiceSchema} slot="schema" />
	<FAQSchema faqs={rentalFAQs} />
	<!-- Hero -->
	<section class="bg-white py-16">
		<div class="container mx-auto px-4 max-w-7xl">
			<h1 class="text-4xl md:text-5xl font-black text-gray-900 text-center mb-12">Golf Cart Rentals</h1>
			<div class="grid lg:grid-cols-2 gap-12 items-start">
				<div class="space-y-6">
					<h2 class="text-2xl md:text-3xl font-black text-gray-900">Enjoy the Convenience of Golf Cart Rentals</h2>
					<p class="text-gray-700 leading-relaxed font-semibold">
						Renting a golf cart from us is the perfect solution if you need reliable, affordable, and convenient transportation of a golf cart without the commitment of ownership. Whether you need a temporary golf cart for a quick getaway or a large event, we make it easier for you. Other customers come to us after facing issues with golf carts from other dealerships. While we repair their golf carts, they take advantage of our golf cart rental options, staying mobile without interruption. Renting a golf cart from us will give you peace of mind, whether for a short-term fix or a specific need.
					</p>
					<p class="text-gray-700 leading-relaxed font-semibold">
						We have a minimum 3-day golf cart rental, with options for weekly or monthly rentals for individuals. We also offer golf cart fleet rentals for businesses hosting events across Central Florida.
					</p>
					<ul class="space-y-2 text-gray-700 font-semibold">
						<li>• Individual &amp; Event Rentals</li>
						<li>• Delivery &amp; Pick Up Options</li>
					</ul>
					<div class="pt-4">
						<a href="/rent-a-golf-cart" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-green text-white font-bold uppercase tracking-wide hover:opacity-90 transition text-lg shadow-lg">
							Request a Rental
						</a>
					</div>
				</div>
				<div class="w-full">
					<img
						src="/images/golf-cart-rentals-page/club-car_img_v68_250813_154125925.webp"
						alt="Club Car golf cart rental"
						class="w-full h-auto object-contain"
						loading="eager"
						width="800"
						height="600"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Rental Options -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl font-black text-gray-900 text-center mb-10">Our Golf Rental Options</h2>
			<p class="text-center text-gray-700 max-w-3xl mx-auto mb-10 font-semibold">
				Choose from 2, 4, or 6 passenger golf carts along with utility models to fit your itinerary. Every cart is cleaned, inspected, and fully charged before it heads out the door.
			</p>
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-6 md:gap-8 max-w-5xl mx-auto text-center">
				<div class="bg-white border border-gray-200 rounded-2xl shadow-md p-8">
					<img src="/images/golf-cart-rentals-page/2-seater-golf-cart_img_v63_250813_142814136.webp" alt="2-seater golf cart" class="mx-auto h-40 md:h-48 object-contain mb-4" loading="lazy" />
					<p class="font-semibold text-gray-800 text-lg">2-Seater Cart</p>
				</div>
				<div class="bg-white border border-gray-200 rounded-2xl shadow-md p-8">
					<img src="/images/golf-cart-rentals-page/4-seater-golf-cart_img_v64_250813_142836603.webp" alt="4-seater golf cart" class="mx-auto h-40 md:h-48 object-contain mb-4" loading="lazy" />
					<p class="font-semibold text-gray-800 text-lg">4-Seater Cart</p>
				</div>
				<div class="bg-white border border-gray-200 rounded-2xl shadow-md p-8">
					<img src="/images/golf-cart-rentals-page/6-seater-golf-cart_img_v65_250813_142855008.webp" alt="6-seater golf cart" class="mx-auto h-40 md:h-48 object-contain mb-4" loading="lazy" />
					<p class="font-semibold text-gray-800 text-lg">6-Seater Cart</p>
				</div>
				<div class="bg-white border border-gray-200 rounded-2xl shadow-md p-8">
					<img src="/images/golf-cart-rentals-page/utility-cart_img_v66_250813_142912878.webp" alt="Utility golf cart" class="mx-auto h-40 md:h-48 object-contain mb-4" loading="lazy" />
					<p class="font-semibold text-gray-800 text-lg">Utility Cart</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Models Banner -->
	<section class="py-12" style="background-color: #86CA26;">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto bg-white rounded-3xl shadow-xl border-2 border-gray-200 px-8 py-10 flex flex-col lg:flex-row items-center justify-between gap-6 md:gap-8">
				<div class="text-center lg:text-left mb-4 lg:mb-0">
					<h3 class="text-2xl md:text-3xl font-black text-gray-900 uppercase tracking-wide">Golf Cart Models for Rent</h3>
					<p class="text-gray-700 mt-2 font-semibold text-base md:text-lg">Premium brands ready for neighborhoods, events, and commercial sites.</p>
				</div>
				<div class="flex items-center justify-center gap-6 md:gap-8 w-full lg:w-auto">
					<img src="/images/golf-cart-rentals-page/yamaha-logo-icon-0-0-250813163408273.webp" alt="Yamaha golf carts" class="h-12 md:h-16 object-contain" loading="lazy" />
					<img src="/images/golf-cart-rentals-page/club-car-logo-icon-0-1-250813163408445.webp" alt="Club Car golf carts" class="h-12 md:h-16 object-contain" loading="lazy" />
				</div>
			</div>
		</div>
	</section>

	<!-- How Rentals Work -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div class="w-full flex justify-center">
                    <img 
                        src="/images/golf-cart-rentals-page/golf-cart-rentals-in-the-villages_img_v69_250813_160043497.webp" 
                        alt="Golf cart rentals in the villages" 
                        class="max-w-md w-full h-auto object-contain" 
                        loading="lazy" 
                    />
                </div>
                <div class="space-y-6">
                    <p class="text-gray-700 font-semibold leading-relaxed">
                        If you're within 50 miles, we rent to individuals. If you're planning an event within 150 miles, please reach out to us! We're happy to accommodate weddings, concerts, corporate gatherings, and more.
                    </p>
                    <h3 class="text-3xl font-black text-gray-900">How Our Golf Cart Rentals Work</h3>
                    <ul class="space-y-4 text-gray-700 font-semibold">
                        <li>
                            <span class="font-black text-gray-900">Complete the Request Form</span><br />
                            <span>Submit your information using the form below to get started.</span>
                        </li>
                        <li>
                            <span class="font-black text-gray-900">Select the Golf Cart That Fits Your Needs</span><br />
                            <span>Choose from our available models based on what you'll need it for.</span>
                        </li>
                        <li>
                            <span class="font-black text-gray-900">Choose Your Rental Period</span><br />
                            <span>Rentals require a minimum of 3 days, with weekly and monthly options also available.</span>
                        </li>
                        <li>
                            <span class="font-black text-gray-900">Secure Your Reservation with a Credit Card</span><br />
                            <span>A valid credit card is needed to confirm and hold your rental.</span>
                        </li>
                        <li>
                            <span class="font-black text-gray-900">We Handle Delivery &amp; Pick-Up</span><br />
                            <span>Your cart will be delivered to your location and picked up once your rental ends—no extra hassle for you. Just enjoy your rental!</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
	</section>

	<!-- Pricing & Terms -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="grid lg:grid-cols-2 gap-12 items-start">
				<div class="bg-white rounded-[32px] shadow-2xl border border-gray-200 p-8 md:p-10">
					<h3 class="text-2xl font-black text-gray-900 mb-4">Rental Pricing</h3>
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						Our pricing structure is designed to be flexible for your schedule and affordable. For an exact quote, please get in touch with us or fill out the rental request form below.
					</p>
					<h4 class="text-xl font-black text-gray-900 mb-3">Golf Cart Rental Terms &amp; Conditions</h4>
					<ul class="space-y-3 text-gray-700 font-semibold">
						<li><span class="font-black text-gray-900">Age Requirement:</span> Renters must be at least 21 years old.</li>
						<li><span class="font-black text-gray-900">Payment:</span> A valid credit card is required to reserve your rental.</li>
						<li><span class="font-black text-gray-900">Rental Duration:</span> We offer 3-day minimums; day rentals are not available.</li>
						<li><span class="font-black text-gray-900">Delivery &amp; Pick-Up:</span> All rentals include free delivery and pick-up for your convenience.</li>
						<li>
							<span class="font-black text-gray-900">Service Area:</span><br />
							<span class="ml-4 block">Up to 50 miles for individual rentals</span><br />
							<span class="ml-4 block">Up to 150 miles for event and fleet rentals</span>
						</li>
						<li><span class="font-black text-gray-900">Availability:</span> Rentals are subject to availability. Advanced booking is highly recommended to secure your preferred dates.</li>
					</ul>
					<div class="mt-8">
						<a href="/rentals" class="inline-flex items-center justify-center px-8 py-3 rounded-full bg-brand-green text-white font-bold uppercase tracking-wide hover:opacity-90 transition">Reserve Your Golf Cart Today</a>
					</div>
				</div>
				<div class="w-full flex justify-center">
					<img 
						src="/images/golf-cart-rentals-page/yamaha-quietech-efi_img_v71_250813_161157847.webp" 
						alt="Yamaha Quietech EFI golf cart" 
						class="max-w-md w-full h-auto object-contain" 
						loading="lazy" 
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Rent -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<div class="w-full flex justify-center">
					<img 
						src="/images/golf-cart-rentals-page/rent-a-golf-cart_img_v72_250813_161858549.webp" 
						alt="Rent a golf cart" 
						class="max-w-md w-full h-auto object-contain" 
						loading="lazy" 
					/>
				</div>
				<div class="space-y-6">
					<h3 class="text-3xl font-black text-gray-900">Why Rent A Golf Cart From Us?</h3>
					<p class="text-gray-700 leading-relaxed font-semibold">
						Masters Golf Cars offers top-quality golf carts from trusted brands like Yamaha and Club Car. Whether you need reliable, affordable transportation for an event or a quick getaway, we have the perfect solution for you.
					</p>
					<p class="text-gray-700 leading-relaxed font-semibold">
						We offer flexible rental terms to fit your schedule—rent for days, weeks, or longer periods. Our convenient delivery and pick-up services make it easy for you to get the golf cart you need without any hassle.
					</p>
					<p class="text-gray-700 leading-relaxed font-semibold">
						We're the go-to choice for weddings, festivals, concerts, resorts, and corporate events across Central Florida. Our reliable carts and friendly service ensure your event runs smoothly.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Reviews -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<h3 class="text-3xl font-black text-gray-900 text-center mb-4">Reviews</h3>
			<div class="flex justify-center gap-1 mb-12">
				{Array.from({ length: 5 }).map((_star, index) => (
					<svg class="w-6 h-6" fill="#FFD700" viewBox="0 0 20 20">
						<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
					</svg>
				))}
			</div>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-white rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"Fantastic people to work with. Delivered my rental cart on time as promised. Highly recommended!"
					</p>
					<p class="font-black text-gray-900">-Scott Lenhart</p>
				</div>
				<div class="bg-white rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"They were excellent to work with! They gave us an excellent deal on a rental while they fixed ours. The staff there is extremely knowledgeable and professional."
					</p>
					<p class="font-black text-gray-900">-Megan O'Brien</p>
				</div>
				<div class="bg-white rounded-3xl shadow-lg p-8 border border-gray-100">
					<p class="text-gray-700 leading-relaxed mb-6 font-semibold">
						"The carts were delivered the day before, so we weren't waiting on the day of. The carts performed the job and then some. I would highly recommend renting carts from this great company with awesome staff."
					</p>
					<p class="font-black text-gray-900">-Daniel Clark</p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<h3 class="text-3xl font-black text-gray-900 text-center mb-10">Golf Cart Rentals FAQs</h3>
			<div class="max-w-4xl mx-auto space-y-3">
				<details class="bg-gray-50 rounded-2xl px-5 py-4 shadow">
					<summary class="font-black text-gray-900 cursor-pointer">What is the minimum age to rent a golf cart?</summary>
					<p class="mt-3 text-gray-700 font-semibold">You must be 21 years old or older to rent a golf cart from Masters Golf Cars. This is our rule for all rentals.</p>
				</details>
				<details class="bg-gray-50 rounded-2xl px-5 py-4 shadow">
					<summary class="font-black text-gray-900 cursor-pointer">Can I rent a golf cart for an event?</summary>
					<p class="mt-3 text-gray-700 font-semibold">Yes! Masters Golf Cars rents golf carts for big events like festivals, weddings, rodeos, and concerts. We bring the carts to you and pick them up when you're done. We deliver up to 150 miles from our Belleview shop on US-441. That covers most of Central Florida!</p>
				</details>
				<details class="bg-gray-50 rounded-2xl px-5 py-4 shadow">
					<summary class="font-black text-gray-900 cursor-pointer">Do I need to pay a deposit?</summary>
					<p class="mt-3 text-gray-700 font-semibold">You need a credit card to hold your rental, but we don't charge a separate deposit. Masters Golf Cars only charges your card based on what you agreed to in your rental deal.</p>
				</details>
				<details class="bg-gray-50 rounded-2xl px-5 py-4 shadow">
					<summary class="font-black text-gray-900 cursor-pointer">Can I extend my rental period?</summary>
					<p class="mt-3 text-gray-700 font-semibold">Yes! If you want to keep your golf cart longer, just call Masters Golf Cars. We'll check if the cart is free and add more days to your rental. Call us at (352) 307-0111 as soon as you know you need more time.</p>
				</details>
				<details class="bg-gray-50 rounded-2xl px-5 py-4 shadow">
					<summary class="font-black text-gray-900 cursor-pointer">Do you offer delivery for golf cart rentals?</summary>
					<p class="mt-3 text-gray-700 font-semibold">Yes! Masters Golf Cars delivers every rental for free. We bring carts to homes within 50 miles of Belleview. For events, we go up to 150 miles. That includes The Villages, Ocala, Gainesville, and lots of other towns in Central Florida.</p>
				</details>
			</div>
			<div class="text-center mt-12">
				<a href="/rentals" class="inline-flex items-center justify-center px-10 py-4 rounded-full bg-brand-green text-white font-bold uppercase tracking-wide hover:opacity-90 transition">
					Rent Your Golf Cart Today
				</a>
			</div>
		</div>
	</section>

	<!-- Event Rentals Section -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl font-black text-gray-900 text-center mb-10">Rentals by Event Type</h2>
				<p class="text-center text-gray-700 max-w-3xl mx-auto mb-10 font-semibold">
					We provide golf cart rentals for special events throughout Central Florida. From intimate weddings to large festivals, we have the fleet to support your event.
				</p>
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
					<div class="bg-white rounded-lg p-6 border border-gray-200 text-center">
						<h3 class="text-xl font-bold text-gray-900 mb-3">Wedding Rentals</h3>
						<p class="text-gray-700 font-semibold mb-4 text-sm">
