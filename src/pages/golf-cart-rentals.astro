---
import Layout from '../layouts/Layout.astro';
import FAQSchema from '../components/FAQSchema.astro';
import Schema from '../components/Schema.astro';
import RentalInquiryForm from '../components/forms/RentalInquiryForm.astro';
import FormShell from '../components/forms/FormShell.astro';
import HeroSplit from '../components/sections/HeroSplit.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import Steps from '../components/sections/Steps.astro';
import Faq from '../components/sections/Faq.astro';
import Reviews from '../components/sections/Reviews.astro';
import CartCard from '../components/sections/CartCard.astro';
import LinkList from '../components/sections/LinkList.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Ring from '../components/ui/Ring.astro';
import { AREAS, R } from '../lib/areas';

// Service Schema for Golf Cart Rentals
const rentalServiceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	"@id": "https://mastersgolfcars.com/golf-cart-rentals/#service",
	"name": "Golf Cart Rental Services",
	"description": "High-quality golf cart rentals for neighborhoods, events, and businesses across Central Florida. We offer 2, 4, and 6 passenger carts along with utility models. Minimum 3-day rental with weekly and monthly options available.",
	"provider": {
		"@type": "LocalBusiness",
		"name": "Masters Golf Cars, LLC",
		"url": "https://mastersgolfcars.com",
		"telephone": "+1-352-307-0111",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "12885 S US Hwy 441",
			"addressLocality": "Belleview",
			"addressRegion": "FL",
			"postalCode": "34420",
			"addressCountry": "US"
		},
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": "5",
			"bestRating": "5",
			"worstRating": "1",
			"reviewCount": "150"
		}
	},
	"serviceType": "Golf Cart Rental",
	"areaServed": [
		{
			"@type": "City",
			"name": "The Villages",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Ocala",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Belleview",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		},
		{
			"@type": "City",
			"name": "Gainesville",
			"containedInPlace": { "@type": "State", "name": "Florida" }
		}
	],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Golf Cart Rental Options",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Product",
					"name": "2-Seater Golf Cart Rental",
					"description": "Compact 2-passenger golf cart perfect for couples or individuals"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Product",
					"name": "4-Seater Golf Cart Rental",
					"description": "Standard 4-passenger golf cart ideal for families and small groups"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Product",
					"name": "6-Seater Golf Cart Rental",
					"description": "Extended 6-passenger golf cart for larger groups"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Product",
					"name": "Utility Golf Cart Rental",
					"description": "Utility cart for hauling and work purposes"
				}
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Fleet Rentals for Events",
					"description": "Large fleet rentals for weddings, festivals, concerts, and corporate events up to 150 miles"
				}
			}
		]
	},
	"termsOfService": "Minimum 3-day rental. Renters must be 21 years or older. Valid credit card required. Delivery and pick-up included.",
	"review": [
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Scott Lenhart"
			},
			"datePublished": "2024-11-08",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "Fantastic people to work with. Delivered my rental cart on time as promised. Highly recommended!"
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Megan O'Brien"
			},
			"datePublished": "2024-09-15",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "They were excellent to work with! They gave us an excellent deal on a rental while they fixed ours. The staff there is extremely knowledgeable and professional."
		},
		{
			"@type": "Review",
			"author": {
				"@type": "Person",
				"name": "Daniel Clark"
			},
			"datePublished": "2024-06-20",
			"reviewRating": {
				"@type": "Rating",
				"ratingValue": "5",
				"bestRating": "5"
			},
			"reviewBody": "The carts were delivered the day before, so we weren't waiting on the day of. The carts performed the job and then some. I would highly recommend renting carts from this great company with awesome staff."
		}
	]
};

// Breadcrumbs for rentals page
const rentalsBreadcrumbs = [
	{ name: "Home", url: "https://mastersgolfcars.com" },
	{ name: "Golf Cart Rentals", url: "https://mastersgolfcars.com/golf-cart-rentals" }
];

const rentalFAQs = [
	{ question: "Is there a minimum rental?", answer: "Yes, 3 days. After that, rent by the week, the month or the season." },
	{ question: "How old do I have to be?", answer: "Renters must be 21 or older with a valid driver license." },
	{ question: "Do I need to charge it?", answer: "No. Our rental carts are gas powered, so there is nothing to plug in." },
	{ question: "Can I extend?", answer: "Yes. Call us at (352) 307-0111 before your end date and we will extend it if the cart is available." },
	{ question: "Do you deliver to The Villages?", answer: "Yes, every neighborhood, along with Ocala, Belleview, Summerfield and the surrounding towns. Delivery is quoted with your reservation." },
	{ question: "Do I need to pay a deposit?", answer: "You need a credit card to hold your rental, but we do not charge a separate deposit. Your card is only charged for what you agreed to in your rental agreement." },
	{ question: "What if something goes wrong?", answer: "Call us. Roadside help is available through 24hr Cart Club, and we will get you a replacement cart if needed." },
];
---

<Layout title="Golf Cart Rentals - Masters Golf Cars" description="Reserve high-quality golf cart rentals for neighborhoods, events, and businesses across Central Florida." breadcrumbs={rentalsBreadcrumbs} quoteHref="#reserve">
	<Schema schema={rentalServiceSchema} slot="schema" />
	<FAQSchema faqs={rentalFAQs} />

	<HeroSplit eyebrow="Golf cart rentals, The Villages and Ocala" heading="Your stay. Your needs." accent="Your cart." lead="Clean, late model carts delivered to your door. A week, a month or the whole season. We bring it, you drive it, we pick it up." cta="Reserve a cart" ctaHref="#reserve" checks={['Delivery and pickup included', '2, 4 and 6 passenger, plus utility', '3 day minimum', 'Rentals since 1999']} img={R + 'yamaha-aisle.jpg'} alt="Rows of Yamaha rental golf carts at the Masters lot" label="Over 300 carts in the rental fleet" pos="50% 55%" />
	<ProofBar items={[['key', '300+ carts', 'The largest rental fleet around'], ['truck', 'Delivered to you', 'Home, rental or venue'], ['calendar', 'Week, month, season', '3 day minimum'], ['star', '4.9 on Google', 'From 93 customer reviews']]} />

	<section id="carts" class="sec white stack" style="gap:48px">
		<div class="head"><Eyebrow>Pick your cart</Eyebrow><h2 class="h2">Four ways to <span class="g">get around.</span></h2><p class="lead">Quiet, dependable Yamaha and Club Car carts. Tell us how many seats and we will do the rest.</p></div>
		<div class="grid4 cards">
			<CartCard href="#reserve" img={R + 'cart-2p.jpg'} alt="Two passenger Yamaha rental golf cart" title="2 passenger" sub="Couples and solo stays. Easy to park at the squares." price="Call for weekly rate" />
			<CartCard href="#reserve" img={R + 'cart-4p-deluxe.jpg'} alt="Four passenger Yamaha rental golf cart with sun top" title="4 passenger" sub="Our most popular. Family, friends and groceries." price="From <strong>$300</strong> a week" badge="Most popular" />
			<CartCard href="#reserve" img={R + 'cart-6p.jpg'} alt="Six passenger rental golf cart" title="6 passenger" sub="The whole crew when family visits." price="Call for weekly rate" />
			<CartCard href="#reserve" img={R + 'carryall.jpg'} alt="Club Car Carryall utility cart" title="Utility cart" sub="Cargo bed for gear, feed and supplies." price="Call for rates" contain />
		</div>
	</section>

	<section class="sec dark on-dark inc">
		<div class="head"><Eyebrow>What is included</Eyebrow><h2 class="h2">The quote you get is <span class="g">the price you pay.</span></h2><p class="lead" style="max-width:460px">No delivery fee surprises, no hidden charges.</p></div>
		<div class="inc-grid">
			{[['truck', 'Delivery and pickup', 'To your home, rental or venue on the dates you choose.'], ['shield', 'Roadside help', 'Through our partner 24hr Cart Club, across The Villages.'], ['wrench', 'A clean, checked cart', 'Every cart is cleaned and inspected before it goes out.'], ['phone', 'A real person on the phone', 'Mon to Fri 8:30 to 5, Sat 9 to 2. Extend by phone anytime.']].map(([i, t, s]) => (
				<div class="inc-item"><Ring name={i} fill /><div class="fd" style="font-size:18px;line-height:24px">{t}</div><div class="small" style="font-size:15px;line-height:24px">{s}</div></div>
			))}
		</div>
	</section>

	<Steps eyebrow="How renting works" heading="Three steps. No hassle." lead="Book online or call. We handle the rest." items={[['1', 'key', 'Pick your cart', '2, 4 or 6 seats, or a utility cart.'], ['2', 'calendar', 'Pick your dates', 'A week, a month or the whole season. 3 day minimum.'], ['3', 'truck', 'We deliver it and pick it up', 'Right to your driveway or venue. When you are done, we come get it.']]} cta="Reserve a cart" ctaHref="#reserve" />

	<section class="sec white areas">
		<div class="head"><Eyebrow>Where we deliver</Eyebrow><h2 class="h2 md">Big event or small getaway.<br />We bring the cart to you.</h2><p class="lead" style="max-width:440px">Local service in Marion, Sumter, Lake and Alachua counties. Statewide for events.</p></div>
		<LinkList items={AREAS} cols={3} />
	</section>

	<Reviews heading="Snowbirds, families and visitors." bg="paper" />
	<Faq items={rentalFAQs} heading="Before you book." bg="white" />

	<FormShell id="reserve" eyebrow="Reserve your cart" heading="Let us get you" accent="rolling." lead="Fill this out and our rental manager will check availability and get back to you as soon as possible during business hours.">
		<RentalInquiryForm pageSource="golf-cart-rentals" idPrefix="rent" />
	</FormShell>
</Layout>

<style>
	.inc { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: center; }
	.inc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
	.inc-item { display: flex; flex-direction: column; gap: 14px; padding-top: 24px; border-top: 1px solid var(--line-d); }
	.areas { display: grid; grid-template-columns: 1fr 1.6fr; gap: 80px; align-items: center; }
	@media (max-width: 1100px) { .inc, .areas { grid-template-columns: 1fr; gap: 40px; } }
	@media (max-width: 760px) { .inc-grid { grid-template-columns: 1fr; gap: 24px; } .cards { grid-template-columns: 1fr; } }
</style>
