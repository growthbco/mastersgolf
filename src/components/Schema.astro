---
/**
 * Schema.astro - Reusable JSON-LD Schema Component
 *
 * This component renders JSON-LD structured data for SEO purposes.
 * It accepts a schema object and renders it as a script tag with type="application/ld+json".
 *
 * Usage:
 * <Schema schema={yourSchemaObject} />
 *
 * Or for multiple schemas:
 * <Schema schema={[schema1, schema2]} />
 */

interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;

// Ensure schema is always an array for consistent handling
const schemas = Array.isArray(schema) ? schema : [schema];
---

{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s, null, 2)} />
))}
