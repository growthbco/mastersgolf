---
import Icon from './ui/Icon.astro';
import companyData from '../data/company.json';

interface Props { quoteHref?: string }
const { quoteHref = '#quote' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
	{ label: 'Home', href: '/' },
	{ label: 'Rentals', href: '/golf-cart-rentals' },
	{ label: 'Fleet & Events', href: '/fleet-rentals-quote' },
	{ label: 'Bolt Lithium', href: '/bolt-lithium' },
	{ label: 'Customize', href: '/customize' },
	{ label: 'Service', href: '/golf-cart-repairs' },
	{ label: 'Carts for Sale', href: '/golf-cart-inventory' },
];
const more = [
	{ label: 'Sell your cart', href: '/sell-your-cart' },
	{ label: 'Locations we serve', href: '/locations' },
	{ label: 'Gallery', href: '/gallery' },
	{ label: 'About Masters', href: '/about' },
	{ label: 'FAQ', href: '/faq' },
	{ label: 'Blog', href: '/blog' },
	{ label: 'Contact', href: '/contact' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '-'));
---

<div class="util">
	<span class="row tag"><Icon name="award" size={16} color="#f9b406" /><span>Proudly serving The Villages, Ocala, Marion County and Central Florida since 1999</span></span>
	<span class="row" style="display:none" data-mobile-tag><Icon name="award" size={16} color="#f9b406" /><span>Since 1999</span></span>
	<span class="right">
		<span class="row"><Icon name="pin" size={16} color="#f9b406" /><span>12885 S US Hwy 441, Belleview</span></span>
		<span class="row"><Icon name="clock" size={16} color="#f9b406" /><span>Mon to Fri 8:30 to 5, Sat 9 to 2</span></span>
		<a class="row" href={companyData.contact.phoneLink}><Icon name="phone" size={16} color="#f9b406" /><span>{companyData.contact.phone}</span></a>
	</span>
</div>
<header class="hdr">
	<a class="logo" href="/" aria-label="Masters Golf Cars home"><img src="/images/redesign/masters-logo.png" alt="Masters Golf Cars, LLC" width="200" height="66" /></a>
	<nav aria-label="Main">
		{nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
	</nav>
	<div class="row" style="gap:10px">
		<a class="btn solid sm cta" href={quoteHref}><span>Get a quote</span><Icon name="arrow" size={18} /></a>
		<button type="button" class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="site-drawer" data-menu-toggle><Icon name="menu" size={24} sw={1.75} /></button>
	</div>
</header>
<div class="flame-line"></div>

<div class="drawer" id="site-drawer" aria-hidden="true">
	{nav.map((n) => <a href={n.href}>{n.label}<Icon name="arrow" size={20} /></a>)}
	<div class="label">More</div>
	<div class="sub">{more.map((n) => <a href={n.href}>{n.label}</a>)}</div>
	<div class="contact">
		<a href={companyData.contact.phoneLink}><Icon name="phone" size={18} color="#f9b406" />{companyData.contact.phone}</a>
		<span class="row" style="gap:10px"><Icon name="pin" size={18} color="#f9b406" />{companyData.location.full}</span>
		<span class="row" style="gap:10px"><Icon name="clock" size={18} color="#f9b406" />Mon to Fri 8:30 to 5, Sat 9 to 2</span>
	</div>
</div>

<style>
	@media (max-width: 960px) {
		.util .tag { display: none !important; }
		.util [data-mobile-tag] { display: flex !important; }
		.util .right a { display: flex; }
	}
</style>
<script>
	const btn = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
	const drawer = document.getElementById('site-drawer');
	if (btn && drawer) {
		const set = (open: boolean) => {
			drawer.classList.toggle('open', open);
			drawer.setAttribute('aria-hidden', String(!open));
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			document.body.classList.toggle('menu-open', open);
			btn.innerHTML = open
				? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>'
				: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>';
		};
		btn.addEventListener('click', () => set(!drawer.classList.contains('open')));
		drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
	}
</script>
