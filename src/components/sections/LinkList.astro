---
import Icon from '../ui/Icon.astro';
interface Props { items: [string, string][]; cols?: number }
const { items, cols = 3 } = Astro.props;
---
<div class="ll" style={`--c:${cols}`}>{items.map(([n, h]) => <a href={h}><span class="row" style="gap:12px"><Icon name="pin" size={18} /><span>{n}</span></span><Icon name="arrow" size={18} /></a>)}</div>
<style>
	.ll { display: grid; grid-template-columns: repeat(var(--c), minmax(0, 1fr)); gap: 0 40px; border-top: 1px solid var(--line); }
	.ll a { display: flex; align-items: center; justify-content: space-between; min-height: 56px; border-bottom: 1px solid var(--line); font-size: 15px; font-weight: 500; color: var(--ink); }
	.ll a:hover { color: var(--green-ink); }
	@media (max-width: 1100px) { .ll { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 760px) { .ll { grid-template-columns: 1fr; } }
</style>
