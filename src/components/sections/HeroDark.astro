---
import Eyebrow from '../ui/Eyebrow.astro';
import Btn from '../ui/Btn.astro';
import companyData from '../../data/company.json';
interface Props { eyebrow: string; heading: string; accent?: string; lead: string; cta: string; ctaHref: string; img: string; alt: string; pos?: string; video?: string; secondCta?: string; secondHref?: string; color?: boolean }
const { eyebrow, heading, accent, lead, cta, ctaHref, img, alt, pos = '50% 55%', video, secondCta = `Call ${companyData.contact.phone}`, secondHref = companyData.contact.phoneLink, color = false } = Astro.props;
---
<section class="hd on-dark">
	{video ? (
		<video autoplay muted loop playsinline preload="metadata" poster={img} aria-label={alt} class:list={[{ color }]} style={`object-position:${pos}`}><source src={video.replace('.mp4', '.webm')} type="video/webm" /><source src={video} type="video/mp4" /></video>
	) : (
		<img src={img} alt={alt} class:list={[{ color }]} style={`object-position:${pos}`} fetchpriority="high" width="1440" height="640" />
	)}
	<div class="shade"></div>
	<div class="hd-copy">
		<Eyebrow>{eyebrow}</Eyebrow>
		<h1 class="h1 hd-h"><Fragment set:html={heading} /> {accent && <span class="g">{accent}</span>}</h1>
		<p class="lead" style="max-width:620px">{lead}</p>
		<div class="row btn-row" style="gap:16px"><Btn href={ctaHref} kind="solid">{cta}</Btn><Btn href={secondHref} kind="ghost-d">{secondCta}</Btn></div>
	</div>
</section>
<style>
	.hd { position: relative; min-height: 640px; padding: 88px var(--gx) 72px; display: flex; flex-direction: column; justify-content: center; overflow: hidden; background: var(--black); }
	.hd video, .hd img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); }
	.hd .color { filter: none; }
	.shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,8,8,.9) 0%, rgba(8,8,8,.62) 50%, rgba(8,8,8,.14) 100%); }
	.hd-copy { position: relative; display: flex; flex-direction: column; gap: 26px; max-width: 1000px; }
	.hd-h { font-size: 76px; line-height: 1.02; letter-spacing: -0.015em; color: #fff; }
	@media (max-width: 1100px) { .hd-h { font-size: 56px; } }
	@media (max-width: 760px) { .hd { min-height: 0; padding: 56px var(--gx) 48px; } .hd-h { font-size: 40px; } .shade { background: linear-gradient(180deg, rgba(8,8,8,.82), rgba(8,8,8,.6)); } }
</style>
