---
import Icon from '../ui/Icon.astro';
interface Props { href?: string; img: string; alt: string; title: string; sub: string; price?: string; badge?: string; contain?: boolean; pos?: string }
const { href = '#', img, alt, title, sub, price, badge, contain = false, pos = '50% 55%' } = Astro.props;
---
<a href={href} class="cc">
	<div class="cc-ph" style={contain ? 'padding:16px;background:#fff' : ''}><img src={img} alt={alt} loading="lazy" width="640" height="480" style={`object-fit:${contain ? 'contain' : 'cover'};object-position:${pos}`} />{badge && <span class="badge">{badge}</span>}</div>
	<div class="cc-body"><h3 class="h3">{title}</h3><p class="body" style="font-size:15px;line-height:24px">{sub}</p><div class="cc-foot"><span set:html={price ?? ''} /><span class="sq"><Icon name="arrow" size={18} /></span></div></div>
</a>
<style>
	.cc { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); color: var(--ink); transition: transform .15s; }
	.cc:hover { transform: translateY(-2px); }
	.cc-ph { position: relative; height: 240px; overflow: hidden; background: var(--paper); }
	.cc-ph img { display: block; width: 100%; height: 100%; }
	.badge { position: absolute; left: 0; top: 0; padding: 8px 14px; background: var(--green); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); }
	.cc-body { display: flex; flex-direction: column; gap: 10px; flex-grow: 1; padding: 24px 26px; }
	.cc-foot { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; font-size: 15px; }
	.sq { width: 40px; height: 40px; background: var(--ink); color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
	@media (max-width: 760px) { .cc-ph { height: 180px; } .cc-body { padding: 16px; } }
</style>
