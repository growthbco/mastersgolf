---
import Ring from '../ui/Ring.astro';
interface Props { items: [string, string, string][] }
const { items } = Astro.props;
---
<section class="proofbar">
	{items.map(([i, b, s]) => <div class="row" style="gap:18px"><Ring name={i} /><div class="stack" style="gap:4px"><div class="fd pbig">{b}</div><div class="small">{s}</div></div></div>)}
</section>
<style>
	.proofbar { padding: 0 var(--gx); min-height: 150px; background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; gap: 24px; align-items: center; }
	.pbig { font-size: 16px; line-height: 22px; white-space: nowrap; }
	@media (max-width: 1100px) { .proofbar { flex-wrap: wrap; padding-top: 24px; padding-bottom: 24px; } }
	@media (max-width: 760px) { .proofbar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 12px; padding: 28px var(--gx); } .proofbar :global(.ring) { width: 44px; height: 44px; } .pbig { font-size: 12px; line-height: 16px; white-space: normal; } .proofbar .small { font-size: 12px; line-height: 16px; } }
</style>
