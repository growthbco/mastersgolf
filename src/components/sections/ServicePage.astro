---
/* Service and repair template. Used by /golf-cart-repairs and the three city repair pages. */
import Eyebrow from '../ui/Eyebrow.astro';
import Ring from '../ui/Ring.astro';
import Btn from '../ui/Btn.astro';
import Check from '../ui/Check.astro';
import Icon from '../ui/Icon.astro';
import ProofBar from './ProofBar.astro';
import Steps from './Steps.astro';
import Reviews from './Reviews.astro';
import Faq from './Faq.astro';
import FormShell from '../forms/FormShell.astro';
import ServiceRequestForm from '../forms/ServiceRequestForm.astro';
import companyData from '../../data/company.json';
import { R } from '../../lib/areas';
import LocalContent from './LocalContent.astro';

interface Props {
	city?: string;               // e.g. "Ocala" for city pages
	eyebrow?: string;
	lead?: string;
	pageSource: string;
	faqs: { question: string; answer: string }[];
	defaultLocation?: string;
	intro?: string;
	local?: { sections: any[] };
}
const { city, eyebrow = city ? `Golf cart repair, ${city}` : 'Service and repair, Belleview', lead = city ? `Serving ${city} from our shop in Belleview. Gas and electric. Club Car, Yamaha, E-Z-GO and more. Most repairs are done in 24 hours, and we can pick your cart up and bring it back.` : 'Gas and electric. Club Car, Yamaha, E-Z-GO and more. Most repairs are done in 24 hours, and we can pick your cart up and bring it back.', pageSource, faqs, defaultLocation = '', intro, local } = Astro.props;

const GAS = ['Engine maintenance and tune ups', 'Belt replacement', 'Fuel system repairs', 'Battery and electrical system', 'Exhaust system repairs', 'Transmission and clutch', 'Tires, wheels and upgrades', 'Lighting upgrades'];
const ELEC = ['Battery testing and replacement', 'Charging system service', 'Motor and controller repair and upgrades', 'Electrical troubleshooting', 'Motor brushes and bearings', 'Brakes, tires and wheels', 'Lighting upgrades', 'Lithium conversions'];
const SIGNS: [string, string, string][] = [['volume', 'Strange noises', 'Grinding, squealing or knocking usually means a motor, brake or suspension part is on its way out.'], ['gauge', 'Slow performance', 'Losing speed points to the engine, batteries or electrical system.'], ['battery', 'Battery problems', 'Not holding a charge or dying quickly. Often a battery, sometimes a charger.'], ['shield', 'Brakes not right', 'Noise when stopping or a soft pedal. Do not put this one off.'], ['feather', 'Rough or bumpy ride', 'Vibration or pulling means suspension, alignment or worn tires.'], ['zap', 'Lights flickering', 'Headlights or taillights cutting out is an electrical issue.'], ['drop', 'Burning smells', 'A sign of overheating or an electrical fault. Stop driving and call.'], ['key', 'Hard to start', 'Slow to start or will not start at all. Usually ignition or starter.']];
---
<section class="hs paper">
	<div class="stack" style="gap:28px">
		<Eyebrow>{eyebrow}</Eyebrow>
		<h1 class="h1 hs-h">Keep your cart <span class="g">moving.</span></h1>
		<p class="lead" style="max-width:540px">{lead}</p>
		<div class="row btn-row" style="gap:16px"><Btn href="#schedule">Schedule service</Btn><Btn href={companyData.contact.phoneLink} kind="ghost">Call {companyData.contact.phone}</Btn></div>
		<div class="check-list" style="gap:14px 24px">{['Most repairs done in 24 hours', 'Pickup and delivery available', 'Written estimate before any work', 'Over 25 years in Belleview'].map((c) => <Check>{c}</Check>)}</div>
	</div>
	<div class="hs-ph"><img src={R + 'clubcar-utility-row.jpg'} alt="Row of Club Car utility carts in the Masters lot" width="640" height="560" fetchpriority="high" style="object-position:50% 60%" /><div class="hs-label fd">On 441, across from the Market of Marion</div></div>
</section>
<ProofBar items={[['clock', '24 hour repairs', 'Most jobs done next day'], ['truck', 'Pickup and delivery', 'We come get it, we bring it back'], ['wrench', 'Gas and electric', 'All major makes and models'], ['star', '4.9 on Google', 'From 93 customer reviews']]} />

{intro && <section class="sec white" style="padding-bottom:0"><div class="intro"><Fragment set:html={intro} /></div></section>}

<section class="sec white stack" style="gap:48px">
	<div class="head"><Eyebrow>What we fix</Eyebrow><h2 class="h2">Gas or electric. <span class="g">We do both.</span></h2><p class="lead">From a tune up to a full rebuild, our Belleview shop handles it in house.</p></div>
	<div class="fix-grid">
		{[['wrench', 'Gas carts', 'Yamaha, Club Car, E-Z-GO and more', GAS], ['zap', 'Electric carts', '36, 48 and 72 volt', ELEC]].map(([i, t, s, items]) => (
			<div class="stack" style="gap:24px">
				<div class="row" style="gap:18px"><Ring name={i as string} fill /><div class="stack" style="gap:4px"><h3 class="h3" style="font-size:24px;line-height:1.1">{t}</h3><span class="small" style="font-size:15px">{s}</span></div></div>
				<div class="fix-list">{(items as string[]).map((x) => <div class="fix"><Icon name="check" size={18} sw={2} color="#2f6b0c" /><span>{x}</span></div>)}</div>
			</div>
		))}
	</div>
</section>

{local && <LocalContent sections={local.sections} eyebrow={`Golf cart repair in ${city}`} />}

<Steps eyebrow="How it works" heading="Drop it off. Or we come get it." lead="Five steps, and you know the price before any work starts." items={[['1', 'search', 'We inspect it', 'We find the problem with proper diagnostic tools, not guesswork.'], ['2', 'tag', 'You get an estimate', 'What it needs, what it costs and how long it takes, in writing, before we touch anything.'], ['3', 'wrench', 'We do the work', 'Most repairs are finished within 24 hours of your approval.'], ['4', 'check', 'We test it', 'Every cart is test driven before it leaves the shop.'], ['5', 'truck', 'Pickup or delivery', 'Grab it at the shop or our driver brings it back to you.']]} />

<section class="sec white stack" style="gap:48px">
	<div class="signs-head">
		<div class="head"><Eyebrow>Signs you need a repair</Eyebrow><h2 class="h2">Hearing something new? Bring it in.</h2><p class="lead" style="max-width:620px">Small problems get expensive when they wait. Any of these is worth a call.</p></div>
		<div class="row"><Btn href="#schedule">Schedule service</Btn></div>
	</div>
	<div class="signs">{SIGNS.map(([i, t, s]) => <div class="sign"><Ring name={i} /><h3 class="h3" style="font-size:18px;line-height:24px">{t}</h3><p class="body" style="font-size:15px;line-height:24px">{s}</p></div>)}</div>
</section>

<section class="sec dark on-dark lith">
	<div class="stack" style="gap:28px">
		<div class="head"><Eyebrow green>Bolt Energy lithium</Eyebrow><h2 class="h2" style="font-size:44px">Tired of replacing<br />lead-acid batteries? <span class="g">Go lithium.</span></h2><p class="lead" style="max-width:520px">One Bolt pack replaces the whole tray. Up to 70 miles on a charge, 2 to 4 hour charging, zero watering and a 12 year warranty. Installed here in our shop.</p></div>
		<div class="row btn-row" style="gap:16px"><Btn href="/bolt-lithium" kind="green">Get my conversion price</Btn><Btn href="/bolt-lithium" kind="ghost-d">Learn about lithium</Btn></div>
	</div>
	<img src={R + 'bolt-trio.jpg'} alt="Three Bolt lithium golf cart batteries stacked in front of a golf cart" loading="lazy" width="620" height="420" class="lith-img" />
</section>

<section class="sec paper road">
	<div class="head"><Eyebrow>24 hour roadside assistance</Eyebrow><h2 class="h2 md">Stranded? Help is a call away.</h2><p class="lead" style="max-width:460px">We partner with 24hr Cart Club for emergency roadside help across The Villages and the surrounding area. Buy a new cart from us and your first year of membership is free.</p></div>
	<div class="stack" style="gap:28px">
		<div class="check-list" style="gap:14px 24px">{['Fuel delivery', 'Flat tire changes', 'Tire repair', 'Winching and extrication', 'Towing to your home', 'Towing to our shop for service'].map((c) => <Check>{c}</Check>)}</div>
		<div class="row"><Btn href="https://24hrcartclub.com">Join 24hr Cart Club</Btn></div>
	</div>
</section>

<Reviews heading="Fast, fair and they call you back." />
<Faq items={faqs} eyebrow="Good questions" heading="Before you book." lead="Do not see yours? Call (352) 307-0111 and ask for the shop." />

<FormShell id="schedule" eyebrow="Schedule service" heading="Tell us what it is" accent="doing." lead="Fill this out and our team will get back to you as soon as possible during business hours. Or just call." note="Between Ocala and The Villages, right on 441 across from the Market of Marion.">
	<ServiceRequestForm pageSource={pageSource} idPrefix="svc" defaultLocation={defaultLocation} />
</FormShell>

<style>
	.hs { padding: 72px var(--gx) 64px; background: var(--paper); display: grid; grid-template-columns: 1.05fr 1fr; gap: 72px; align-items: center; }
	.hs-h { font-size: 68px; line-height: 1.02; letter-spacing: -0.015em; }
	.hs-ph { position: relative; height: 560px; overflow: hidden; background: var(--black); }
	.hs-ph img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.hs-label { position: absolute; left: 0; bottom: 0; padding: 16px 22px; background: var(--green); font-size: 15px; line-height: 20px; color: var(--ink); }
	.intro { max-width: 820px; font-size: 17px; line-height: 28px; color: var(--muted); }
	.intro :global(p) { margin: 0 0 16px; }
	.fix-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
	.fix-list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
	.fix { display: flex; align-items: center; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 16px; font-weight: 500; color: var(--ink); }
	.signs-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; }
	.signs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
	.sign { display: flex; flex-direction: column; gap: 14px; padding: 28px 26px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
	.lith { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
	.lith-img { display: block; width: 100%; height: 420px; object-fit: cover; object-position: 50% 45%; }
	.road { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: center; }
	@media (max-width: 1100px) { .hs, .lith, .road, .fix-grid { grid-template-columns: 1fr; gap: 40px; } .hs-h { font-size: 52px; } .hs-ph { height: 420px; } .signs { grid-template-columns: repeat(2, minmax(0, 1fr)); } .signs-head { flex-direction: column; align-items: flex-start; gap: 24px; } .lith .h2 { font-size: 36px !important; } }
	@media (max-width: 760px) { .hs { padding: 48px var(--gx) 40px; } .hs-h { font-size: 40px; } .hs-ph { height: 280px; } .signs { grid-template-columns: 1fr; } .lith-img { height: 260px; } .lith .h2 { font-size: 30px !important; } }
</style>
