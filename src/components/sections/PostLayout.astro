---
import Layout from '../../layouts/Layout.astro';
import Schema from '../Schema.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Btn from '../ui/Btn.astro';
import Icon from '../ui/Icon.astro';
import { blogPosts } from '../../lib/posts';
interface Props { title: string; description: string; slug: string; heading: string; category: string; date: string; image: string; alt?: string; ctaHeading?: string; ctaText?: string; ctaHref?: string }
const { title, description, slug, heading, category, date, image, alt = heading, ctaHeading = 'Talk to the shop.', ctaText = 'Get a quote', ctaHref = '/contact' } = Astro.props;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const more = blogPosts.filter((p) => p.slug !== slug).slice(0, 3);
const url = `https://mastersgolfcars.com/blog/${slug}`;
const articleSchema = { "@context": "https://schema.org", "@type": "Article", "headline": heading, "description": description, "image": `https://mastersgolfcars.com${image}`, "datePublished": date, "author": { "@type": "Organization", "name": "Masters Golf Cars" }, "publisher": { "@type": "Organization", "name": "Masters Golf Cars, LLC", "logo": { "@type": "ImageObject", "url": "https://mastersgolfcars.com/images/logos/MastersGolfCarsLogo.png" } }, "mainEntityOfPage": url };
const crumbs = [{ name: "Home", url: "https://mastersgolfcars.com" }, { name: "Blog", url: "https://mastersgolfcars.com/blog" }, { name: heading, url }];
---
<Layout title={title} description={description} breadcrumbs={crumbs} ogImage={image}>
	<Schema schema={articleSchema} slot="schema" />
	<section class="ptop white">
		<div class="stack" style="gap:22px;max-width:860px">
			<div class="row" style="gap:14px;font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--green-ink)"><a href="/blog" style="color:var(--muted)">Blog</a><span style="color:var(--muted)">/</span><span>{category}</span></div>
			<h1 class="h1 ph">{heading}</h1>
			<div class="row" style="gap:16px;padding-top:8px"><div class="ring" style="width:48px;height:48px"><Icon name="wrench" size={22} /></div><div class="stack" style="gap:2px;font-size:14px;line-height:20px"><span style="font-weight:600">Masters Golf Cars</span><span class="small">Published {fmt(date)}</span></div></div>
		</div>
		<div class="feat"><img src={image} alt={alt} width="1320" height="520" fetchpriority="high" /></div>
	</section>
	<section class="pbody white">
		<article class="article"><slot /></article>
		<aside class="stack" style="gap:24px">
			<div class="stack on-dark" style="gap:16px;padding:28px;background:var(--black)"><span class="label" style="color:var(--green)">Next step</span><span class="fd" style="font-size:26px;line-height:1.1">{ctaHeading}</span><Btn href={ctaHref} kind="green">{ctaText}</Btn></div>
			<div class="stack" style="gap:14px;padding:28px;border:1px solid var(--line)"><span class="label" style="color:var(--muted)">Related</span>{more.map((p) => <a href={`/blog/${p.slug}`} style="font-size:15px;line-height:22px;font-weight:600;color:var(--ink)">{p.title}</a>)}</div>
		</aside>
	</section>
	<section class="sec paper stack" style="gap:48px">
		<div class="head"><Eyebrow>Keep reading</Eyebrow><h2 class="h2 md">More from the shop.</h2></div>
		<div class="grid3" style="gap:32px">{more.map((p) => <a href={`/blog/${p.slug}`} class="stack" style="gap:16px;color:var(--ink)"><div class="mph"><img src={p.image} alt={p.title} loading="lazy" width="420" height="220" /></div><h3 class="h3" style="font-size:20px;line-height:1.15">{p.title}</h3></a>)}</div>
	</section>
</Layout>
<style>
	.ptop { padding: 48px var(--gx) 40px; background: #fff; display: flex; flex-direction: column; gap: 40px; }
	.ph { font-size: 56px; line-height: 1.02; letter-spacing: -0.015em; }
	.feat { height: 520px; overflow: hidden; background: var(--paper); }
	.feat img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
	.pbody { padding: 24px var(--gx) 80px; background: #fff; display: grid; grid-template-columns: 1fr 340px; gap: 80px; align-items: start; }
	aside { position: sticky; top: 24px; }
	.mph { height: 220px; overflow: hidden; background: var(--paper); }
	.mph img { display: block; width: 100%; height: 100%; object-fit: cover; }
	@media (max-width: 1100px) { .pbody { grid-template-columns: 1fr; gap: 40px; } aside { position: static; } .ph { font-size: 40px; } .feat { height: 360px; } }
	@media (max-width: 760px) { .ph { font-size: 32px; } .feat { height: 220px; } }
</style>
