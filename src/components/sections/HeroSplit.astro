---
import Eyebrow from '../ui/Eyebrow.astro';
import Btn from '../ui/Btn.astro';
import Check from '../ui/Check.astro';
import companyData from '../../data/company.json';
interface Props { eyebrow: string; heading: string; accent?: string; lead: string; cta: string; ctaHref: string; checks?: string[]; img: string; alt: string; label?: string; pos?: string; secondCta?: string; secondHref?: string }
const { eyebrow, heading, accent, lead, cta, ctaHref, checks = [], img, alt, label, pos = '50% 50%', secondCta = `Call ${companyData.contact.phone}`, secondHref = companyData.contact.phoneLink } = Astro.props;
---
<section class="hs paper">
	<div class="stack" style="gap:28px">
		<Eyebrow>{eyebrow}</Eyebrow>
		<h1 class="h1 hs-h"><Fragment set:html={heading} /> {accent && <span class="g">{accent}</span>}</h1>
		<p class="lead" style="max-width:540px">{lead}</p>
		<div class="row btn-row" style="gap:16px"><Btn href={ctaHref}>{cta}</Btn><Btn href={secondHref} kind="ghost">{secondCta}</Btn></div>
		{checks.length > 0 && <div class="check-list" style="gap:14px 24px">{checks.map((c) => <Check>{c}</Check>)}</div>}
	</div>
	<div class="hs-ph"><img src={img} alt={alt} width="640" height="560" fetchpriority="high" style={`object-position:${pos}`} />{label && <div class="hs-label fd">{label}</div>}</div>
</section>
<style>
	.hs { padding: 72px var(--gx) 64px; background: var(--paper); display: grid; grid-template-columns: 1.05fr 1fr; gap: 72px; align-items: center; }
	.hs-h { font-size: 68px; line-height: 1.02; letter-spacing: -0.015em; }
	.hs-ph { position: relative; height: 560px; overflow: hidden; background: var(--black); }
	.hs-ph img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.hs-label { position: absolute; left: 0; bottom: 0; padding: 14px 20px; background: var(--green); font-size: 14px; line-height: 20px; color: var(--ink); }
	@media (max-width: 1100px) { .hs { grid-template-columns: 1fr; gap: 40px; } .hs-h { font-size: 52px; } .hs-ph { height: 420px; } }
	@media (max-width: 760px) { .hs { padding: 48px var(--gx) 40px; } .hs-h { font-size: 40px; } .hs-ph { height: 280px; } }
</style>
