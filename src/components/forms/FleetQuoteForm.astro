---
import Icon from '../ui/Icon.astro';
interface Props { pageSource: string; idPrefix: string; defaultEventType?: string; cta?: string }
const { pageSource, idPrefix, defaultEventType = '', cta = 'Request my fleet quote' } = Astro.props;
const p = idPrefix;
const eventTypeOptions = ['Golf tournament', 'Wedding', 'Festival / Concert', 'Corporate event', 'Equestrian / HITS / Florida Horse Park', 'World Equestrian Center (WEC)', 'RV park / Campground', 'Other'];
---
<form class="form-card" name="fleet-rentals-quote" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/success">
	<input type="hidden" name="form-name" value="fleet-rentals-quote" />
	<input type="hidden" name="page_source" value={pageSource} />
	<p class="hidden"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
	<div class="field"><label for={`${p}-name`}>Contact person</label><input type="text" id={`${p}-name`} name="name" required autocomplete="name" /></div>
	<div class="field"><label for={`${p}-company`}>Event or company name</label><input type="text" id={`${p}-company`} name="company" autocomplete="organization" /></div>
	<div class="field"><label for={`${p}-phone`}>Mobile phone</label><input type="tel" id={`${p}-phone`} name="phone" required autocomplete="tel" inputmode="tel" /></div>
	<div class="field"><label for={`${p}-email`}>Email</label><input type="email" id={`${p}-email`} name="email" required autocomplete="email" /></div>
	<div class="field"><label for={`${p}-event-type`}>Event type</label><select id={`${p}-event-type`} name="event_type" required><option value="">Select event type</option>{eventTypeOptions.map((opt) => <option value={opt} selected={opt === defaultEventType}>{opt}</option>)}</select></div>
	<div class="field"><label for={`${p}-count`}>How many carts</label><input type="number" id={`${p}-count`} name="cart_count" required min="1" placeholder="e.g. 10" inputmode="numeric" /></div>
	<div class="field"><label for={`${p}-start`}>Event start date</label><input type="date" id={`${p}-start`} name="start_date" required /></div>
	<div class="field"><label for={`${p}-end`}>Event end date</label><input type="date" id={`${p}-end`} name="end_date" required /></div>
	<div class="field span2"><label for={`${p}-venue`}>Delivery address or venue</label><input type="text" id={`${p}-venue`} name="venue" required placeholder="Venue name, street, city" /></div>
	<div class="field span2"><label for={`${p}-cart-mix`}>Cart mix</label><input type="text" id={`${p}-cart-mix`} name="cart_mix" placeholder="e.g. 6 four passenger, 4 two passenger, 1 utility" /></div>
	<div class="field span2"><label for={`${p}-notes`}>Additional needs or questions</label><textarea id={`${p}-notes`} name="notes" placeholder="Delivery window, on-site restrictions, anything else we should know."></textarea></div>
	<label class="consent span2"><input type="checkbox" id={`${p}-sms-consent`} name="sms_consent" value="yes" /><span>You can text me about this request. Message and data rates may apply. Reply STOP to opt out.</span></label>
	<button type="submit" class="btn span2 block"><span>{cta}</span><Icon name="arrow" size={18} /></button>
	<div class="span2 small" style="text-align:center;font-size:13px">We respect your privacy. No spam, ever.</div>
</form>
