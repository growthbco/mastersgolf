---
import Icon from '../ui/Icon.astro';
interface Props { pageSource: string; idPrefix: string; defaultLocation?: string; cta?: string }
const { pageSource, idPrefix, defaultLocation = '', cta = 'Check availability' } = Astro.props;
const p = idPrefix;
---
<form class="form-card" name="rental-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/success">
	<input type="hidden" name="form-name" value="rental-inquiry" />
	<input type="hidden" name="page_source" value={pageSource} />
	<p class="hidden"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
	<div class="field"><label for={`${p}-name`}>Name</label><input type="text" id={`${p}-name`} name="name" required autocomplete="name" /></div>
	<div class="field"><label for={`${p}-phone`}>Mobile phone</label><input type="tel" id={`${p}-phone`} name="phone" required autocomplete="tel" inputmode="tel" /></div>
	<div class="field"><label for={`${p}-email`}>Email</label><input type="email" id={`${p}-email`} name="email" required autocomplete="email" /></div>
	<div class="field"><label for={`${p}-cart-type`}>Type of cart</label><select id={`${p}-cart-type`} name="cart_type" required><option value="">Select cart</option><option value="2-Seater">2 passenger</option><option value="4-Seater">4 passenger</option><option value="6-Seater">6 passenger</option><option value="Utility Cart">Utility cart</option><option value="Not sure">Not sure yet</option></select></div>
	<div class="field"><label for={`${p}-start`}>Start date</label><input type="date" id={`${p}-start`} name="start_date" required /></div>
	<div class="field"><label for={`${p}-end`}>End date</label><input type="date" id={`${p}-end`} name="end_date" required /></div>
	<div class="field"><label for={`${p}-cart-qty`}>How many carts</label><input type="number" id={`${p}-cart-qty`} name="cart_quantity" min="1" placeholder="1" inputmode="numeric" /></div>
	<div class="field"><label for={`${p}-delivery`}>Delivery address</label><input type="text" id={`${p}-delivery`} name="delivery_address" required value={defaultLocation} placeholder="Street, city, community or venue" autocomplete="street-address" /></div>
	<div class="field span2"><label for={`${p}-notes`}>Additional needs or questions</label><textarea id={`${p}-notes`} name="notes" placeholder="Anything else we should know about your rental."></textarea></div>
	<label class="consent span2"><input type="checkbox" id={`${p}-sms-consent`} name="sms_consent" value="yes" /><span>You can text me about this request. Message and data rates may apply. Reply STOP to opt out.</span></label>
	<button type="submit" class="btn span2 block"><span>{cta}</span><Icon name="arrow" size={18} /></button>
	<div class="span2 small" style="text-align:center;font-size:13px">We respect your privacy. No spam, ever.</div>
</form>
