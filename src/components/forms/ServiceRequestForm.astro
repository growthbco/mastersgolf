---
import Icon from '../ui/Icon.astro';
interface Props { pageSource: string; idPrefix: string; defaultLocation?: string; cta?: string }
const { pageSource, idPrefix, defaultLocation = '', cta = 'Request service' } = Astro.props;
const p = idPrefix;
const types = ['Routine maintenance / tune-up', 'Battery service', 'Tires / brakes', "Won't start / electrical", 'Body / cosmetic', 'Lift kit / accessories', 'Lithium conversion', 'Diagnosis - not sure', 'Other'];
---
<form class="form-card" name="service-request" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/success">
	<input type="hidden" name="form-name" value="service-request" />
	<input type="hidden" name="page_source" value={pageSource} />
	<p class="hidden"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
	<div class="field"><label for={`${p}-name`}>Name</label><input type="text" id={`${p}-name`} name="name" required autocomplete="name" /></div>
	<div class="field"><label for={`${p}-phone`}>Mobile phone</label><input type="tel" id={`${p}-phone`} name="phone" required autocomplete="tel" inputmode="tel" /></div>
	<div class="field"><label for={`${p}-email`}>Email</label><input type="email" id={`${p}-email`} name="email" required autocomplete="email" /></div>
	<div class="field"><label for={`${p}-address`}>Address (where the cart is)</label><input type="text" id={`${p}-address`} name="service_address" required value={defaultLocation} autocomplete="street-address" /></div>
	<div class="field"><label for={`${p}-make`}>Cart make</label><input type="text" id={`${p}-make`} name="cart_make" placeholder="Club Car, Yamaha, E-Z-GO" /></div>
	<div class="field"><label for={`${p}-model`}>Model and year</label><input type="text" id={`${p}-model`} name="cart_model" placeholder="Precedent 2020" /></div>
	<div class="field"><label for={`${p}-type`}>What does it need</label><select id={`${p}-type`} name="service_type" required><option value="">Select</option>{types.map((t) => <option value={t}>{t}</option>)}</select></div>
	<div class="field"><label for={`${p}-date`}>Preferred date</label><input type="date" id={`${p}-date`} name="preferred_date" /></div>
	<input type="hidden" name="cart_year" value="" />
	<div class="field span2"><label for={`${p}-details`}>Describe the problem</label><textarea id={`${p}-details`} name="details" required placeholder="What is it doing, and since when?"></textarea></div>
	<label class="consent span2"><input type="checkbox" id={`${p}-sms-consent`} name="sms_consent" value="yes" /><span>You can text me about this request. Message and data rates may apply. Reply STOP to opt out.</span></label>
	<button type="submit" class="btn span2 block"><span>{cta}</span><Icon name="arrow" size={18} /></button>
	<div class="span2 small" style="text-align:center;font-size:13px">We respect your privacy. No spam, ever.</div>
</form>
