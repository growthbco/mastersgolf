---
interface Props {
	pageSource: string;
	idPrefix: string;
	heading?: string;
	subheading?: string;
	defaultLocation?: string;
	bgClass?: string;
}

const {
	pageSource,
	idPrefix,
	heading = 'Request a Service Quote',
	subheading = 'Describe what your cart needs and our team will get back to you to schedule pickup or on-site service.',
	defaultLocation = '',
	bgClass = 'bg-gray-50',
} = Astro.props;
---

<section class={`py-16 ${bgClass}`}>
	<div class="container mx-auto px-4 max-w-3xl">
		<div class="text-center mb-8">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-3">{heading}</h2>
			<p class="text-lg text-gray-700">{subheading}</p>
		</div>
		<div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-sm">
			<form
				name="service-request"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				action="/success"
				class="space-y-5"
			>
				<input type="hidden" name="form-name" value="service-request" />
				<input type="hidden" name="page_source" value={pageSource} />
				<p class="hidden">
					<label>Don't fill this out if you're human: <input name="bot-field" /></label>
				</p>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label for={`${idPrefix}-name`} class="block text-sm font-bold text-gray-900 mb-1">Full Name <span class="text-red-600">*</span></label>
						<input type="text" id={`${idPrefix}-name`} name="name" required placeholder="Your name" autocomplete="name" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
					</div>
					<div>
						<label for={`${idPrefix}-phone`} class="block text-sm font-bold text-gray-900 mb-1">Phone <span class="text-red-600">*</span></label>
						<input type="tel" id={`${idPrefix}-phone`} name="phone" required placeholder="(352) 555-1234" autocomplete="tel" inputmode="tel" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
					</div>
				</div>

				<div>
					<label for={`${idPrefix}-email`} class="block text-sm font-bold text-gray-900 mb-1">Email <span class="text-red-600">*</span></label>
					<input type="email" id={`${idPrefix}-email`} name="email" required placeholder="you@email.com" autocomplete="email" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
				</div>

				<div>
					<label for={`${idPrefix}-address`} class="block text-sm font-bold text-gray-900 mb-1">Service Address / Community <span class="text-red-600">*</span></label>
					<input type="text" id={`${idPrefix}-address`} name="service_address" required value={defaultLocation} placeholder="Where is the cart located?" autocomplete="street-address" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
					<div>
						<label for={`${idPrefix}-make`} class="block text-sm font-bold text-gray-900 mb-1">Cart Make</label>
						<input type="text" id={`${idPrefix}-make`} name="cart_make" placeholder="Club Car, EZGO..." class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
					</div>
					<div>
						<label for={`${idPrefix}-model`} class="block text-sm font-bold text-gray-900 mb-1">Model</label>
						<input type="text" id={`${idPrefix}-model`} name="cart_model" placeholder="Precedent, RXV..." class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
					</div>
					<div>
						<label for={`${idPrefix}-year`} class="block text-sm font-bold text-gray-900 mb-1">Year</label>
						<input type="text" id={`${idPrefix}-year`} name="cart_year" placeholder="e.g. 2020" inputmode="numeric" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
					</div>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label for={`${idPrefix}-type`} class="block text-sm font-bold text-gray-900 mb-1">Service Needed <span class="text-red-600">*</span></label>
						<select id={`${idPrefix}-type`} name="service_type" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none">
							<option value="">Select...</option>
							<option value="Routine maintenance / tune-up">Routine maintenance / tune-up</option>
							<option value="Battery service">Battery service</option>
							<option value="Tires / brakes">Tires / brakes</option>
							<option value="Won't start / electrical">Won't start / electrical</option>
							<option value="Body / cosmetic">Body / cosmetic</option>
							<option value="Lift kit / accessories">Lift kit / accessories</option>
							<option value="Diagnosis - not sure">Diagnosis - not sure</option>
							<option value="Other">Other</option>
						</select>
					</div>
					<div>
						<label for={`${idPrefix}-date`} class="block text-sm font-bold text-gray-900 mb-1">Preferred Date</label>
						<input type="date" id={`${idPrefix}-date`} name="preferred_date" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
					</div>
				</div>

				<div>
					<label for={`${idPrefix}-details`} class="block text-sm font-bold text-gray-900 mb-1">Describe the Issue <span class="text-red-600">*</span></label>
					<textarea id={`${idPrefix}-details`} name="details" rows="5" required placeholder="What is the cart doing? Any error sounds, lights, or recent changes?" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none"></textarea>
				</div>

				<div class="flex items-start gap-3 pt-1">
					<input type="checkbox" id={`${idPrefix}-sms-consent`} name="sms_consent" value="yes" class="mt-1 h-4 w-4 rounded border-gray-400 text-brand-green focus:ring-brand-green" />
					<label for={`${idPrefix}-sms-consent`} class="text-sm text-gray-700 leading-relaxed">
						I agree to receive SMS text messages from Masters Golf Cars in response to this inquiry, including appointment reminders, service updates, quotes, and follow-up communications. Message frequency varies. Msg and data rates may apply. Reply STOP to opt out or HELP for help. Consent is not a condition of purchase. See our <a href="/privacy-policy" class="text-brand-green font-bold underline hover:opacity-80">Privacy Policy</a> and <a href="/terms-conditions" class="text-brand-green font-bold underline hover:opacity-80">Terms and Conditions</a>.
					</label>
				</div>

				<button type="submit" class="w-full bg-brand-green text-white font-bold uppercase tracking-wide py-3 px-4 rounded-md hover:opacity-90 transition-colors">
					Request Service
				</button>

				<p class="text-center text-xs text-gray-500">
					Your information is secure and will never be shared.
				</p>
			</form>
		</div>
	</div>
</section>
