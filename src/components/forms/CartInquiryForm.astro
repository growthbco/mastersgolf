---
import Icon from '../ui/Icon.astro';
interface Props { pageSource: string; idPrefix: string; stockNumber?: string; cartName?: string; cta?: string; placeholder?: string }
const { pageSource, idPrefix, stockNumber = '', cartName = '', cta = 'Send message', placeholder = 'New or pre-owned, 2, 4 or 6 passenger, gas or electric, financing questions, anything else.' } = Astro.props;
const p = idPrefix;
---
<form class="form-card" name="cart-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/success">
	<input type="hidden" name="form-name" value="cart-inquiry" />
	<input type="hidden" name="page_source" value={pageSource} />
	<input type="hidden" name="stock-number" value={stockNumber} />
	<input type="hidden" name="cart-name" value={cartName} />
	<p class="hidden"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
	<div class="field"><label for={`${p}-name`}>Name</label><input type="text" id={`${p}-name`} name="name" required autocomplete="name" /></div>
	<div class="field"><label for={`${p}-phone`}>Mobile phone</label><input type="tel" id={`${p}-phone`} name="phone" required autocomplete="tel" inputmode="tel" /></div>
	<div class="field span2"><label for={`${p}-email`}>Email</label><input type="email" id={`${p}-email`} name="email" required autocomplete="email" /></div>
	<div class="field span2"><label for={`${p}-message`}>Message</label><textarea id={`${p}-message`} name="message" required placeholder={placeholder}></textarea></div>
	<label class="consent span2"><input type="checkbox" id={`${p}-sms-consent`} name="sms_consent" value="yes" /><span>You can text me about this request. Message and data rates may apply. Reply STOP to opt out.</span></label>
	<button type="submit" class="btn span2 block"><span>{cta}</span><Icon name="arrow" size={18} /></button>
	<div class="span2 small" style="text-align:center;font-size:13px">We respect your privacy. No spam, ever.</div>
</form>
