---
interface Props {
	pageSource: string;
	idPrefix: string;
	heading?: string;
	subheading?: string;
	bgClass?: string;
}

const {
	pageSource,
	idPrefix,
	heading = 'Request Information on Our Carts',
	subheading = 'Tell us what you are looking for and our sales team will follow up promptly with options, pricing, and financing.',
	bgClass = 'bg-gray-50',
} = Astro.props;
---

<section class={`py-16 ${bgClass}`}>
	<div class="container mx-auto px-4 max-w-3xl">
		<div class="text-center mb-8">
			<h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-3">{heading}</h2>
			<p class="text-lg text-gray-700">{subheading}</p>
		</div>
		<div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 shadow-sm">
			<form
				name="cart-inquiry"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				action="/success"
				class="space-y-5"
			>
				<input type="hidden" name="form-name" value="cart-inquiry" />
				<input type="hidden" name="page_source" value={pageSource} />
				<input type="hidden" name="stock-number" value="" />
				<input type="hidden" name="cart-name" value="" />
				<p class="hidden">
					<label>Don't fill this out if you're human: <input name="bot-field" /></label>
				</p>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label for={`${idPrefix}-name`} class="block text-sm font-bold text-gray-900 mb-1">Full Name <span class="text-red-600">*</span></label>
						<input type="text" id={`${idPrefix}-name`} name="name" required placeholder="Your name" autocomplete="name" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
					</div>
					<div>
						<label for={`${idPrefix}-phone`} class="block text-sm font-bold text-gray-900 mb-1">Phone <span class="text-red-600">*</span></label>
						<input type="tel" id={`${idPrefix}-phone`} name="phone" required placeholder="(352) 555-1234" autocomplete="tel" inputmode="tel" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
					</div>
				</div>

				<div>
					<label for={`${idPrefix}-email`} class="block text-sm font-bold text-gray-900 mb-1">Email <span class="text-red-600">*</span></label>
					<input type="email" id={`${idPrefix}-email`} name="email" required placeholder="you@email.com" autocomplete="email" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none" />
				</div>

				<div>
					<label for={`${idPrefix}-message`} class="block text-sm font-bold text-gray-900 mb-1">What are you looking for? <span class="text-red-600">*</span></label>
					<textarea id={`${idPrefix}-message`} name="message" rows="5" required placeholder="Tell us about your needs — new or used, 2 / 4 / 6-seater, gas or electric, color preferences, financing questions, etc." class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none"></textarea>
				</div>

				<div class="flex items-start gap-3 pt-1">
					<input type="checkbox" id={`${idPrefix}-sms-consent`} name="sms_consent" value="yes" class="mt-1 h-4 w-4 rounded border-gray-400 text-brand-green focus:ring-brand-green" />
					<label for={`${idPrefix}-sms-consent`} class="text-sm text-gray-700 leading-relaxed">
						I agree to receive SMS text messages from Masters Golf Cars in response to this inquiry, including appointment reminders, service updates, quotes, and follow-up communications. Message frequency varies. Msg and data rates may apply. Reply STOP to opt out or HELP for help. Consent is not a condition of purchase. See our <a href="/privacy-policy" class="text-brand-green font-bold underline hover:opacity-80">Privacy Policy</a> and <a href="/terms-conditions" class="text-brand-green font-bold underline hover:opacity-80">Terms and Conditions</a>.
					</label>
				</div>

				<button type="submit" class="w-full bg-brand-green text-white font-bold uppercase tracking-wide py-3 px-4 rounded-md hover:opacity-90 transition-colors">
					Send My Inquiry
				</button>

				<p class="text-center text-xs text-gray-500">
					Your information is secure and will never be shared.
				</p>
			</form>
		</div>
	</div>
</section>
