---
/* Inventory card, fed by src/data/inventory.json */
import Icon from './ui/Icon.astro';
interface Props { name: string; model: string; price: number; salePrice?: number; stock: string; image: string; slug?: string; condition?: string }
const { name, model, price, salePrice, stock, image, slug, condition = 'New' } = Astro.props;
const finalPrice = salePrice || price;
const hasDiscount = !!salePrice && salePrice < price;
---
<a href={slug ? `/${slug}` : '#askcart'} class="cc">
	<div class="cc-ph"><img src={image} alt={name} loading="lazy" width="640" height="480" /><span class="badge">{condition}</span></div>
	<div class="cc-body">
		<h3 class="h3" style="font-size:20px;line-height:1.15">{name}</h3>
		<span class="small" style="font-size:15px">{model}</span>
		<div class="cc-foot">
			<div class="stack" style="gap:2px"><span class="fd" style="font-size:22px">${finalPrice.toLocaleString()}{hasDiscount && <span class="was">${price.toLocaleString()}</span>}</span><span class="stock">Stock #{stock}</span></div>
			<span class="sq"><Icon name="arrow" size={18} /></span>
		</div>
	</div>
</a>
<style>
	.cc { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); color: var(--ink); transition: transform .15s; }
	.cc:hover { transform: translateY(-2px); }
	.cc-ph { position: relative; height: 240px; overflow: hidden; background: var(--paper); }
	.cc-ph img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.badge { position: absolute; left: 0; top: 0; padding: 8px 14px; background: var(--green); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); }
	.cc-body { display: flex; flex-direction: column; gap: 8px; flex-grow: 1; padding: 24px 26px; }
	.cc-foot { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; }
	.was { margin-left: 10px; font-size: 14px; font-weight: 400; color: var(--muted); text-decoration: line-through; font-family: var(--fs); }
	.stock { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
	.sq { width: 40px; height: 40px; background: var(--ink); color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
	@media (max-width: 760px) { .cc-ph { height: 200px; } .cc-body { padding: 16px; } }
</style>
