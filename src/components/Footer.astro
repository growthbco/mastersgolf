---
import Icon from './ui/Icon.astro';
import companyData from '../data/company.json';
const year = new Date().getFullYear();
const services = [
	['Golf cart rentals', '/golf-cart-rentals'],
	['Fleet and event rentals', '/fleet-rentals-quote'],
	['Lithium conversions', '/bolt-lithium'],
	['Service and repair', '/golf-cart-repairs'],
	['Carts for sale', '/golf-cart-inventory'],
	['Sell your cart', '/sell-your-cart'],
];
const company = [
	['About Masters', '/about'],
	['Locations we serve', '/locations'],
	['Gallery', '/gallery'],
	['FAQ', '/faq'],
	['Blog', '/blog'],
	['Contact', '/contact'],
];
const sites = [
	['Golf Cart Rentals The Villages', 'https://golfcartrentalthevillagesfl.com'],
	['Golf Cart Rental Ocala', 'https://golfcartrentalocala.com'],
	['Bolt Energy Battery Sales', 'https://boltenergybatterysales.com'],
];
---
<footer class="ftr">
	<div class="cols">
		<div class="brand">
			<img src="/images/redesign/masters-logo.png" alt="Masters Golf Cars, LLC" width="194" height="64" loading="lazy" />
			<div class="meta">
				<span><Icon name="pin" size={18} color="#f9b406" /><span>{companyData.location.full}</span></span>
				<a href={companyData.contact.phoneLink}><Icon name="phone" size={18} color="#f9b406" /><span>{companyData.contact.phone}</span></a>
				<span><Icon name="clock" size={18} color="#f9b406" /><span>Mon to Fri 8:30 to 5, Sat 9 to 2</span></span>
				<a href={`mailto:${companyData.contact.email}`}><Icon name="mail" size={18} color="#f9b406" /><span>{companyData.contact.email}</span></a>
			</div>
		</div>
		<div class="col"><div class="label">Services</div>{services.map(([l, h]) => <a href={h}>{l}</a>)}</div>
		<div class="col"><div class="label">Company</div>{company.map(([l, h]) => <a href={h}>{l}</a>)}</div>
		<div class="col"><div class="label">Our rental sites</div>{sites.map(([l, h]) => <a href={h} rel="noopener">{l}</a>)}</div>
	</div>
	<div class="bottom">
		<span>&copy; {year} Masters Golf Cars, LLC. Serving Central Florida since 1999.</span>
		<span class="links"><a href="/privacy-policy">Privacy</a><a href="/terms-conditions">Terms</a><a href="/sitemap">Sitemap</a></span>
	</div>
</footer>
